# Generate all plot products for one clean gain scan and one usable bandpass scan.
#
# Preview:
#   script/gdp-plan-run pipelines/gain_bandpass_clean_plots.plan --dry-run
# Run:
#   script/gdp-plan-run pipelines/gain_bandpass_clean_plots.plan
#
# The product intents create per-scan NPZ files first. General plot modes use
# antennas 0-29; per-antenna and cross-correlation antenna plots are scoped below.

cairn: 1
----------------
mode: gain
scan: 13
----------------

# Antennas 4 and 5 have 0% CASA table flags in the saved gain scan 13 product.
intent: gdp-stats
  name: gain scan 13 NPZ products
  smode: gains,stats,ks,self-corr
end

# Calculate every Stokes/component pairing for antennas 0-29 separately, using
# the default cross-correlation parallel worker count. This supplies the full
# input matrix required by cross-corr-grid.
intent: gdp-stats
  name: gain scan 13 cross-correlation products
  smode: cross-corr
  antennas: "[0-29]"
  parallel: true
end

# General plot modes use the standard antenna 0-29 range.
intent: gdp-plot
  name: gain scan 13 general plots
  pmode: all,reim,self-corr-colormap,cross-corr-grid
  antenna: "[0-29]"
  yscale: log
  scale: log
  limit: "[1:20]"
end

# Restrict antenna-specific plot windows to the verified clean antennas.
intent: gdp-plot
  name: gain scan 13 selected antenna plots
  pmode: antenna,self-corr-antenna
  antenna: 4 5
  yscale: log
  scale: log
  limit: "[1:20]"
end

# Pair, Stokes, and component options belong only to the cross-corr antenna plot.
intent: gdp-plot
  name: gain scan 13 selected cross-correlation antenna plot
  pmode: cross-corr-antenna
  ant-pair: 4 5
  stokes-pair: 01
  cmplx-pair: im&im
  yscale: log
  scale: log
  limit: "[1:20]"
end

cairn: 2
----------------
mode: bandpass
scan: 18
----------------

# First save the full bandpass product. The next intent creates a new highest
# flag version that keeps only channels 800-3000 (scan 18 ends at channel 7300).
intent: gdp-stats
  name: bandpass scan 18 gains NPZ
  smode: gains
end

intent: gdp-flag
  name: bandpass scan 18 keep channels 800-3000
  fmode: man-chan
  man-chan: "[0-799]" "[3001-7300]"
end

intent: gdp-stats
  name: bandpass scan 18 stats and self-correlation using channel mask
  smode: stats,ks,self-corr
  use-flags: true
end

intent: gdp-stats
  name: bandpass scan 18 cross-correlation products using channel mask
  smode: cross-corr
  antennas: "[0-29]"
  parallel: true
  use-flags: true
end

intent: gdp-plot
  name: bandpass scan 18 general plots
  pmode: all,reim,self-corr-colormap,cross-corr-grid
  antenna: "[0-29]"
  use-flags: true
  pchans: "[800-3000]"
  yscale: log
  scale: log
  limit: "[1:20]"
end

intent: gdp-plot
  name: bandpass scan 18 selected antenna plots
  antenna: 12 18
  pmode: antenna,self-corr-antenna
  use-flags: true
  pchans: "[800-3000]"
  yscale: log
  scale: log
  limit: "[1:20]"
end

intent: gdp-plot
  name: bandpass scan 18 selected cross-correlation antenna plot
  pmode: cross-corr-antenna
  ant-pair: 12 18
  stokes-pair: 01
  cmplx-pair: im&im
  use-flags: true
  pchans: "[800-3000]"
  yscale: log
  scale: log
  limit: "[1:20]"
end
