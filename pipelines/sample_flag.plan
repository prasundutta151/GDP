setup-file: /Users/prasun/Documents/GDP/.gdp-config.json

---
mode: bandpass
scan: 18
use: true
out-fver: 3
---

intent: gdp-flag
 out-fver: 2
 use: true
 name: manual channel flag
 fmode: man-chan "[0-800]" "[3001-10000]"
end

intent: gdp-flag
 use: false
 name: auto all antenna std thrsld
 fmode: all-std-thrsld 
 scan: 18
end

intent: gdp-flag
 use: false
 name: auto  antenna std thrsld
 fmode: ante-std-thrsld
 out-fver: 3
 scan: 18
end

intent: gdp-flag
 iter: 3
 use: true
 name: auto  antenna mean thrsld
 fmode: ante-mean-thrsld 1.5
 scan: 18
 out-fver: 3
end

intent: gdp-flag
 iter: 3
 use: true
 name: auto  antenna mean thrsld
 fmode: ante-mean-thrsld 2.
 scan: 18
 out-fver: 3
end


intent: gdp-flag
 use: false
 name: auto  antenna thrsld
 fmode: ante-thrsld 
 scan: 18
 out-fver: 3
end



