#!/usr/bin/env python3
"""Run GDP command intents from a simple plan file."""

from __future__ import annotations

import argparse
import json
import os
import re
import shlex
import subprocess
import sys
from pathlib import Path
from typing import Any, Dict, List, Optional, Tuple


CONFIG_NAME = ".gdp-config.json"
ACTIVE_CONFIG: Optional[Dict[str, Any]] = None
VAR_RE = re.compile(r"\$\{([A-Za-z_][A-Za-z0-9_]*)\}")
MULTI_VALUE_OPTIONS = {
    "antenna",
    "antennas",
    "args",
    "arg",
    "apply-flag",
    "apply_flag",
    "clean",
    "fmode",
    "man-antenna",
    "man-antennas",
    "man_antenna",
    "man_antennas",
    "man-chan",
    "man-channel",
    "man_chan",
    "man_channel",
    "pchans",
    "pmode",
    "positional",
    "use-flags",
    "use_flags",
}
RELATIVE_PATH_COMMANDS = {"gdp-stats", "gdp-plot", "gdp-flag", "gdp-setup", "gdp-util"}
ITER_KEYS = {"iter", "iiter", "Iiter"}
INTENT_METADATA_KEYS = {"name", "description", "use", *ITER_KEYS}


def project_root() -> Path:
    return Path(__file__).resolve().parents[1]


def script_dir() -> Path:
    return project_root() / "script"


def load_project_config() -> Dict[str, Any]:
    path = project_root() / CONFIG_NAME
    if not path.exists():
        return {}
    with path.open("r", encoding="utf-8") as f:
        return json.load(f)


def resolve_setup_file_path(setup_file: Optional[str], base_config: Dict[str, Any]) -> Optional[Path]:
    if setup_file:
        path = Path(setup_file).expanduser()
        if path.is_absolute():
            return path.resolve()
        rundir = Path(str(base_config.get("rundir") or (project_root() / "rundir"))).expanduser().resolve()
        return (rundir / path).resolve()
    configured = base_config.get("setup_file")
    return Path(str(configured)).expanduser().resolve() if configured else None


def activate_config(setup_file: Optional[str] = None) -> Dict[str, Any]:
    global ACTIVE_CONFIG
    base = load_project_config()
    setup_path = resolve_setup_file_path(setup_file, base)
    if setup_path and setup_path.exists():
        with setup_path.open("r", encoding="utf-8") as f:
            ACTIVE_CONFIG = json.load(f)
    else:
        if setup_file:
            raise FileNotFoundError(f"Setup file not found: {setup_path}")
        ACTIVE_CONFIG = base
    return ACTIVE_CONFIG


def load_config() -> Dict[str, Any]:
    return ACTIVE_CONFIG if ACTIVE_CONFIG is not None else activate_config()


def runtime_dir() -> Path:
    cfg = load_config()
    return Path(str(cfg.get("rundir") or (project_root() / "rundir"))).expanduser().resolve()


def format_path_text(text: object, relative_paths: bool = False, rundir: Optional[Path] = None) -> str:
    value = str(text)
    if not relative_paths:
        return value
    root = rundir or runtime_dir()
    return value.replace(str(root.resolve()) + "/", "")


def emit(message: object, relative_paths: bool = False, rundir: Optional[Path] = None) -> None:
    print(format_path_text(message, relative_paths, rundir))


def strip_comment(line: str) -> str:
    in_single = False
    in_double = False
    escaped = False
    out = []
    for ch in line:
        if escaped:
            out.append(ch)
            escaped = False
            continue
        if ch == "\\":
            out.append(ch)
            escaped = True
            continue
        if ch == "'" and not in_double:
            in_single = not in_single
        elif ch == '"' and not in_single:
            in_double = not in_double
        if ch == "#" and not in_single and not in_double:
            break
        out.append(ch)
    return "".join(out).strip()


def parse_scalar(value: str) -> Any:
    value = value.strip()
    if value == "":
        return ""
    if (value.startswith('"') and value.endswith('"')) or (value.startswith("'") and value.endswith("'")):
        return value[1:-1]
    low = value.lower()
    if low in {"true", "yes", "on"}:
        return True
    if low in {"false", "no", "off"}:
        return False
    if low in {"none", "null"}:
        return None
    return value


def parse_key_value(line: str, lineno: int) -> Tuple[str, Any]:
    if ":" not in line:
        raise ValueError(f"Line {lineno}: expected key: value")
    key, value = line.split(":", 1)
    key = key.strip()
    if not key:
        raise ValueError(f"Line {lineno}: empty key")
    return key, parse_scalar(value)


def parse_plan(path: Path) -> Tuple[Dict[str, Any], List[Dict[str, Any]], Dict[str, Any]]:
    variables: Dict[str, Any] = {}
    settings: Dict[str, Any] = {}
    defaults: Dict[str, Any] = {}
    pending_intent_args: Dict[str, Any] = {}
    intents: List[Dict[str, Any]] = []
    section: Optional[str] = None
    current: Optional[Dict[str, Any]] = None

    for lineno, raw in enumerate(path.read_text(encoding="utf-8").splitlines(), start=1):
        line = strip_comment(raw)
        if not line:
            continue

        if line == "end":
            if current is not None:
                intents.append(current)
                current = None
            section = None
            continue

        if re.fullmatch(r"-{3,}", line):
            if current is not None:
                intents.append(current)
                current = None
                section = None
            elif section == "defaults":
                section = None
            elif section in {"variables", None}:
                section = "defaults" if section is None else None
            else:
                section = None
            continue

        if line == "variables:":
            if current is not None:
                intents.append(current)
                current = None
            section = "variables"
            continue

        if line.startswith("intent:"):
            if current is not None:
                intents.append(current)
            _, command = parse_key_value(line, lineno)
            args = dict(defaults)
            args.update(pending_intent_args)
            pending_intent_args = {}
            current = {"command": str(command), "args": args, "lineno": lineno}
            section = "intent"
            continue

        # Compact block form: "gdp-stats:" starts a new intent.
        if line.endswith(":") and line[:-1].strip().startswith("gdp-"):
            if current is not None:
                intents.append(current)
            args = dict(defaults)
            args.update(pending_intent_args)
            pending_intent_args = {}
            current = {"command": line[:-1].strip(), "args": args, "lineno": lineno}
            section = "intent"
            continue

        key, value = parse_key_value(line, lineno)
        if section == "variables":
            variables[key] = value
        elif section == "defaults":
            defaults[key] = value
        elif section == "intent" and current is not None:
            current["args"][key] = value
        elif section is None and key in ITER_KEYS:
            pending_intent_args["iter"] = value
        elif section is None and key in {"setup-file", "setup_file"}:
            settings["setup_file"] = value
        else:
            raise ValueError(
                f"Line {lineno}: key/value line must be inside variables:, a defaults block, an intent block, or a supported top-level setting"
            )

    if current is not None:
        intents.append(current)
    if not intents:
        raise ValueError(f"No intents found in plan: {path}")
    return variables, intents, settings


def flatten_config(config: Dict[str, Any]) -> Dict[str, Any]:
    out: Dict[str, Any] = {}
    for key, value in config.items():
        if key == "paths" and isinstance(value, dict):
            for pkey, pval in value.items():
                out[str(pkey)] = pval
        elif isinstance(value, (str, int, float, bool)) or value is None:
            out[str(key)] = value
    return out


def resolve_value(value: Any, variables: Dict[str, Any]) -> Any:
    if not isinstance(value, str):
        return value

    def repl(match: re.Match[str]) -> str:
        key = match.group(1)
        if key not in variables:
            raise KeyError(f"Unknown plan variable: {key}")
        return str(variables[key])

    previous = value
    for _ in range(10):
        resolved = VAR_RE.sub(repl, previous)
        if resolved == previous:
            return resolved
        previous = resolved
    raise ValueError(f"Variable expansion appears recursive: {value}")


def value_to_tokens(value: Any) -> List[str]:
    if value is True or value is False or value is None:
        return []
    if isinstance(value, (list, tuple)):
        return [str(item) for item in value]
    if isinstance(value, str):
        return shlex.split(value)
    return [str(value)]


def command_path(command: str) -> Path:
    if "/" in command:
        path = Path(command).expanduser()
        return path if path.is_absolute() else (project_root() / path)
    path = script_dir() / command
    if not path.exists():
        raise FileNotFoundError(f"GDP command not found: {path}")
    return path


def args_to_cli(args: Dict[str, Any], variables: Dict[str, Any]) -> List[str]:
    cli: List[str] = []
    for key, raw_value in args.items():
        if key in INTENT_METADATA_KEYS:
            continue
        value = resolve_value(raw_value, variables)
        if key in {"arg", "args", "positional"}:
            cli.extend(value_to_tokens(value))
            continue
        flag = "--" + key.replace("_", "-")
        if value is True:
            cli.append(flag)
        elif value is False or value is None:
            continue
        elif key in MULTI_VALUE_OPTIONS:
            tokens = value_to_tokens(value)
            if tokens:
                cli.extend([flag, *tokens])
            else:
                cli.append(flag)
        else:
            cli.extend([flag, str(value)])
    return cli


def normalize_intent_args(command: str, args: Dict[str, Any]) -> Dict[str, Any]:
    if command != "gdp-stats":
        return dict(args)
    old_keys = ["gains", "gain-colormap", "gain_colormap", "stats", "ks", "self-corr", "self_corr", "cross-corr", "cross_corr", "all"]
    used = [key for key in old_keys if key in args and args[key] is not False and args[key] is not None]
    if used:
        names = ", ".join(used)
        raise ValueError(f"gdp-stats plan intents must use smode: ... instead of old task keys: {names}")
    return dict(args)


def intent_enabled(intent: Dict[str, Any], variables: Dict[str, Any]) -> bool:
    args = intent.get("args", {})
    if "use" not in args:
        return True
    value = resolve_value(args["use"], variables)
    if isinstance(value, bool):
        return value
    text = str(value).strip().lower()
    if text in {"true", "yes", "on", "1"}:
        return True
    if text in {"false", "no", "off", "0"}:
        return False
    raise ValueError(f"Intent use must be true or false near line {intent.get('lineno')}: {value}")


def intent_iterations(intent: Dict[str, Any], variables: Dict[str, Any]) -> int:
    args = intent.get("args", {})
    raw_value = None
    for key in ITER_KEYS:
        if key in args:
            raw_value = args[key]
            break
    if raw_value is None:
        return 1
    value = resolve_value(raw_value, variables)
    try:
        count = int(str(value).strip())
    except Exception as exc:
        raise ValueError(f"Intent iter must be a positive integer near line {intent.get('lineno')}: {value}") from exc
    if count < 1:
        raise ValueError(f"Intent iter must be a positive integer near line {intent.get('lineno')}: {value}")
    return count


def run_plan(
    plan_path: Path,
    dry_run: bool = False,
    only: Optional[str] = None,
    setup_file: Optional[str] = None,
    relative_paths: bool = False,
) -> None:
    plan_vars, intents, settings = parse_plan(plan_path)
    selected_setup_file = setup_file or settings.get("setup_file")
    activate_config(str(selected_setup_file) if selected_setup_file else None)
    rundir = runtime_dir()
    if relative_paths:
        print(f"Runtime directory: {rundir}")
    variables = {
        "project_root": str(project_root()),
        "script_dir": str(script_dir()),
        "plan_dir": str(plan_path.parent),
    }
    variables.update(flatten_config(load_config()))
    for key, value in plan_vars.items():
        variables[key] = resolve_value(value, variables)

    for index, intent in enumerate(intents, start=1):
        command = intent["command"]
        label = str(intent["args"].get("name", command))
        if only is not None and only not in {command, label, str(index)}:
            continue
        if not intent_enabled(intent, variables):
            emit(f"[{index}] {label}", relative_paths, rundir)
            emit("SKIP use=false", relative_paths, rundir)
            continue
        exe = command_path(command)
        intent_args = normalize_intent_args(command, intent["args"])
        if selected_setup_file and command in {"gdp-stats", "gdp-plot", "gdp-flag"} and "setup-file" not in intent_args and "setup_file" not in intent_args:
            intent_args["setup-file"] = selected_setup_file
        if relative_paths and command in RELATIVE_PATH_COMMANDS and "relative-path" not in intent_args and "relative_path" not in intent_args:
            intent_args["relative-path"] = True
        repeat = intent_iterations(intent, variables)
        cli = args_to_cli(intent_args, variables)
        cmd = [str(exe), *cli]
        for iteration in range(1, repeat + 1):
            iter_suffix = f" iter={iteration}/{repeat}" if repeat > 1 else ""
            emit(f"[{index}] {label}{iter_suffix}", relative_paths, rundir)
            emit("$ " + " ".join(cmd), relative_paths, rundir)
            if dry_run:
                continue
            subprocess.run(cmd, cwd=str(project_root()), check=True)


def parse_args() -> argparse.Namespace:
    p = argparse.ArgumentParser(description="Run a GDP plan file composed of GDP command intents.")
    p.add_argument("plan_file", help="GDP plan file path.")
    p.add_argument("--setup-file", default=None, help="Setup JSON file to use. Relative names are resolved under the active runtime directory.")
    p.add_argument("--dry-run", action="store_true", help="Print commands without running them.")
    p.add_argument("--only", default=None, help="Run only the matching intent index, command, or name.")
    p.add_argument("--relative-path", action="store_true", help="Print runtime-relative file references and pass --relative-path to GDP child commands.")
    return p.parse_args()


def main() -> None:
    args = parse_args()
    plan = Path(args.plan_file).expanduser().resolve()
    if not plan.exists():
        raise FileNotFoundError(f"Plan file not found: {plan}")
    try:
        run_plan(plan, dry_run=args.dry_run, only=args.only, setup_file=args.setup_file, relative_paths=args.relative_path)
    except subprocess.CalledProcessError as exc:
        raise SystemExit(exc.returncode) from exc
    except (ValueError, KeyError) as exc:
        raise SystemExit(str(exc)) from exc


if __name__ == "__main__":
    main()
