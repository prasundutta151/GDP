#!/usr/bin/env python3
"""Compute GDP gain/bandpass products from CASA calibration tables."""

from __future__ import annotations

import argparse
import csv
import os
import json
import math
import re
import tempfile
import time
from concurrent.futures import ProcessPoolExecutor, as_completed
from datetime import datetime, timezone
from pathlib import Path
from typing import Any, Dict, List, Optional, Sequence, Tuple

import numpy as np


CONFIG_NAME = ".gdp-config.json"
ACTIVE_CONFIG: Optional[Dict[str, Any]] = None
RELATIVE_PATHS = False
COMPONENTS = np.array(["real", "imag"], dtype=object)
METRICS = np.array(["mean", "std", "skew", "kurtosis", "median", "mad", "min", "max"], dtype=object)
KS_METRICS = np.array(["d_statistic", "n_sample", "mean", "std"], dtype=object)
CORR_COMPONENTS = ("real", "imag")
SMODE_ALL_TASKS = ["gains", "stats", "ks"]
SMODE_ALIASES = {
    "gain": "gains",
    "gains": "gains",
    "stats": "stats",
    "ks": "ks",
    "self-corr": "self_corr",
    "self_corr": "self_corr",
    "all": "all",
    "cross-corr": "cross_corr",
    "cross_corr": "cross_corr",
}


def project_root() -> Path:
    return Path(__file__).resolve().parents[1]


def load_project_config() -> Dict[str, Any]:
    path = project_root() / CONFIG_NAME
    if not path.exists():
        return {}
    with path.open("r", encoding="utf-8") as f:
        return json.load(f)


def resolve_setup_file_path(setup_file: Optional[str], base_config: Dict[str, Any]) -> Optional[Path]:
    if setup_file:
        path = Path(setup_file).expanduser()
        if path.is_absolute():
            return path.resolve()
        rundir = Path(str(base_config.get("rundir") or (project_root() / "rundir"))).expanduser().resolve()
        return (rundir / path).resolve()
    configured = base_config.get("setup_file")
    return Path(str(configured)).expanduser().resolve() if configured else None


def activate_config(setup_file: Optional[str] = None) -> Dict[str, Any]:
    global ACTIVE_CONFIG
    base = load_project_config()
    setup_path = resolve_setup_file_path(setup_file, base)
    if setup_path and setup_path.exists():
        with setup_path.open("r", encoding="utf-8") as f:
            ACTIVE_CONFIG = json.load(f)
    else:
        if setup_file:
            raise FileNotFoundError(f"Setup file not found: {setup_path}")
        ACTIVE_CONFIG = base
    return ACTIVE_CONFIG


def load_config() -> Dict[str, Any]:
    return ACTIVE_CONFIG if ACTIVE_CONFIG is not None else activate_config()


def runtime_dir() -> Path:
    cfg = load_config()
    return Path(str(cfg.get("rundir") or (project_root() / "rundir"))).expanduser().resolve()


def format_path_text(text: object) -> str:
    value = str(text)
    if not RELATIVE_PATHS:
        return value
    prefix = str(runtime_dir()) + "/"
    return value.replace(prefix, "")


def display_path(path: object) -> str:
    return format_path_text(path)


def casatable_factory():
    try:
        from casatools import table as casatable
    except Exception as exc:
        raise RuntimeError(
            "Could not import casatools.table. Run inside CASA/casa6 or a "
            "CASA-enabled Python environment."
        ) from exc
    return casatable


def parse_int_list(text: Optional[str]) -> Optional[List[int]]:
    if text is None or str(text).strip() == "":
        return None
    return sorted({int(part.strip()) for part in str(text).split(",") if part.strip()})


def normalize_list_text(text: object) -> str:
    if isinstance(text, (list, tuple)):
        return " ".join(str(item) for item in text)
    return str(text)


def antenna_tokens(text: object) -> List[str]:
    value = normalize_list_text(text).strip()
    raw_tokens = re.findall(r"[\(\[][^\)\]]+[\)\]]|[^\s]+", value)
    tokens: List[str] = []
    for raw in raw_tokens:
        if (raw.startswith("(") and raw.endswith(")")) or (raw.startswith("[") and raw.endswith("]")):
            tokens.append(raw)
        else:
            tokens.extend(part for part in raw.split(",") if part)
    return [token.strip() for token in tokens if token.strip()]


def parse_antenna_token(token: str, option_name: str) -> List[int]:
    value = token.strip()
    if (value.startswith("(") and value.endswith(")")) or (value.startswith("[") and value.endswith("]")):
        value = value[1:-1].strip()
    if "," in value:
        parts = [part.strip() for part in value.split(",") if part.strip()]
        if len(parts) != 2:
            raise SystemExit(f"{option_name} range form must be two numbers, for example {option_name} [0-9]")
        start, end = int(parts[0]), int(parts[1])
        step = 1 if end >= start else -1
        return list(range(start, end + step, step))
    if "-" in value and not value.startswith("-"):
        parts = [part.strip() for part in value.split("-", 1) if part.strip()]
        if len(parts) != 2:
            raise SystemExit(f"{option_name} range form must be two numbers, for example {option_name} 0-9")
        start, end = int(parts[0]), int(parts[1])
        step = 1 if end >= start else -1
        return list(range(start, end + step, step))
    return [int(value)]


def parse_antenna_list(text: object, option_name: str = "--antennas") -> Optional[List[int]]:
    if text is None or normalize_list_text(text).strip() == "":
        return None
    antennas: List[int] = []
    for token in antenna_tokens(text):
        antennas.extend(parse_antenna_token(token, option_name))
    return sorted(set(antennas))


def antenna_flag_set(antenna_flags: Optional[List[int]]) -> set[int]:
    return {int(ant) for ant in antenna_flags or []}


def validate_channel_options_for_mode(mode: str, args: argparse.Namespace) -> None:
    return


def parse_smode(text: Optional[str]) -> List[str]:
    if text is None or str(text).strip() == "":
        return []
    modes: List[str] = []
    for part in str(text).replace(",", " ").split():
        key = part.strip()
        if not key:
            continue
        if key not in SMODE_ALIASES:
            valid = ", ".join(["gain", "gains", "stats", "ks", "self-corr", "all", "cross-corr"])
            raise SystemExit(f"Unknown smode '{key}'. Valid modes: {valid}")
        task = SMODE_ALIASES[key]
        if task == "all":
            for all_task in SMODE_ALL_TASKS:
                if all_task not in modes:
                    modes.append(all_task)
            continue
        if task not in modes:
            modes.append(task)
    return modes


def split_selector_tokens(value: object) -> List[str]:
    if value is None:
        return []
    if isinstance(value, (list, tuple)):
        text = " ".join(str(item) for item in value)
    else:
        text = str(value)
    return [part.strip() for part in re.split(r"[\s,]+", text) if part.strip()]


def parse_pair_selector(value: object, available: Sequence[int], option_name: str) -> List[Tuple[int, int]]:
    values = sorted(int(v) for v in available)
    if not values:
        return []
    tokens = split_selector_tokens(value)
    if not tokens or any(token.lower() == "all" for token in tokens):
        return [(a, b) for a in values for b in values]
    available_set = set(values)
    pairs: List[Tuple[int, int]] = []
    for token in tokens:
        text = token.strip()
        if re.fullmatch(r"\d{2}", text):
            pair = (int(text[0]), int(text[1]))
        elif re.fullmatch(r"\d+", text):
            pair = (int(text), int(text))
        elif re.fullmatch(r"\d+\s*[-:]\s*\d+", text):
            left, right = re.split(r"[-:]", text, maxsplit=1)
            pair = (int(left.strip()), int(right.strip()))
        else:
            raise SystemExit(f"{option_name} accepts values like 0, 1, 01, 0-1, or all.")
        if pair[0] not in available_set or pair[1] not in available_set:
            raise SystemExit(
                f"{option_name} pair {pair[0]}{pair[1]} is not present in the gains NPZ. "
                f"Available stokes: {', '.join(str(v) for v in values)}"
            )
        if pair not in pairs:
            pairs.append(pair)
    return pairs


def normalize_component_token(text: str) -> str:
    key = text.strip().lower().replace("_", "").replace("-", "")
    aliases = {
        "re": "real",
        "real": "real",
        "r": "real",
        "im": "imag",
        "imag": "imag",
        "i": "imag",
        "image": "imag",
    }
    if key in aliases:
        return aliases[key]
    raise SystemExit("--complex accepts re, im, reim, imre, real, imag, or all.")


def parse_complex_pair_selector(value: object) -> List[Tuple[str, str]]:
    tokens = split_selector_tokens(value)
    if not tokens or any(token.lower() == "all" for token in tokens):
        return [(a, b) for a in CORR_COMPONENTS for b in CORR_COMPONENTS]
    pairs: List[Tuple[str, str]] = []
    for token in tokens:
        key = token.strip().lower().replace("_", "").replace("-", "")
        if key in {"reim", "realimag", "rimi"}:
            pair = ("real", "imag")
        elif key in {"imre", "imagreal", "imir"}:
            pair = ("imag", "real")
        elif ":" in token:
            left, right = token.split(":", 1)
            pair = (normalize_component_token(left), normalize_component_token(right))
        else:
            comp = normalize_component_token(token)
            pair = (comp, comp)
        if pair not in pairs:
            pairs.append(pair)
    return pairs


def format_bytes(num_bytes: float) -> str:
    value = float(num_bytes)
    for unit in ("B", "KiB", "MiB", "GiB", "TiB"):
        if abs(value) < 1024.0 or unit == "TiB":
            return f"{value:.2f} {unit}" if unit != "B" else f"{value:.0f} {unit}"
        value /= 1024.0


def json_safe(value: Any) -> Any:
    if isinstance(value, np.ndarray):
        return [json_safe(v) for v in value.tolist()]
    if isinstance(value, np.generic):
        return value.item()
    if isinstance(value, dict):
        return {str(k): json_safe(v) for k, v in value.items()}
    if isinstance(value, (list, tuple)):
        return [json_safe(v) for v in value]
    return value


def config_path(key: str) -> Optional[Path]:
    cfg = load_config()
    value = cfg.get(key)
    if value is None and isinstance(cfg.get("paths"), dict):
        value = cfg["paths"].get(key)
    return Path(str(value)).expanduser().resolve() if value else None


def default_output_dir(product: str, kind: str) -> Path:
    key = f"{product}_{kind}_dir"
    configured = config_path(key)
    if configured is not None:
        return configured
    folder = product.replace("_", "-")
    return runtime_dir() / "data-product" / folder / kind


def build_default_output(input_table: Path, scan_text: str, mode: str, product: str, kind: str) -> Path:
    suffix = "npz" if kind == "npz" else "csv"
    product_name = product.replace("_", "-")
    return default_output_dir(product, kind) / f"gdp-{product_name}-{mode}-{scan_text}.{suffix}"


def parse_flag_version(value: Optional[str]) -> Optional[int]:
    if value is None:
        return None
    text = str(value).strip()
    lower = text.lower()
    if lower.startswith("fv"):
        text = text[2:]
    elif lower.startswith("v"):
        text = text[1:]
    if not text.isdigit() or int(text) < 1:
        raise SystemExit("--flagver must be a positive integer version number.")
    return int(text)


def flag_version_suffix(version: Optional[int]) -> str:
    return f"_fV{int(version)}" if version is not None else ""


def path_with_flag_version(path: Path, version: Optional[int]) -> Path:
    return path.with_name(f"{path.stem}{flag_version_suffix(version)}{path.suffix}") if version is not None else path


def flag_file_for_npz(npz_path: Path, version: int) -> Path:
    return npz_path.with_name(f"{npz_path.stem}_fV{int(version)}.flg")


def flag_file_versions(npz_path: Path) -> List[Tuple[int, Path]]:
    pattern = f"{npz_path.stem}_fV*.flg"
    versions: List[Tuple[int, Path]] = []
    for path in npz_path.parent.glob(pattern):
        match = re.fullmatch(rf"{re.escape(npz_path.stem)}_fV(\d+)\.flg", path.name)
        if match:
            versions.append((int(match.group(1)), path))
    return sorted(versions, key=lambda item: item[0])


def next_flag_version(npz_path: Path) -> int:
    versions = flag_file_versions(npz_path)
    return versions[-1][0] + 1 if versions else 1


def resolve_flag_file(npz_path: Path, flagver: Optional[int]) -> Tuple[int, Path]:
    if flagver is not None:
        path = flag_file_for_npz(npz_path, flagver)
        if not path.exists():
            raise SystemExit(f"ERROR: requested flag version fV{int(flagver)} does not exist: {display_path(path)}")
        return flagver, path
    versions = flag_file_versions(npz_path)
    if not versions:
        raise SystemExit(
            f"ERROR: no flag versions found for {display_path(npz_path)}. Run gdp-stats --smode gains first to create a .flg file."
        )
    return versions[-1]


def write_npz_exact_suffix(path: Path, payload: Dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("wb") as handle:
        np.savez_compressed(handle, **payload)


def write_flag_file(path: Path, gains: Dict[str, Any], version: int, source: str) -> None:
    flag_key = "table_flagged" if "table_flagged" in gains else "flagged"
    required = ["scan", "antenna", "stokes", "channel", "row", "time", flag_key]
    missing = [key for key in required if key not in gains]
    if missing:
        raise RuntimeError(f"Cannot write flag file; gains product missing arrays: {missing}")
    header = dict(gains.get("header", {}))
    flag_header = {
        "format": "GDP_FLAG_FLG",
        "format_version": "0.1",
        "created_utc": datetime.now(timezone.utc).isoformat(),
        "flag_version": int(version),
        "source": str(source),
        "source_format": header.get("format"),
        "input_table": header.get("input_table"),
        "mode": header.get("mode"),
        "bchan": header.get("bchan"),
        "echan": header.get("echan"),
        "flag_chans": header.get("flag_chans"),
        "flag-intent": ["CASA FLAGS"],
        "axes": {"flag": ["sample"]},
        "columns": ["scan", "antenna", "stokes", "channel", "row", "time", "flag"],
    }
    payload = {
        "header_json": json.dumps(json_safe(flag_header), indent=2, sort_keys=True),
        "scan": np.asarray(gains["scan"], dtype=int),
        "antenna": np.asarray(gains["antenna"], dtype=int),
        "stokes": np.asarray(gains["stokes"], dtype=int),
        "channel": np.asarray(gains["channel"], dtype=int),
        "row": np.asarray(gains["row"], dtype=int),
        "time": np.asarray(gains["time"], dtype=float),
        "flag": np.asarray(gains[flag_key], dtype=bool),
    }
    write_npz_exact_suffix(path, payload)


def load_flag_lookup(flag_path: Path) -> Tuple[Dict[Tuple[int, int, int], bool], Dict[str, Any]]:
    z = np.load(flag_path, allow_pickle=True)
    header = json.loads(str(z["header_json"])) if "header_json" in z else {}
    required = {"row", "stokes", "channel", "flag"}
    missing = required - set(z.files)
    if missing:
        raise RuntimeError(f"{flag_path} missing arrays: {sorted(missing)}")
    rows = np.asarray(z["row"], dtype=int)
    stokes = np.asarray(z["stokes"], dtype=int)
    channels = np.asarray(z["channel"], dtype=int)
    flags = np.asarray(z["flag"], dtype=bool)
    if not (rows.shape == stokes.shape == channels.shape == flags.shape):
        raise RuntimeError(f"{flag_path} flag arrays do not have matching dimensions.")
    lookup = {
        (int(row), int(pol), int(chan)): bool(flag)
        for row, pol, chan, flag in zip(rows, stokes, channels, flags)
    }
    return lookup, header


def flags_from_lookup(
    lookup: Optional[Dict[Tuple[int, int, int], bool]],
    row_ids: np.ndarray,
    npol: int,
    ch0: int,
    ch1: int,
) -> Optional[np.ndarray]:
    if lookup is None:
        return None
    out = np.zeros((int(npol), int(ch1 - ch0), int(row_ids.size)), dtype=bool)
    for ri, row in enumerate(row_ids):
        for pol in range(int(npol)):
            for ci, chan in enumerate(range(int(ch0), int(ch1))):
                out[pol, ci, ri] = bool(lookup.get((int(row), int(pol), int(chan)), False))
    return out


def channel_tag(mode: str, bchan: Optional[int], echan: Optional[int]) -> str:
    if mode == "bandpass" and bchan is not None and echan is not None:
        return f"chan_{int(bchan)}_{int(echan)}"
    return ""


def label_with_channel(scan_label: str, mode: str, bchan: Optional[int], echan: Optional[int]) -> str:
    tag = channel_tag(mode, bchan, echan)
    return f"{scan_label}-{tag}" if tag else scan_label


def default_log_path(input_table: Path) -> Path:
    logs_dir = config_path("logs_dir") or (runtime_dir() / "logs")
    return logs_dir / f"{input_table.name.rstrip('/')}_gdp-stats_{datetime.now().strftime('%Y%m%d_%H%M%S')}.log"


def spectral_window_info(input_table: Path) -> Dict[str, np.ndarray]:
    spw_path = input_table / "SPECTRAL_WINDOW"
    if not spw_path.exists():
        return {}
    casatable = casatable_factory()
    tb = casatable()
    try:
        tb.open(str(spw_path))
        cols = list(tb.colnames())
        info: Dict[str, np.ndarray] = {}
        if "CHAN_FREQ" in cols and tb.nrows() > 0:
            info["channel_freq_hz"] = np.asarray(tb.getcell("CHAN_FREQ", 0), dtype=float)
        if "CHAN_WIDTH" in cols and tb.nrows() > 0:
            info["channel_width_hz"] = np.asarray(tb.getcell("CHAN_WIDTH", 0), dtype=float)
        return info
    except Exception:
        return {}
    finally:
        try:
            tb.close()
        except Exception:
            pass


class TaskLogger:
    def __init__(self, path: Path):
        self.path = path
        self.path.parent.mkdir(parents=True, exist_ok=True)

    def write(self, message: str) -> None:
        line = format_path_text(f"{datetime.now().isoformat(timespec='seconds')} {message}")
        print(line)
        with self.path.open("a", encoding="utf-8") as f:
            f.write(line + "\n")

    def start(self, name: str) -> float:
        self.write(f"START {name}")
        return time.perf_counter()

    def done(self, name: str, start: float) -> None:
        self.write(f"DONE  {name} elapsed_sec={time.perf_counter() - start:.3f}")

    def skip(self, name: str, reason: str) -> None:
        self.write(f"SKIP  {name} reason={reason}")


def choose_data_column(columns: Sequence[str], mode: str) -> str:
    prefs = ("CPARAM", "FPARAM", "GAIN") if mode == "bandpass" else ("GAIN", "CPARAM", "FPARAM")
    for name in prefs:
        if name in columns:
            return name
    raise RuntimeError(f"No supported gain/bandpass data column found. Columns: {list(columns)}")


def normalize_flag(
    flag: np.ndarray,
    data_shape: Sequence[int],
    data_ch0: int = 0,
    flag_chans: Optional[Tuple[int, int]] = None,
) -> np.ndarray:
    flag = np.asarray(flag, dtype=bool)
    if flag.shape == tuple(data_shape):
        return flag
    if flag.ndim == 2 and len(data_shape) == 3:
        npol, nchan, nrow = data_shape
        if flag.shape == (npol, nrow):
            return np.broadcast_to(flag[:, None, :], (npol, nchan, nrow)).copy()
    if flag.ndim == 3 and len(data_shape) == 3:
        npol, nchan, nrow = data_shape
        if flag.shape[0] == npol and flag.shape[2] == nrow:
            flag_nchan = int(flag.shape[1])
            if flag_chans is None:
                f0, f1 = int(data_ch0), int(data_ch0) + flag_nchan
            else:
                f0, f1 = int(flag_chans[0]), int(flag_chans[1])
                if f1 - f0 != flag_nchan:
                    raise ValueError(
                        f"FLAG channel coverage [{f0},{f1}] describes {f1 - f0} channels, "
                        f"but FLAG has {flag_nchan} channels."
                    )
            full = np.ones((npol, nchan, nrow), dtype=bool)
            data_ch1 = int(data_ch0) + nchan
            overlap0 = max(int(data_ch0), f0)
            overlap1 = min(data_ch1, f1)
            if overlap1 > overlap0:
                dst0 = overlap0 - int(data_ch0)
                dst1 = overlap1 - int(data_ch0)
                src0 = overlap0 - f0
                src1 = overlap1 - f0
                full[:, dst0:dst1, :] = flag[:, src0:src1, :]
            return full
    raise ValueError(f"Unexpected FLAG shape {flag.shape}; expected compatible with data shape {tuple(data_shape)}")


def require_flag_column(cols: Sequence[str], input_table: Path) -> None:
    if "FLAG" not in cols:
        raise SystemExit(
            "WARNING: --use-flags was requested, but the selected table has no FLAG column; stopping.\n"
            f"Table: {input_table}"
        )


def open_context(
    input_table: Path,
    mode: str,
    scans: Optional[List[int]],
    antennas: Optional[List[int]],
    bchan: Optional[int],
    echan: Optional[int],
) -> Tuple[Any, List[str], str, np.ndarray, np.ndarray, List[int], List[int], int, int]:
    casatable = casatable_factory()
    tb = casatable()
    tb.open(str(input_table))
    cols = list(tb.colnames())
    data_col = choose_data_column(cols, mode)
    if "ANTENNA1" not in cols:
        tb.close()
        raise KeyError("ANTENNA1 column not found.")
    all_ant = np.asarray(tb.getcol("ANTENNA1"), dtype=int)
    all_scan = np.asarray(tb.getcol("SCAN_NUMBER"), dtype=int) if "SCAN_NUMBER" in cols else np.zeros(tb.nrows(), dtype=int)
    selected_scans = scans if scans is not None else sorted(int(x) for x in np.unique(all_scan))
    selected_antennas = antennas if antennas is not None else sorted(int(x) for x in np.unique(all_ant))
    sample = np.asarray(tb.getcol(data_col, startrow=0, nrow=1))
    if sample.ndim == 2:
        sample = sample[:, None, :]
    nchan = sample.shape[1]
    ch0 = 0 if bchan is None else max(0, int(bchan))
    ch1 = nchan if echan is None else min(nchan, int(echan))
    if ch1 <= ch0:
        tb.close()
        raise ValueError(f"Invalid channel range bchan={bchan}, echan={echan} for nchan={nchan}")
    return tb, cols, data_col, all_ant, all_scan, selected_scans, selected_antennas, ch0, ch1


def available_scans(input_table: Path) -> List[int]:
    casatable = casatable_factory()
    tb = casatable()
    tb.open(str(input_table))
    try:
        cols = list(tb.colnames())
        if "SCAN_NUMBER" not in cols:
            return [0]
        return sorted(int(x) for x in np.unique(np.asarray(tb.getcol("SCAN_NUMBER"), dtype=int)))
    finally:
        tb.close()


def format_scan_values(scans: List[int], limit: int = 30) -> str:
    if not scans:
        return "none"
    shown = ", ".join(str(scan) for scan in scans[:limit])
    if len(scans) > limit:
        shown += f", ... ({len(scans)} total)"
    return shown


def validate_requested_scans(input_table: Path, mode: str, scans: Optional[List[int]]) -> None:
    if scans is None:
        return
    available = available_scans(input_table)
    available_set = set(available)
    missing = [int(scan) for scan in scans if int(scan) not in available_set]
    if missing:
        raise SystemExit(
            "Requested scan(s) are not present in the selected table.\n"
            f"Mode: {mode}\n"
            f"Table: {input_table}\n"
            f"Missing scan(s): {format_scan_values(missing)}\n"
            f"Available scan(s): {format_scan_values(available)}"
        )


def nan_skew(values: np.ndarray) -> float:
    x = values[np.isfinite(values)]
    if x.size < 3:
        return np.nan
    mu = float(np.mean(x))
    sigma = float(np.std(x))
    return np.nan if sigma <= 0 else float(np.mean(((x - mu) / sigma) ** 3))


def nan_kurtosis(values: np.ndarray) -> float:
    x = values[np.isfinite(values)]
    if x.size < 4:
        return np.nan
    mu = float(np.mean(x))
    sigma = float(np.std(x))
    return np.nan if sigma <= 0 else float(np.mean(((x - mu) / sigma) ** 4) - 3.0)


def sample_skew(values: np.ndarray) -> float:
    x = np.asarray(values, dtype=float)
    x = x[np.isfinite(x)]
    n = x.size
    if n < 3:
        return np.nan
    mean = float(np.mean(x))
    centered = x - mean
    m2 = float(np.mean(centered ** 2))
    if m2 <= 0:
        return np.nan
    m3 = float(np.mean(centered ** 3))
    return float((np.sqrt(n * (n - 1)) / (n - 2)) * (m3 / (m2 ** 1.5)))


def sample_kurtosis(values: np.ndarray) -> float:
    x = np.asarray(values, dtype=float)
    x = x[np.isfinite(x)]
    n = x.size
    if n < 4:
        return np.nan
    mean = float(np.mean(x))
    centered = x - mean
    m2 = float(np.mean(centered ** 2))
    if m2 <= 0:
        return np.nan
    m4 = float(np.mean(centered ** 4))
    g2 = m4 / (m2 ** 2) - 3.0
    return float(((n - 1) / ((n - 2) * (n - 3))) * ((n + 1) * g2 + 6.0))


def metric_values(values: np.ndarray, percent_scale: bool = True) -> np.ndarray:
    x = values[np.isfinite(values)]
    if x.size == 0:
        return np.full(len(METRICS), np.nan, dtype=float)
    med = float(np.median(x))
    scale = 100.0 if percent_scale else 1.0
    return np.array(
        [
            float(np.mean(x)) * scale,
            float(np.std(x)) * scale,
            sample_skew(x),
            sample_kurtosis(x),
            med * scale,
            float(np.median(np.abs(x - med))) * scale,
            float(np.min(x)) * scale,
            float(np.max(x)) * scale,
        ],
        dtype=float,
    )


def normal_ks_d(values: np.ndarray) -> float:
    x = np.sort(np.asarray(values, dtype=float)[np.isfinite(values)])
    n = x.size
    if n < 2:
        return np.nan
    mean = float(np.mean(x))
    std = float(np.std(x, ddof=1))
    if not np.isfinite(std) or std <= 0:
        return np.nan
    cdf = 0.5 * (1.0 + np.vectorize(math.erf)((x - mean) / (std * math.sqrt(2.0))))
    empirical_hi = np.arange(1, n + 1, dtype=float) / n
    empirical_lo = np.arange(0, n, dtype=float) / n
    return float(max(np.max(np.abs(empirical_hi - cdf)), np.max(np.abs(cdf - empirical_lo))))


def compute_stats(
    input_table: Path,
    mode: str,
    scans: Optional[List[int]],
    antennas: Optional[List[int]],
    antenna_flags: Optional[List[int]],
    use_flags: bool,
    subtract_mean: bool,
    bchan: Optional[int],
    echan: Optional[int],
    flag_chans: Optional[Tuple[int, int]],
    flag_lookup: Optional[Dict[Tuple[int, int, int], bool]] = None,
) -> Dict[str, Any]:
    tb, cols, data_col, all_ant, all_scan, selected_scans, selected_antennas, ch0, ch1 = open_context(
        input_table, mode, scans, antennas, bchan, echan
    )
    try:
        if use_flags and flag_lookup is None:
            require_flag_column(cols, input_table)
        forced_flag_antennas = antenna_flag_set(antenna_flags)
        stokes_count: Optional[int] = None
        stats = valid_count = total_count = flagged_count = None
        for s_idx, scan in enumerate(selected_scans):
            row_ids = np.where(all_scan == int(scan))[0]
            if row_ids.size == 0:
                continue
            data_full = np.asarray(tb.getcol(data_col))
            if data_full.ndim == 2:
                data_full = data_full[:, None, :]
            data = data_full[:, :, row_ids]
            if use_flags and flag_lookup is not None:
                flag_raw = flags_from_lookup(flag_lookup, row_ids, data.shape[0], 0, data.shape[1])
            elif use_flags:
                flag_raw = np.asarray(tb.getcol("FLAG"))
                flag_raw = flag_raw[:, :, row_ids] if flag_raw.ndim == 3 else flag_raw[:, row_ids]
            else:
                flag_raw = np.zeros(data.shape, dtype=bool)
            ant = all_ant[row_ids]
            if data.ndim == 2:
                data = data[:, None, :]
            flag = normalize_flag(flag_raw, data.shape, 0, flag_chans)
            data = data[:, ch0:ch1, :]
            flag = flag[:, ch0:ch1, :]
            npol = data.shape[0]
            scan_means: Dict[Tuple[int, str], float] = {}
            if subtract_mean:
                selected_row_mask = np.isin(ant, np.asarray(selected_antennas, dtype=int))
                if forced_flag_antennas:
                    selected_row_mask &= ~np.isin(ant, np.asarray(sorted(forced_flag_antennas), dtype=int))
                for p_idx in range(npol):
                    selected_data = data[p_idx, :, selected_row_mask].astype(np.complex128, copy=True)
                    selected_flag = flag[p_idx, :, selected_row_mask]
                    selected_data[selected_flag] = np.nan + 1j * np.nan
                    real_vals = np.real(selected_data).ravel()
                    imag_vals = np.imag(selected_data).ravel()
                    real_vals = real_vals[np.isfinite(real_vals)]
                    imag_vals = imag_vals[np.isfinite(imag_vals)]
                    scan_means[(p_idx, "real")] = float(np.mean(real_vals)) if real_vals.size else np.nan
                    scan_means[(p_idx, "imag")] = float(np.mean(imag_vals)) if imag_vals.size else np.nan
            if stokes_count is None:
                stokes_count = npol
                stats = np.full((len(selected_scans), len(selected_antennas), npol, len(COMPONENTS), len(METRICS)), np.nan)
                count_shape = (len(selected_scans), len(selected_antennas), npol, len(COMPONENTS))
                valid_count = np.zeros(count_shape, dtype=np.int64)
                total_count = np.zeros(count_shape, dtype=np.int64)
                flagged_count = np.zeros(count_shape, dtype=np.int64)
            for a_idx, antenna in enumerate(selected_antennas):
                a_rows = ant == int(antenna)
                if not np.any(a_rows):
                    continue
                arr = data[:, :, a_rows].astype(np.complex128, copy=True)
                flg = flag[:, :, a_rows]
                if int(antenna) in forced_flag_antennas:
                    flg = np.ones(flg.shape, dtype=bool)
                if use_flags:
                    arr[flg] = np.nan + 1j * np.nan
                elif int(antenna) in forced_flag_antennas:
                    arr[:] = np.nan + 1j * np.nan
                for p_idx in range(npol):
                    z = arr[p_idx].ravel()
                    flagged = int(np.count_nonzero(flg[p_idx].ravel())) if (use_flags or int(antenna) in forced_flag_antennas) else 0
                    if subtract_mean:
                        real_mean = scan_means.get((p_idx, "real"), np.nan)
                        imag_mean = scan_means.get((p_idx, "imag"), np.nan)
                        r = (np.real(z) / real_mean) - 1.0 if np.isfinite(real_mean) and real_mean != 0.0 else np.full(z.shape, np.nan)
                        i = np.imag(z) - imag_mean if np.isfinite(imag_mean) else np.full(z.shape, np.nan)
                    else:
                        r = np.real(z) - 1.0
                        i = np.imag(z)
                    for c_idx, vals in enumerate((r, i)):
                        vals = np.asarray(vals, dtype=float)
                        stats[s_idx, a_idx, p_idx, c_idx, :] = metric_values(vals, percent_scale=True)
                        valid_count[s_idx, a_idx, p_idx, c_idx] = int(np.count_nonzero(np.isfinite(vals)))
                        total_count[s_idx, a_idx, p_idx, c_idx] = int(z.size)
                        flagged_count[s_idx, a_idx, p_idx, c_idx] = flagged
        if stokes_count is None or stats is None:
            raise RuntimeError("No matching scans/rows found.")
        return {
            "header": {
                "format": "GDP_STATS_NPZ",
                "format_version": "0.3",
                "created_utc": datetime.now(timezone.utc).isoformat(),
                "input_table": str(input_table),
                "mode": mode,
                "data_column": data_col,
                "use_flags": bool(use_flags),
                "flag_source": "flg" if flag_lookup is not None and use_flags else "casa-table" if use_flags else "none",
                "antenna_flags": sorted(forced_flag_antennas),
                "subtract_mean": bool(subtract_mean),
                "adjust_mean_convention": "If subtract_mean is true, real gain samples are divided by the finite unflagged all-selected-antenna mean per scan/Stokes before Real-1 statistics; imaginary samples subtract the finite unflagged all-selected-antenna mean per scan/Stokes.",
                "statistics_convention": "AntStat-style: real samples are real(gain)-1, imag samples are imag(gain); mean/std/median/mad/min/max are saved in percent, skew/kurtosis are dimensionless.",
                "bchan": bchan,
                "echan": echan,
                "flag_chans": flag_chans,
                "axes": {"stats": ["scan", "antenna", "stokes", "component", "metric"]},
            },
            "scan_numbers": np.asarray(selected_scans, dtype=int),
            "antennas": np.asarray(selected_antennas, dtype=int),
            "stokes": np.arange(stokes_count, dtype=int),
            "components": COMPONENTS,
            "metrics": METRICS,
            "stats": stats,
            "valid_count": valid_count,
            "total_count": total_count,
            "flagged_count": flagged_count,
        }
    finally:
        tb.close()


def compute_gains(
    input_table: Path,
    mode: str,
    scans: Optional[List[int]],
    antennas: Optional[List[int]],
    antenna_flags: Optional[List[int]],
    use_flags: bool,
    adjust_mean: bool,
    bchan: Optional[int],
    echan: Optional[int],
    flag_chans: Optional[Tuple[int, int]],
    flag_lookup: Optional[Dict[Tuple[int, int, int], bool]] = None,
) -> Dict[str, Any]:
    tb, cols, data_col, all_ant, all_scan, selected_scans, selected_antennas, ch0, ch1 = open_context(input_table, mode, scans, antennas, bchan, echan)
    try:
        has_flag_column = "FLAG" in cols
        if use_flags:
            require_flag_column(cols, input_table)
        forced_flag_antennas = antenna_flag_set(antenna_flags)
        all_time = np.asarray(tb.getcol("TIME"), dtype=float) if "TIME" in cols else np.arange(tb.nrows(), dtype=float)
        all_interval = np.asarray(tb.getcol("INTERVAL"), dtype=float) if "INTERVAL" in cols else np.full(tb.nrows(), np.nan, dtype=float)
        spw_info = spectral_window_info(input_table) if mode == "bandpass" else {}
        channel_freq_hz = spw_info.get("channel_freq_hz")
        channel_width_hz = spw_info.get("channel_width_hz")
        rows: Dict[str, List[Any]] = {
            k: []
            for k in [
                "scan",
                "antenna",
                "stokes",
                "channel",
                "row",
                "time",
                "interval",
                "channel_freq_hz",
                "channel_width_hz",
                "real",
                "imag",
                "flagged",
                "table_flagged",
            ]
        }
        for rid in range(tb.nrows()):
            scan = int(all_scan[rid])
            ant = int(all_ant[rid])
            if scan not in selected_scans or ant not in selected_antennas:
                continue
            data = np.asarray(tb.getcol(data_col, startrow=rid, nrow=1))
            if data.ndim == 2:
                data = data[:, None, :]
            data_full = data
            data = data_full[:, ch0:ch1, 0].astype(np.complex128, copy=True)
            if flag_lookup is not None:
                raw_flag = flags_from_lookup(flag_lookup, np.asarray([rid], dtype=int), data_full.shape[0], 0, data_full.shape[1])
                table_flag = normalize_flag(raw_flag, data_full.shape, 0, flag_chans)[:, ch0:ch1, 0]
            elif has_flag_column:
                raw_flag = np.asarray(tb.getcol("FLAG", startrow=rid, nrow=1))
                table_flag = normalize_flag(raw_flag, data_full.shape, 0, flag_chans)[:, ch0:ch1, 0]
            else:
                table_flag = np.zeros(data.shape, dtype=bool)
            flag = table_flag.copy() if use_flags or flag_lookup is not None else np.zeros(table_flag.shape, dtype=bool)
            if ant in forced_flag_antennas:
                flag = np.ones(flag.shape, dtype=bool)
                table_flag = np.ones(table_flag.shape, dtype=bool)
            if use_flags:
                data[flag] = np.nan + 1j * np.nan
            elif ant in forced_flag_antennas:
                data[:] = np.nan + 1j * np.nan
            for pol in range(data.shape[0]):
                for chan in range(data.shape[1]):
                    rows["scan"].append(scan)
                    rows["antenna"].append(ant)
                    rows["stokes"].append(pol)
                    rows["channel"].append(ch0 + chan)
                    rows["row"].append(rid)
                    rows["time"].append(float(all_time[rid]))
                    rows["interval"].append(float(all_interval[rid]))
                    abs_chan = ch0 + chan
                    rows["channel_freq_hz"].append(
                        float(channel_freq_hz[abs_chan])
                        if channel_freq_hz is not None and abs_chan < channel_freq_hz.size
                        else np.nan
                    )
                    rows["channel_width_hz"].append(
                        float(channel_width_hz[abs_chan])
                        if channel_width_hz is not None and abs_chan < channel_width_hz.size
                        else np.nan
                    )
                    rows["real"].append(float(np.real(data[pol, chan])))
                    rows["imag"].append(float(np.imag(data[pol, chan])))
                    rows["flagged"].append(bool(flag[pol, chan]))
                    rows["table_flagged"].append(bool(table_flag[pol, chan]))
        adjustment_means: Dict[str, Dict[int, float]] = {"real": {}, "imag": {}}
        if adjust_mean and rows["real"]:
            stokes_arr = np.asarray(rows["stokes"], dtype=int)
            flagged_arr = np.asarray(rows["flagged"], dtype=bool)
            real_arr = np.asarray(rows["real"], dtype=float)
            imag_arr = np.asarray(rows["imag"], dtype=float)
            for stokes in sorted(set(int(item) for item in rows["stokes"])):
                mask = (stokes_arr == int(stokes)) & ~flagged_arr
                real_vals = real_arr[mask]
                real_vals = real_vals[np.isfinite(real_vals)]
                imag_vals = imag_arr[mask]
                imag_vals = imag_vals[np.isfinite(imag_vals)]
                real_mean = float(np.mean(real_vals)) if real_vals.size else np.nan
                imag_mean = float(np.mean(imag_vals)) if imag_vals.size else np.nan
                adjustment_means["real"][int(stokes)] = real_mean
                adjustment_means["imag"][int(stokes)] = imag_mean
                if np.isfinite(real_mean) and real_mean != 0.0:
                    real_arr[stokes_arr == int(stokes)] = real_arr[stokes_arr == int(stokes)] / real_mean
                if np.isfinite(imag_mean):
                    imag_arr[stokes_arr == int(stokes)] = imag_arr[stokes_arr == int(stokes)] - imag_mean
            rows["real"] = real_arr.tolist()
            rows["imag"] = imag_arr.tolist()
        return {
            "header": {
                "format": "GDP_GAINS_NPZ",
                "format_version": "0.2",
                "created_utc": datetime.now(timezone.utc).isoformat(),
                "input_table": str(input_table),
                "mode": mode,
                "data_column": data_col,
                "use_flags": bool(use_flags),
                "flag_source": "flg" if flag_lookup is not None else "casa-table" if has_flag_column else "none",
                "antenna_flags": sorted(forced_flag_antennas),
                "adjust_mean": bool(adjust_mean),
                "adjust_mean_convention": "If true, real gain samples are divided by the finite unflagged all-antenna mean per Stokes; imaginary samples subtract the finite unflagged all-antenna mean per Stokes.",
                "adjust_mean_values": adjustment_means,
                "bchan": bchan,
                "echan": echan,
                "flag_chans": flag_chans,
                "columns": list(rows.keys()),
            },
            **{
                k: np.asarray(
                    v,
                    dtype=bool
                    if k in {"flagged", "table_flagged"}
                    else float
                    if k in {"real", "imag", "time", "interval", "channel_freq_hz", "channel_width_hz"}
                    else int,
                )
                for k, v in rows.items()
            },
        }
    finally:
        tb.close()


def compute_ks(
    input_table: Path,
    mode: str,
    scans: Optional[List[int]],
    antennas: Optional[List[int]],
    antenna_flags: Optional[List[int]],
    use_flags: bool,
    bchan: Optional[int],
    echan: Optional[int],
    flag_chans: Optional[Tuple[int, int]],
    flag_lookup: Optional[Dict[Tuple[int, int, int], bool]] = None,
) -> Dict[str, Any]:
    tb, cols, data_col, all_ant, all_scan, selected_scans, selected_antennas, ch0, ch1 = open_context(
        input_table, mode, scans, antennas, bchan, echan
    )
    try:
        if use_flags and flag_lookup is None:
            require_flag_column(cols, input_table)
        forced_flag_antennas = antenna_flag_set(antenna_flags)
        stokes_count: Optional[int] = None
        ks = sample_count = None
        for s_idx, scan in enumerate(selected_scans):
            row_ids = np.where(all_scan == int(scan))[0]
            if row_ids.size == 0:
                continue
            data_full = np.asarray(tb.getcol(data_col))
            if data_full.ndim == 2:
                data_full = data_full[:, None, :]
            data = data_full[:, :, row_ids]
            if use_flags and flag_lookup is not None:
                flag_raw = flags_from_lookup(flag_lookup, row_ids, data.shape[0], 0, data.shape[1])
            elif use_flags:
                flag_raw = np.asarray(tb.getcol("FLAG"))
                flag_raw = flag_raw[:, :, row_ids] if flag_raw.ndim == 3 else flag_raw[:, row_ids]
            else:
                flag_raw = np.zeros(data.shape, dtype=bool)
            ant = all_ant[row_ids]
            if data.ndim == 2:
                data = data[:, None, :]
            flag = normalize_flag(flag_raw, data.shape, 0, flag_chans)
            data = data[:, ch0:ch1, :]
            flag = flag[:, ch0:ch1, :]
            npol = data.shape[0]
            if stokes_count is None:
                stokes_count = npol
                shape = (len(selected_scans), len(selected_antennas), npol, len(COMPONENTS), len(KS_METRICS))
                ks = np.full(shape, np.nan, dtype=float)
                sample_count = np.zeros((len(selected_scans), len(selected_antennas), npol, len(COMPONENTS)), dtype=np.int64)
            for a_idx, antenna in enumerate(selected_antennas):
                a_rows = ant == int(antenna)
                if not np.any(a_rows):
                    continue
                arr = data[:, :, a_rows].astype(np.complex128, copy=True)
                flg = flag[:, :, a_rows]
                if int(antenna) in forced_flag_antennas:
                    flg = np.ones(flg.shape, dtype=bool)
                if use_flags:
                    arr[flg] = np.nan + 1j * np.nan
                elif int(antenna) in forced_flag_antennas:
                    arr[:] = np.nan + 1j * np.nan
                for p_idx in range(npol):
                    if mode == "bandpass":
                        real_vals = nanmean_no_warning(np.real(arr[p_idx]), axis=1)
                        imag_vals = nanmean_no_warning(np.imag(arr[p_idx]), axis=1)
                    else:
                        real_vals = np.real(arr[p_idx]).ravel()
                        imag_vals = np.imag(arr[p_idx]).ravel()
                    for c_idx, vals in enumerate((real_vals, imag_vals)):
                        finite = np.asarray(vals, dtype=float)
                        finite = finite[np.isfinite(finite)]
                        sample_count[s_idx, a_idx, p_idx, c_idx] = int(finite.size)
                        ks[s_idx, a_idx, p_idx, c_idx, 1] = float(finite.size)
                        d = normal_ks_d(finite)
                        if np.isfinite(d):
                            ks[s_idx, a_idx, p_idx, c_idx, 0] = d * 100.0
                            ks[s_idx, a_idx, p_idx, c_idx, 2] = float(np.mean(finite))
                            ks[s_idx, a_idx, p_idx, c_idx, 3] = float(np.std(finite, ddof=1)) if finite.size > 1 else np.nan
        if stokes_count is None or ks is None or sample_count is None:
            raise RuntimeError("No matching scans/rows found.")
        return {
            "header": {
                "format": "GDP_KS_NPZ",
                "format_version": "0.2",
                "created_utc": datetime.now(timezone.utc).isoformat(),
                "input_table": str(input_table),
                "mode": mode,
                "data_column": data_col,
                "use_flags": bool(use_flags),
                "flag_source": "flg" if flag_lookup is not None and use_flags else "casa-table" if use_flags else "none",
                "antenna_flags": sorted(forced_flag_antennas),
                "ks_convention": "AntStat-style fitted-normal Kolmogorov-Smirnov D statistic, saved as percent. Gain mode uses all finite raw real/imag samples; bandpass mode uses finite channel means over time.",
                "bchan": bchan,
                "echan": echan,
                "flag_chans": flag_chans,
                "axes": {"ks": ["scan", "antenna", "stokes", "component", "metric"]},
            },
            "scan_numbers": np.asarray(selected_scans, dtype=int),
            "antennas": np.asarray(selected_antennas, dtype=int),
            "stokes": np.arange(stokes_count, dtype=int),
            "components": COMPONENTS,
            "metrics": KS_METRICS,
            "ks": ks,
            "sample_count": sample_count,
        }
    finally:
        tb.close()


def compute_structure_function(
    data1: Tuple[np.ndarray, np.ndarray],
    data2: Optional[Tuple[np.ndarray, np.ndarray]] = None,
    nbin: int = 32,
    bintype: str = "log",
    njack: int = 32,
    edges: Optional[np.ndarray] = None,
) -> Tuple[np.ndarray, np.ndarray, np.ndarray, np.ndarray]:
    t1, x1 = np.asarray(data1[0], dtype=float), np.asarray(data1[1], dtype=float)
    if data2 is None:
        t2, x2 = t1, x1
    else:
        t2, x2 = np.asarray(data2[0], dtype=float), np.asarray(data2[1], dtype=float)
    m1 = np.isfinite(t1) & np.isfinite(x1)
    m2 = np.isfinite(t2) & np.isfinite(x2)
    t1, x1 = t1[m1], x1[m1]
    t2, x2 = t2[m2], x2[m2]
    if t1.size < 2 or t2.size < 2:
        if edges is not None and np.asarray(edges).size >= 2:
            edge_arr = np.asarray(edges, dtype=float)
            tau = 0.5 * (edge_arr[:-1] + edge_arr[1:])
            return tau, np.full_like(tau, np.nan), np.full_like(tau, np.nan), np.zeros(tau.shape, dtype=int)
        empty = np.array([], dtype=float)
        return empty, empty, empty, empty.astype(int)
    o1, o2 = np.argsort(t1), np.argsort(t2)
    t1, x1 = t1[o1], x1[o1]
    t2, x2 = t2[o2], x2[o2]
    if edges is None:
        edges = correlation_edges((t1, t2), nbin, bintype)
    else:
        edges = np.asarray(edges, dtype=float)
    tau = 0.5 * (edges[:-1] + edges[1:])
    sigma2 = 0.5 * (np.nanvar(x1) + np.nanvar(x2))
    norm = 2.0 * sigma2 if sigma2 > 0 else 1.0

    def accumulate(tx: np.ndarray, xx: np.ndarray) -> Tuple[np.ndarray, np.ndarray]:
        sums = np.zeros(int(nbin), dtype=float)
        counts = np.zeros(int(nbin), dtype=int)
        for i in range(tx.size):
            lag = np.abs(tx[i] - t2)
            mask = (lag >= edges[0]) & (lag <= edges[-1])
            if not np.any(mask):
                continue
            vals = (xx[i] - x2[mask]) ** 2
            bins = np.searchsorted(edges, lag[mask], side="right") - 1
            ok = (bins >= 0) & (bins < int(nbin))
            if np.any(ok):
                np.add.at(sums, bins[ok], vals[ok])
                np.add.at(counts, bins[ok], 1)
        with np.errstate(invalid="ignore", divide="ignore"):
            s2 = (sums / counts) / norm
        return s2, counts

    s2, counts = accumulate(t1, x1)
    if njack is None or int(njack) < 2:
        err = np.full_like(s2, np.nan, dtype=float)
    else:
        samples = []
        for fold in np.array_split(np.arange(t1.size), int(njack)):
            keep = np.ones(t1.size, dtype=bool)
            keep[fold] = False
            if np.count_nonzero(keep) < 2:
                continue
            samples.append(accumulate(t1[keep], x1[keep])[0])
        if len(samples) > 1:
            sample_arr = np.asarray(samples, dtype=float)
            finite_per_bin = np.count_nonzero(np.isfinite(sample_arr), axis=0)
            err = np.full_like(s2, np.nan, dtype=float)
            valid_bins = finite_per_bin > 1
            if np.any(valid_bins):
                centered = sample_arr[:, valid_bins]
                with np.errstate(invalid="ignore", divide="ignore"):
                    var = np.nanvar(centered, axis=0)
                err[valid_bins] = np.sqrt((len(samples) - 1) * var)
        else:
            err = np.full_like(s2, np.nan)
    return tau, s2, err, counts


def correlation_edges(time_arrays: Sequence[np.ndarray], nbin: int, bintype: str) -> np.ndarray:
    finite_arrays = []
    for times in time_arrays:
        arr = np.asarray(times, dtype=float)
        arr = np.sort(arr[np.isfinite(arr)])
        if arr.size:
            finite_arrays.append(arr)
    if not finite_arrays:
        tmin, tmax = 1.0, 2.0
    else:
        diffs = [np.diff(arr) for arr in finite_arrays if arr.size > 1]
        dt = np.abs(np.concatenate(diffs)) if diffs else np.array([], dtype=float)
        dt = dt[dt > 0]
        tmin = float(np.min(dt)) if dt.size else 1.0
        span = max((float(np.max(arr) - np.min(arr)) for arr in finite_arrays), default=0.0)
        tmax = float(span / 10.0) if span > 0 else max(2.0 * tmin, 2.0)
    if tmax <= tmin:
        tmax = 2.0 * tmin
    if bintype == "lin":
        return np.linspace(tmin, tmax, int(nbin) + 1)
    return np.logspace(np.log10(max(tmin, 1e-6)), np.log10(tmax), int(nbin) + 1)


def tcorr_from_s2(tau: np.ndarray, s2: np.ndarray, threshold: float) -> float:
    valid = np.isfinite(tau) & np.isfinite(s2)
    if np.count_nonzero(valid) < 2:
        return np.nan
    t = tau[valid]
    y = s2[valid]
    order = np.argsort(t)
    t, y = t[order], y[order]
    if y[0] >= threshold:
        return float(t[0])
    above = np.where(y >= threshold)[0]
    if above.size == 0:
        return float(t[-1])
    i = int(above[0])
    if i == 0:
        return float(t[0])
    y0, y1 = y[i - 1], y[i]
    if y1 == y0:
        return float(t[i])
    return float(t[i - 1] + (threshold - y0) * (t[i] - t[i - 1]) / (y1 - y0))


def smooth_s2_curve(tau: np.ndarray, s2: np.ndarray, err: Optional[np.ndarray] = None) -> Tuple[np.ndarray, np.ndarray]:
    x = np.asarray(tau, dtype=float)
    y = np.asarray(s2, dtype=float)
    e = np.asarray(err, dtype=float) if err is not None else np.full(y.shape, np.nan, dtype=float)
    valid = np.isfinite(x) & np.isfinite(y) & (x > 0)
    x = x[valid]
    y = y[valid]
    e = e[valid] if e.shape == valid.shape else np.full(x.shape, np.nan, dtype=float)
    if x.size < 2:
        return x, y
    order = np.argsort(x)
    x = x[order]
    y = y[order]
    e = e[order]
    logx = np.log10(x)
    finite_err = np.isfinite(e) & (e > 0)
    weights = 1.0 / np.square(e[finite_err]) if np.any(finite_err) else None
    degree = min(3, x.size - 1)
    if x.size >= 4:
        try:
            coeff = np.polyfit(logx[finite_err] if np.any(finite_err) else logx, y[finite_err] if np.any(finite_err) else y, degree, w=weights)
            grid = np.logspace(float(np.nanmin(logx)), float(np.nanmax(logx)), 512)
            smooth = np.polyval(coeff, np.log10(grid))
            return grid, smooth
        except Exception:
            pass
    return x, y


def crossing_from_curve(x: np.ndarray, y: np.ndarray, threshold: float) -> float:
    valid = np.isfinite(x) & np.isfinite(y)
    x = np.asarray(x, dtype=float)[valid]
    y = np.asarray(y, dtype=float)[valid]
    if x.size < 2:
        return np.nan
    order = np.argsort(x)
    x = x[order]
    y = y[order]
    if y[0] >= threshold:
        return float(x[0])
    above = np.where(y >= threshold)[0]
    if above.size == 0:
        return np.nan
    idx = int(above[0])
    if idx == 0:
        return float(x[0])
    x0, x1 = float(x[idx - 1]), float(x[idx])
    y0, y1 = float(y[idx - 1]), float(y[idx])
    if not all(np.isfinite(v) for v in (x0, x1, y0, y1)) or y1 == y0:
        return x1
    return float(x0 + (threshold - y0) * (x1 - x0) / (y1 - y0))


def estimate_corr_lag(tau: np.ndarray, s2: np.ndarray, err: np.ndarray, threshold: float) -> Tuple[float, float]:
    x_smooth, y_smooth = smooth_s2_curve(tau, s2, err)
    corr = crossing_from_curve(x_smooth, y_smooth, threshold)
    finite = np.isfinite(tau) & np.isfinite(s2) & np.isfinite(err) & (err > 0)
    if np.count_nonzero(finite) < 3:
        return corr, np.nan
    rng = np.random.default_rng(20260812)
    samples: List[float] = []
    tau_f = np.asarray(tau, dtype=float)[finite]
    s2_f = np.asarray(s2, dtype=float)[finite]
    err_f = np.asarray(err, dtype=float)[finite]
    for _ in range(64):
        perturbed = s2_f + rng.normal(0.0, err_f)
        sx, sy = smooth_s2_curve(tau_f, perturbed, err_f)
        value = crossing_from_curve(sx, sy, threshold)
        if np.isfinite(value):
            samples.append(float(value))
    return corr, float(np.nanstd(np.asarray(samples, dtype=float))) if len(samples) > 1 else np.nan


def read_series(
    input_table: Path,
    mode: str,
    scans: Optional[List[int]],
    antennas: Optional[List[int]],
    antenna_flags: Optional[List[int]],
    use_flags: bool,
    bchan: Optional[int],
    echan: Optional[int],
    flag_chans: Optional[Tuple[int, int]],
    flag_lookup: Optional[Dict[Tuple[int, int, int], bool]] = None,
) -> Tuple[Dict[int, Dict[int, Dict[int, Dict[str, Tuple[np.ndarray, np.ndarray]]]]], Dict[str, Any]]:
    tb, cols, data_col, all_ant, all_scan, selected_scans, selected_antennas, ch0, ch1 = open_context(
        input_table, mode, scans, antennas, bchan, echan
    )
    try:
        if use_flags and flag_lookup is None:
            require_flag_column(cols, input_table)
        forced_flag_antennas = antenna_flag_set(antenna_flags)
        times = np.asarray(tb.getcol("TIME"), dtype=float) if "TIME" in cols else np.arange(tb.nrows(), dtype=float)
        out: Dict[int, Dict[int, Dict[int, Dict[str, Tuple[np.ndarray, np.ndarray]]]]] = {}
        stokes_count = 0
        for scan in selected_scans:
            out[int(scan)] = {}
            for antenna in selected_antennas:
                row_ids = np.where((all_scan == int(scan)) & (all_ant == int(antenna)))[0]
                if row_ids.size == 0:
                    continue
                data_full = np.asarray(tb.getcol(data_col))
                if data_full.ndim == 2:
                    data_full = data_full[:, None, :]
                data = data_full[:, ch0:ch1, :][:, :, row_ids].astype(np.complex128, copy=True)
                if use_flags and flag_lookup is not None:
                    flag_full = flags_from_lookup(flag_lookup, row_ids, data_full.shape[0], 0, data_full.shape[1])
                    flag = normalize_flag(flag_full, data_full[:, :, row_ids].shape, 0, flag_chans)[:, ch0:ch1, :]
                elif use_flags:
                    flag_full = np.asarray(tb.getcol("FLAG"))
                    flag_full = flag_full[:, None, :] if flag_full.ndim == 2 else flag_full
                    flag = normalize_flag(flag_full[:, :, row_ids], data_full[:, :, row_ids].shape, 0, flag_chans)[:, ch0:ch1, :]
                else:
                    flag = np.zeros(data.shape, dtype=bool)
                if int(antenna) in forced_flag_antennas:
                    flag = np.ones(flag.shape, dtype=bool)
                if use_flags:
                    data[flag] = np.nan + 1j * np.nan
                elif int(antenna) in forced_flag_antennas:
                    data[:] = np.nan + 1j * np.nan
                stokes_count = max(stokes_count, data.shape[0])
                out[int(scan)][int(antenna)] = {}
                for pol in range(data.shape[0]):
                    if mode == "bandpass":
                        axis = np.arange(ch0, ch1, dtype=float)
                        real = nanmean_no_warning((data[pol].real - 1.0) * 100.0, axis=1)
                        imag = nanmean_no_warning(data[pol].imag * 100.0, axis=1)
                    else:
                        axis = times[row_ids]
                        real = nanmean_no_warning((data[pol].real - 1.0) * 100.0, axis=0)
                        imag = nanmean_no_warning(data[pol].imag * 100.0, axis=0)
                    out[int(scan)][int(antenna)][pol] = {"real": (axis, real), "imag": (axis, imag)}
        meta = {
            "input_table": str(input_table),
            "mode": mode,
            "data_column": data_col,
            "scan_numbers": np.asarray(selected_scans, dtype=int),
            "antennas": np.asarray(selected_antennas, dtype=int),
            "stokes": np.arange(stokes_count, dtype=int),
            "bchan": bchan,
            "echan": echan,
            "flag_chans": flag_chans,
            "use_flags": bool(use_flags),
            "flag_source": "flg" if flag_lookup is not None and use_flags else "casa-table" if use_flags else "none",
            "antenna_flags": sorted(forced_flag_antennas),
        }
        return out, meta
    finally:
        tb.close()


def nanmean_no_warning(values: np.ndarray, axis: int) -> np.ndarray:
    arr = np.asarray(values, dtype=float)
    finite = np.isfinite(arr)
    count = np.sum(finite, axis=axis)
    total = np.nansum(arr, axis=axis)
    out = np.full(count.shape, np.nan, dtype=float)
    np.divide(total, count, out=out, where=count > 0)
    return out


def compute_self_corr(
    input_table: Path,
    mode: str,
    scans: Optional[List[int]],
    antennas: Optional[List[int]],
    antenna_flags: Optional[List[int]],
    use_flags: bool,
    bchan: Optional[int],
    echan: Optional[int],
    flag_chans: Optional[Tuple[int, int]],
    nbin: int,
    bintype: str,
    njack: int,
    threshold: float,
    flag_lookup: Optional[Dict[Tuple[int, int, int], bool]] = None,
) -> Dict[str, Any]:
    series, meta = read_series(input_table, mode, scans, antennas, antenna_flags, use_flags, bchan, echan, flag_chans, flag_lookup)
    if mode == "bandpass":
        spw_info = spectral_window_info(input_table)
        channel_width_hz = spw_info.get("channel_width_hz")
        if channel_width_hz is not None:
            width_slice = np.asarray(channel_width_hz, dtype=float)
            if bchan is not None or echan is not None:
                start = 0 if bchan is None else int(bchan)
                stop = width_slice.size if echan is None else min(int(echan), width_slice.size)
                width_slice = width_slice[start:stop]
            finite_widths = np.abs(width_slice[np.isfinite(width_slice) & (width_slice != 0)])
            if finite_widths.size:
                meta["channel_width_hz"] = float(np.nanmedian(finite_widths))
                meta["channel_width_khz"] = float(np.nanmedian(finite_widths) / 1.0e3)
    rows = {k: [] for k in ["scan", "antenna", "stokes", "component", "tau", "s2", "err", "count"]}
    corr_rows = {
        k: []
        for k in [
            "scan",
            "antenna",
            "stokes",
            "component",
            "corr_lag",
            "corr_lag_err",
            "tcorr_sec",
            "tcorr_sec_err",
            "dnucorr_hz",
            "dnucorr_hz_err",
            "dnucorr_mhz",
            "dnucorr_mhz_err",
        ]
    }
    skipped: List[Dict[str, Any]] = []
    scan_values = [int(v) for v in np.asarray(meta.get("scan_numbers", []), dtype=int)]
    ant_values = [int(v) for v in np.asarray(meta.get("antennas", []), dtype=int)]
    stokes_values = [int(v) for v in np.asarray(meta.get("stokes", []), dtype=int)]
    for scan in scan_values:
        by_ant = series.get(int(scan), {})
        scan_axes = [
            data[0]
            for by_pol in by_ant.values()
            for by_comp in by_pol.values()
            for data in by_comp.values()
        ]
        edges = correlation_edges(scan_axes, nbin, bintype)
        tau_grid = 0.5 * (edges[:-1] + edges[1:])
        for ant in ant_values:
            by_pol = by_ant.get(int(ant), {})
            for pol in stokes_values:
                by_comp = by_pol.get(int(pol), {})
                for comp in CORR_COMPONENTS:
                    data = by_comp.get(comp)
                    reason = ""
                    if data is None:
                        reason = "no selected samples"
                    else:
                        axis, values = data
                        finite = np.isfinite(axis) & np.isfinite(values)
                        if np.count_nonzero(finite) < 2:
                            reason = "fewer than two finite unflagged samples"
                    if reason:
                        tau = tau_grid
                        s2 = np.full(tau.shape, np.nan, dtype=float)
                        err = np.full(tau.shape, np.nan, dtype=float)
                        count = np.zeros(tau.shape, dtype=int)
                        skipped.append(
                            {
                                "scan": int(scan),
                                "antenna": int(ant),
                                "stokes": int(pol),
                                "component": str(comp),
                                "reason": reason,
                            }
                        )
                        print(
                            f"SKIP self-corr scan={int(scan)} antenna={int(ant)} "
                            f"stokes={int(pol)} component={comp} reason={reason}"
                        )
                    else:
                        tau, s2, err, count = compute_structure_function(data, None, nbin=nbin, bintype=bintype, njack=njack, edges=edges)
                    corr_lag, corr_lag_err = estimate_corr_lag(tau, s2, err, threshold)
                    channel_width_hz = float(meta.get("channel_width_hz", np.nan))
                    tcorr_sec = corr_lag if mode != "bandpass" else np.nan
                    tcorr_sec_err = corr_lag_err if mode != "bandpass" else np.nan
                    dnucorr_hz = corr_lag * channel_width_hz if mode == "bandpass" and np.isfinite(channel_width_hz) else np.nan
                    dnucorr_hz_err = corr_lag_err * channel_width_hz if mode == "bandpass" and np.isfinite(channel_width_hz) else np.nan
                    corr_rows["scan"].append(scan)
                    corr_rows["antenna"].append(ant)
                    corr_rows["stokes"].append(pol)
                    corr_rows["component"].append(comp)
                    corr_rows["corr_lag"].append(float(corr_lag) if np.isfinite(corr_lag) else np.nan)
                    corr_rows["corr_lag_err"].append(float(corr_lag_err) if np.isfinite(corr_lag_err) else np.nan)
                    corr_rows["tcorr_sec"].append(float(tcorr_sec) if np.isfinite(tcorr_sec) else np.nan)
                    corr_rows["tcorr_sec_err"].append(float(tcorr_sec_err) if np.isfinite(tcorr_sec_err) else np.nan)
                    corr_rows["dnucorr_hz"].append(float(dnucorr_hz) if np.isfinite(dnucorr_hz) else np.nan)
                    corr_rows["dnucorr_hz_err"].append(float(dnucorr_hz_err) if np.isfinite(dnucorr_hz_err) else np.nan)
                    corr_rows["dnucorr_mhz"].append(float(dnucorr_hz / 1.0e6) if np.isfinite(dnucorr_hz) else np.nan)
                    corr_rows["dnucorr_mhz_err"].append(float(dnucorr_hz_err / 1.0e6) if np.isfinite(dnucorr_hz_err) else np.nan)
                    for i in range(tau.size):
                        rows["scan"].append(scan)
                        rows["antenna"].append(ant)
                        rows["stokes"].append(pol)
                        rows["component"].append(comp)
                        rows["tau"].append(float(tau[i]))
                        rows["s2"].append(float(s2[i]) if np.isfinite(s2[i]) else np.nan)
                        rows["err"].append(float(err[i]) if np.isfinite(err[i]) else np.nan)
                        rows["count"].append(int(count[i]))
    return {
        "header": {
            "format": "GDP_SELF_CORR_NPZ",
            "format_version": "0.1",
            "created_utc": datetime.now(timezone.utc).isoformat(),
            **meta,
            "nbin": int(nbin),
            "bintype": bintype,
            "njack": int(njack),
            "corr_threshold": float(threshold),
            "corr_estimator": "weighted cubic polynomial smoothing in log10(lag), falling back to linear interpolation when needed",
            "columns": list(rows.keys()),
            "corr_columns": list(corr_rows.keys()),
            "skipped": skipped,
        },
        **{k: np.asarray(v, dtype=object if k == "component" else float if k in {"tau", "s2", "err"} else int) for k, v in rows.items()},
        **{
            (k if k.startswith("corr_") else f"corr_{k}"): np.asarray(
                v,
                dtype=object if k == "component" else float if k not in {"scan", "antenna", "stokes"} else int,
            )
            for k, v in corr_rows.items()
        },
    }


def load_npz_dict(path: Path) -> Dict[str, Any]:
    if not path.exists():
        raise SystemExit(f"ERROR: gains NPZ not found: {display_path(path)}")
    with np.load(path, allow_pickle=True) as z:
        header = json.loads(str(z["header_json"])) if "header_json" in z.files else {}
        out: Dict[str, Any] = {"header": header}
        for key in z.files:
            if key != "header_json":
                out[key] = np.asarray(z[key])
    return out


def load_gains_for_cross_corr(gains_npz: Path, use_flags: bool, flag_path: Optional[Path]) -> Tuple[Dict[str, Any], Dict[str, Any]]:
    gains = load_npz_dict(gains_npz)
    required = {"scan", "antenna", "stokes", "channel", "row", "time", "real", "imag"}
    missing = required - set(gains)
    if missing:
        raise SystemExit(f"ERROR: {display_path(gains_npz)} is missing gains arrays: {', '.join(sorted(missing))}")
    flag_header: Dict[str, Any] = {}
    if use_flags:
        if flag_path is None:
            version, resolved = resolve_flag_file(gains_npz, None)
            flag_path = resolved
            flag_header["flag_version"] = int(version)
        lookup, loaded_header = load_flag_lookup(flag_path)
        flag_header.update(loaded_header)
        rows = np.asarray(gains["row"], dtype=int)
        stokes = np.asarray(gains["stokes"], dtype=int)
        channels = np.asarray(gains["channel"], dtype=int)
        flags = np.asarray([lookup.get((int(row), int(pol), int(chan)), False) for row, pol, chan in zip(rows, stokes, channels)], dtype=bool)
        gains["flagged"] = flags
        real = np.asarray(gains["real"], dtype=float).copy()
        imag = np.asarray(gains["imag"], dtype=float).copy()
        real[flags] = np.nan
        imag[flags] = np.nan
        gains["real"] = real
        gains["imag"] = imag
    return gains, flag_header


def gains_npz_series(
    gains: Dict[str, Any],
    mode: str,
    scan: int,
    antenna: int,
    stokes: int,
    component: str,
) -> Tuple[np.ndarray, np.ndarray]:
    scans = np.asarray(gains["scan"], dtype=int)
    antennas = np.asarray(gains["antenna"], dtype=int)
    stokes_arr = np.asarray(gains["stokes"], dtype=int)
    mask = (scans == int(scan)) & (antennas == int(antenna)) & (stokes_arr == int(stokes))
    if not np.any(mask):
        return np.array([], dtype=float), np.array([], dtype=float)
    axis = np.asarray(gains["channel" if mode == "bandpass" else "time"], dtype=float)[mask]
    if component == "real":
        values = (np.asarray(gains["real"], dtype=float)[mask] - 1.0) * 100.0
    else:
        values = np.asarray(gains["imag"], dtype=float)[mask] * 100.0
    finite_axis = np.isfinite(axis)
    axis = axis[finite_axis]
    values = values[finite_axis]
    if axis.size == 0:
        return axis, values
    unique_axis = np.unique(axis)
    grouped = np.full(unique_axis.shape, np.nan, dtype=float)
    for idx, value in enumerate(unique_axis):
        grouped[idx] = nanmean_no_warning(values[axis == value], axis=0)
    return unique_axis, grouped


def median_positive(values: np.ndarray) -> float:
    arr = np.asarray(values, dtype=float)
    arr = np.abs(arr[np.isfinite(arr) & (arr != 0)])
    return float(np.nanmedian(arr)) if arr.size else np.nan


def cross_corr_channel_width_hz(gains: Dict[str, Any]) -> float:
    if "channel_width_hz" in gains:
        return median_positive(np.asarray(gains["channel_width_hz"], dtype=float))
    header = gains.get("header", {})
    value = header.get("channel_width_hz")
    try:
        return float(value)
    except Exception:
        return np.nan


def cross_corr_option_path(base: Path, mode: str, option: Dict[str, Any], flag_version: Optional[int]) -> Path:
    if base.suffix == ".npz":
        return base
    suffix = flag_version_suffix(flag_version)
    name = (
        f"gdp-cross-corr-{mode}-scan{int(option['scan'])}{suffix}-"
        f"ant{int(option['ant1'])}_{int(option['ant2'])}-"
        f"stokes{int(option['stokes1'])}{int(option['stokes2'])}-"
        f"comp{str(option['component1'])[:2]}{str(option['component2'])[:2]}.npz"
    )
    return base / name


def cross_corr_summary_path(base: Path, mode: str, scan_label: str, flag_version: Optional[int]) -> Path:
    directory = base.parent if base.suffix == ".npz" else base
    suffix = flag_version_suffix(flag_version)
    scan_text = scan_label[4:] if scan_label.startswith("scan") else scan_label
    return directory / f"gdp-cross-corr-{mode}-scan{scan_text}{suffix}-summary.npz"


def enumerate_cross_corr_options(
    gains: Dict[str, Any],
    mode: str,
    scans: Optional[List[int]],
    antennas: Optional[List[int]],
    stokes_arg: object,
    complex_arg: object,
) -> List[Dict[str, Any]]:
    scan_values = sorted(int(v) for v in np.unique(np.asarray(gains["scan"], dtype=int)))
    if scans is not None:
        wanted = {int(v) for v in scans}
        scan_values = [scan for scan in scan_values if scan in wanted]
    antenna_values = sorted(int(v) for v in np.unique(np.asarray(gains["antenna"], dtype=int)))
    if antennas is not None:
        wanted_ant = {int(v) for v in antennas}
        antenna_values = [ant for ant in antenna_values if ant in wanted_ant]
    if len(antenna_values) < 2:
        raise SystemExit("ERROR: cross-corr needs at least two selected antennas in the gains NPZ.")
    stokes_values = sorted(int(v) for v in np.unique(np.asarray(gains["stokes"], dtype=int)))
    stokes_pairs = parse_pair_selector(stokes_arg, stokes_values, "--stokes")
    component_pairs = parse_complex_pair_selector(complex_arg)
    options: List[Dict[str, Any]] = []
    for scan in scan_values:
        scan_mask = np.asarray(gains["scan"], dtype=int) == int(scan)
        scan_ants = sorted(set(int(v) for v in np.asarray(gains["antenna"], dtype=int)[scan_mask]) & set(antenna_values))
        for i, ant1 in enumerate(scan_ants):
            for ant2 in scan_ants[i + 1 :]:
                for stokes1, stokes2 in stokes_pairs:
                    for component1, component2 in component_pairs:
                        options.append(
                            {
                                "scan": int(scan),
                                "ant1": int(ant1),
                                "ant2": int(ant2),
                                "stokes1": int(stokes1),
                                "stokes2": int(stokes2),
                                "component1": str(component1),
                                "component2": str(component2),
                            }
                        )
    return options


def cross_corr_write_matrix_summary(args: argparse.Namespace, scans: Optional[List[int]], antennas: Optional[List[int]], output_base: Path) -> bool:
    if output_base.suffix == ".npz":
        return False
    if scans is None or len(scans) != 1:
        return False
    if antennas is not None:
        return False
    stokes_tokens = split_selector_tokens(args.stokes)
    complex_tokens = split_selector_tokens(args.complex)
    stokes_all = not stokes_tokens or any(token.lower() == "all" for token in stokes_tokens)
    complex_all = not complex_tokens or any(token.lower() == "all" for token in complex_tokens)
    return stokes_all and complex_all


def cross_corr_result_from_gains(
    gains: Dict[str, Any],
    gains_npz: Path,
    mode: str,
    option: Dict[str, Any],
    args_dict: Dict[str, Any],
    flag_header: Optional[Dict[str, Any]] = None,
) -> Dict[str, Any]:
    series1 = gains_npz_series(gains, mode, option["scan"], option["ant1"], option["stokes1"], option["component1"])
    series2 = gains_npz_series(gains, mode, option["scan"], option["ant2"], option["stokes2"], option["component2"])
    axes = [series1[0], series2[0]]
    edges = correlation_edges(axes, int(args_dict["corr_nbin"]), str(args_dict["corr_bintype"]))
    tau, s2, err, count = compute_structure_function(
        series1,
        series2,
        nbin=int(args_dict["corr_nbin"]),
        bintype=str(args_dict["corr_bintype"]),
        njack=int(args_dict["corr_njack"]),
        edges=edges,
    )
    corr_lag, corr_lag_err = estimate_corr_lag(tau, s2, err, float(args_dict["corr_threshold"]))
    channel_width_hz = cross_corr_channel_width_hz(gains)
    if mode == "bandpass" and np.isfinite(channel_width_hz):
        dnucorr_hz = corr_lag * channel_width_hz
        dnucorr_hz_err = corr_lag_err * channel_width_hz
        tcorr_sec = np.nan
        tcorr_sec_err = np.nan
    else:
        dnucorr_hz = np.nan
        dnucorr_hz_err = np.nan
        tcorr_sec = corr_lag
        tcorr_sec_err = corr_lag_err
    header = {
        "format": "GDP_CROSS_CORR_NPZ",
        "format_version": "0.1",
        "created_utc": datetime.now(timezone.utc).isoformat(),
        "product": "cross_corr",
        "source_gains_npz": str(gains_npz),
        "source_gains_format": gains.get("header", {}).get("format"),
        "input_table": gains.get("header", {}).get("input_table"),
        "mode": mode,
        "scan": int(option["scan"]),
        "antenna1": int(option["ant1"]),
        "antenna2": int(option["ant2"]),
        "stokes1": int(option["stokes1"]),
        "stokes2": int(option["stokes2"]),
        "component1": str(option["component1"]),
        "component2": str(option["component2"]),
        "axis": "channel_difference" if mode == "bandpass" else "time_difference_sec",
        "normalization": "mean((x1-x2)^2) divided by sigma1^2 + sigma2^2, using finite unflagged gains",
        "use_flags": bool(args_dict["use_flags"]),
        "flag_source": "flg" if bool(args_dict["use_flags"]) else "none",
        "flag_file_version": (flag_header or {}).get("flag_version"),
        "corr_threshold": float(args_dict["corr_threshold"]),
        "corr_nbin": int(args_dict["corr_nbin"]),
        "corr_bintype": str(args_dict["corr_bintype"]),
        "corr_njack": int(args_dict["corr_njack"]),
        "corr_estimator": "same smoothed threshold-crossing estimator used by self-corr",
        "channel_width_hz": float(channel_width_hz) if np.isfinite(channel_width_hz) else np.nan,
        "channel_width_mhz": float(channel_width_hz / 1.0e6) if np.isfinite(channel_width_hz) else np.nan,
        "columns": ["tau", "s2", "err", "count"],
        "corr_columns": [
            "corr_lag",
            "corr_lag_err",
            "tcorr_sec",
            "tcorr_sec_err",
            "dnucorr_hz",
            "dnucorr_hz_err",
            "dnucorr_mhz",
            "dnucorr_mhz_err",
        ],
        "n_sample1": int(np.count_nonzero(np.isfinite(series1[1]))),
        "n_sample2": int(np.count_nonzero(np.isfinite(series2[1]))),
        "npair": int(np.nansum(count)) if count.size else 0,
    }
    return {
        "header": header,
        "tau": np.asarray(tau, dtype=float),
        "s2": np.asarray(s2, dtype=float),
        "err": np.asarray(err, dtype=float),
        "count": np.asarray(count, dtype=int),
        "scan": np.asarray([int(option["scan"])], dtype=int),
        "antenna1": np.asarray([int(option["ant1"])], dtype=int),
        "antenna2": np.asarray([int(option["ant2"])], dtype=int),
        "stokes1": np.asarray([int(option["stokes1"])], dtype=int),
        "stokes2": np.asarray([int(option["stokes2"])], dtype=int),
        "component1": np.asarray([str(option["component1"])], dtype=object),
        "component2": np.asarray([str(option["component2"])], dtype=object),
        "corr_lag": np.asarray([float(corr_lag) if np.isfinite(corr_lag) else np.nan], dtype=float),
        "corr_lag_err": np.asarray([float(corr_lag_err) if np.isfinite(corr_lag_err) else np.nan], dtype=float),
        "tcorr_sec": np.asarray([float(tcorr_sec) if np.isfinite(tcorr_sec) else np.nan], dtype=float),
        "tcorr_sec_err": np.asarray([float(tcorr_sec_err) if np.isfinite(tcorr_sec_err) else np.nan], dtype=float),
        "dnucorr_hz": np.asarray([float(dnucorr_hz) if np.isfinite(dnucorr_hz) else np.nan], dtype=float),
        "dnucorr_hz_err": np.asarray([float(dnucorr_hz_err) if np.isfinite(dnucorr_hz_err) else np.nan], dtype=float),
        "dnucorr_mhz": np.asarray([float(dnucorr_hz / 1.0e6) if np.isfinite(dnucorr_hz) else np.nan], dtype=float),
        "dnucorr_mhz_err": np.asarray([float(dnucorr_hz_err / 1.0e6) if np.isfinite(dnucorr_hz_err) else np.nan], dtype=float),
    }


def cross_corr_worker(payload: Dict[str, Any]) -> Dict[str, Any]:
    gains_npz = Path(payload["gains_npz"])
    flag_path = Path(payload["flag_path"]) if payload.get("flag_path") else None
    gains, flag_header = load_gains_for_cross_corr(gains_npz, bool(payload["args"]["use_flags"]), flag_path)
    t0 = time.perf_counter()
    result = cross_corr_result_from_gains(gains, gains_npz, str(payload["mode"]), payload["option"], payload["args"], flag_header)
    out = Path(payload["output"])
    if payload.get("write", True):
        write_npz(out, result)
    return {
        "output": str(out),
        "elapsed_sec": float(time.perf_counter() - t0),
        "nbytes": int(out.stat().st_size) if out.exists() else 0,
        "npair": int(result["header"].get("npair", 0)),
        "nbin_valid": int(np.count_nonzero(np.isfinite(result["s2"]))),
    }


def scalar_from_npz(z: Dict[str, np.ndarray], key: str, default: float = np.nan) -> float:
    if key not in z:
        return default
    arr = np.asarray(z[key]).ravel()
    if not arr.size:
        return default
    try:
        return float(arr[0])
    except (TypeError, ValueError):
        return default


def object_scalar_from_npz(z: Dict[str, np.ndarray], key: str, default: str = "") -> str:
    if key not in z:
        return default
    arr = np.asarray(z[key], dtype=object).ravel()
    if not arr.size:
        return default
    return str(arr[0])


def write_cross_corr_summary_npz(
    summary_path: Path,
    product_paths: Sequence[Path],
    gains_npz: Path,
    mode: str,
    scan_label: str,
    args: argparse.Namespace,
    applied_flag_version: Optional[int],
) -> int:
    rows: Dict[str, List[Any]] = {
        "scan": [],
        "antenna1": [],
        "antenna2": [],
        "stokes1": [],
        "stokes2": [],
        "component1": [],
        "component2": [],
        "corr_lag": [],
        "corr_lag_err": [],
        "tcorr_sec": [],
        "tcorr_sec_err": [],
        "dnucorr_hz": [],
        "dnucorr_hz_err": [],
        "dnucorr_mhz": [],
        "dnucorr_mhz_err": [],
        "delta_threshold": [],
        "channel_width_hz": [],
        "channel_width_mhz": [],
        "npair": [],
        "n_sample1": [],
        "n_sample2": [],
        "product_file": [],
    }
    table_name = ""
    for path in product_paths:
        if not path.exists():
            continue
        try:
            with np.load(path, allow_pickle=True) as loaded:
                z = {key: loaded[key] for key in loaded.files}
            header = json.loads(str(np.asarray(z["header_json"]).item())) if "header_json" in z else {}
        except Exception:
            continue
        table_name = table_name or str(header.get("input_table", ""))
        rows["scan"].append(int(scalar_from_npz(z, "scan", header.get("scan", -1))))
        rows["antenna1"].append(int(scalar_from_npz(z, "antenna1", header.get("antenna1", -1))))
        rows["antenna2"].append(int(scalar_from_npz(z, "antenna2", header.get("antenna2", -1))))
        rows["stokes1"].append(int(scalar_from_npz(z, "stokes1", header.get("stokes1", -1))))
        rows["stokes2"].append(int(scalar_from_npz(z, "stokes2", header.get("stokes2", -1))))
        rows["component1"].append(object_scalar_from_npz(z, "component1", str(header.get("component1", ""))))
        rows["component2"].append(object_scalar_from_npz(z, "component2", str(header.get("component2", ""))))
        for key in ("corr_lag", "corr_lag_err", "tcorr_sec", "tcorr_sec_err", "dnucorr_hz", "dnucorr_hz_err", "dnucorr_mhz", "dnucorr_mhz_err"):
            rows[key].append(scalar_from_npz(z, key))
        channel_width_hz = float(header.get("channel_width_hz", np.nan))
        if mode == "bandpass" and np.isfinite(channel_width_hz) and channel_width_hz > 0:
            delta_threshold = 2.0 * channel_width_hz / 1000.0
        elif "tau" in z:
            tau = np.asarray(z["tau"], dtype=float).ravel()
            finite_tau = tau[np.isfinite(tau) & (tau > 0)]
            delta_threshold = 2.0 * float(np.nanmin(finite_tau)) if finite_tau.size else np.nan
        else:
            delta_threshold = np.nan
        rows["delta_threshold"].append(float(delta_threshold) if np.isfinite(delta_threshold) else np.nan)
        rows["channel_width_hz"].append(channel_width_hz)
        rows["channel_width_mhz"].append(float(header.get("channel_width_mhz", np.nan)))
        rows["npair"].append(int(header.get("npair", 0)))
        rows["n_sample1"].append(int(header.get("n_sample1", 0)))
        rows["n_sample2"].append(int(header.get("n_sample2", 0)))
        rows["product_file"].append(str(path))
    header = {
        "format": "GDP_CROSS_CORR_SUMMARY_NPZ",
        "format_version": "0.1",
        "created_utc": datetime.now(timezone.utc).isoformat(),
        "product": "cross_corr_summary",
        "source_gains_npz": str(gains_npz),
        "input_table": table_name,
        "mode": mode,
        "scan_label": scan_label,
        "use_flags": bool(args.use_flags),
        "flag_file_version": applied_flag_version if args.use_flags else None,
        "corr_threshold": float(args.corr_threshold),
        "corr_njack": int(args.corr_njack),
        "n_cross_corr": len(rows["scan"]),
        "columns": list(rows.keys()),
    }
    result = {
        "header": header,
        "scan": np.asarray(rows["scan"], dtype=int),
        "antenna1": np.asarray(rows["antenna1"], dtype=int),
        "antenna2": np.asarray(rows["antenna2"], dtype=int),
        "stokes1": np.asarray(rows["stokes1"], dtype=int),
        "stokes2": np.asarray(rows["stokes2"], dtype=int),
        "component1": np.asarray(rows["component1"], dtype=object),
        "component2": np.asarray(rows["component2"], dtype=object),
        "corr_lag": np.asarray(rows["corr_lag"], dtype=float),
        "corr_lag_err": np.asarray(rows["corr_lag_err"], dtype=float),
        "tcorr_sec": np.asarray(rows["tcorr_sec"], dtype=float),
        "tcorr_sec_err": np.asarray(rows["tcorr_sec_err"], dtype=float),
        "dnucorr_hz": np.asarray(rows["dnucorr_hz"], dtype=float),
        "dnucorr_hz_err": np.asarray(rows["dnucorr_hz_err"], dtype=float),
        "dnucorr_mhz": np.asarray(rows["dnucorr_mhz"], dtype=float),
        "dnucorr_mhz_err": np.asarray(rows["dnucorr_mhz_err"], dtype=float),
        "delta_threshold": np.asarray(rows["delta_threshold"], dtype=float),
        "channel_width_hz": np.asarray(rows["channel_width_hz"], dtype=float),
        "channel_width_mhz": np.asarray(rows["channel_width_mhz"], dtype=float),
        "npair": np.asarray(rows["npair"], dtype=int),
        "n_sample1": np.asarray(rows["n_sample1"], dtype=int),
        "n_sample2": np.asarray(rows["n_sample2"], dtype=int),
        "product_file": np.asarray(rows["product_file"], dtype=object),
    }
    write_npz(summary_path, result)
    return len(rows["scan"])


def resolve_cross_corr_gains_npz(gains_out: Path, mode: str, scan_label: str) -> Path:
    if gains_out.exists():
        return gains_out
    scan_arg = ""
    if scan_label.startswith("scan"):
        scan_value = scan_label[4:].replace("-", ",")
        if scan_value:
            scan_arg = f" --scan {scan_value}"
    raise SystemExit(
        "ERROR: saved gains NPZ is required before cross-corr can run.\n"
        f"Missing gains NPZ: {display_path(gains_out)}\n"
        f"Run first: gdp-stats --mode {mode}{scan_arg} --smode gains"
    )


def resolve_cross_corr_output_base(args: argparse.Namespace, input_table: Path, scan_label: str, mode: str) -> Path:
    if args.output_cross_corr_npz:
        return Path(args.output_cross_corr_npz).expanduser().resolve()
    return default_output_dir("cross_corr", "npz")


def cross_corr_args_dict(args: argparse.Namespace) -> Dict[str, Any]:
    return {
        "use_flags": bool(args.use_flags),
        "corr_threshold": float(args.corr_threshold),
        "corr_nbin": int(args.corr_nbin),
        "corr_bintype": str(args.corr_bintype),
        "corr_njack": int(args.corr_njack),
    }


def cross_corr_worker_count(value: object) -> Optional[int]:
    if value in (None, False):
        return None
    if value is True or str(value).strip().lower() in {"", "auto", "true", "yes", "on"}:
        return max(1, (os.cpu_count() or 2) - 2)
    try:
        ncpu = int(value)
    except ValueError as exc:
        raise SystemExit("--parallel must be given as --parallel or --parallel NCPU.") from exc
    if ncpu < 1:
        raise SystemExit("--parallel NCPU must be at least 1.")
    return ncpu


def run_cross_corr_from_npz(
    args: argparse.Namespace,
    gains_npz: Path,
    input_table: Path,
    mode: str,
    scans: Optional[List[int]],
    antennas: Optional[List[int]],
    scan_label: str,
    flag_path: Optional[Path],
    applied_flag_version: Optional[int],
    logger: TaskLogger,
) -> None:
    gains, _flag_header = load_gains_for_cross_corr(gains_npz, bool(args.use_flags), flag_path)
    gains_mode = str(gains.get("header", {}).get("mode") or mode)
    if gains_mode in {"gain", "bandpass"} and gains_mode != mode:
        raise SystemExit(f"ERROR: gains NPZ mode is {gains_mode}, but requested --mode {mode}.")
    options = enumerate_cross_corr_options(gains, mode, scans, antennas, args.stokes, args.complex)
    if not options:
        raise SystemExit("ERROR: no cross-corr options matched the selected scan/antenna/stokes/component filters.")
    output_base = resolve_cross_corr_output_base(args, input_table, scan_label, mode)
    if output_base.suffix == ".npz" and len(options) > 1:
        raise SystemExit("--output-cross-corr-npz may be a file only when exactly one cross-corr option is selected; otherwise pass a directory.")
    outputs = [cross_corr_option_path(output_base, mode, option, applied_flag_version if args.use_flags else None) for option in options]
    logger.write(f"cross-corr gains NPZ: {gains_npz}")
    logger.write(f"cross-corr options: {len(options)}")
    preview = ", ".join(display_path(path) for path in outputs[:5])
    if len(outputs) > 5:
        preview += f", ... ({len(outputs)} total)"
    logger.write(f"cross-corr output preview: {preview}")
    if args.dry_run:
        logger.write("cross-corr dry-run: no products written.")
        return
    worker_args = cross_corr_args_dict(args)
    payloads = [
        {
            "gains_npz": str(gains_npz),
            "flag_path": str(flag_path) if flag_path else None,
            "mode": mode,
            "option": option,
            "args": worker_args,
            "output": str(out),
            "write": True,
        }
        for option, out in zip(options, outputs)
    ]
    ncpu = cross_corr_worker_count(args.parallel)
    if args.estimate:
        sample_count = min(max(1, int(args.estimate_count)), len(payloads))
        sample_payloads = payloads[:sample_count]
        sizes: List[int] = []
        elapsed: List[float] = []
        with tempfile.TemporaryDirectory(prefix="gdp-cross-corr-estimate-") as tmpdir:
            for idx, payload in enumerate(sample_payloads):
                sample = dict(payload)
                sample["output"] = str(Path(tmpdir) / f"sample-{idx}.npz")
                result = cross_corr_worker(sample)
                sizes.append(int(result["nbytes"]))
                elapsed.append(float(result["elapsed_sec"]))
        mean_time = float(np.mean(elapsed)) if elapsed else 0.0
        mean_size = float(np.mean(sizes)) if sizes else 0.0
        worker_count = min(int(ncpu), len(payloads)) if ncpu is not None else 1
        estimated_cpu_sec = mean_time * len(payloads)
        estimated_wall_sec = mean_time * math.ceil(len(payloads) / worker_count)
        logger.write("cross-corr estimate:")
        logger.write(f"samples={sample_count}/{len(payloads)}")
        logger.write(f"mean_job_sec={mean_time:.3f}")
        logger.write(f"workers={worker_count}")
        logger.write(f"estimated_cpu_sec={estimated_cpu_sec:.3f}")
        logger.write(f"estimated_wall_sec={estimated_wall_sec:.3f}")
        logger.write(f"mean_size={format_bytes(mean_size)}")
        logger.write(f"estimated_total_size={format_bytes(mean_size * len(payloads))}")
        return
    written = 0
    total_size = 0
    written_paths: List[Path] = []
    if ncpu is None or ncpu == 1 or len(payloads) == 1:
        for payload in payloads:
            result = cross_corr_worker(payload)
            written += 1
            total_size += int(result.get("nbytes", 0))
            written_paths.append(Path(result["output"]))
            logger.write(f"Wrote cross-corr NPZ: {result['output']}")
    else:
        logger.write(f"cross-corr parallel workers: {ncpu}")
        with ProcessPoolExecutor(max_workers=ncpu) as executor:
            futures = [executor.submit(cross_corr_worker, payload) for payload in payloads]
            for future in as_completed(futures):
                result = future.result()
                written += 1
                total_size += int(result.get("nbytes", 0))
                written_paths.append(Path(result["output"]))
                logger.write(f"Wrote cross-corr NPZ: {result['output']}")
    if cross_corr_write_matrix_summary(args, scans, antennas, output_base):
        summary = cross_corr_summary_path(output_base, mode, scan_label, applied_flag_version if args.use_flags else None)
        n_summary = write_cross_corr_summary_npz(summary, written_paths, gains_npz, mode, scan_label, args, applied_flag_version)
        summary_size = int(summary.stat().st_size) if summary.exists() else 0
        total_size += summary_size
        logger.write(f"Wrote cross-corr summary NPZ: {summary}")
        logger.write(f"cross-corr summary rows: {n_summary}")
    logger.write(f"cross-corr wrote {written} NPZ file(s).")
    logger.write(f"cross-corr total_disk_size={format_bytes(total_size)}")


def write_npz(path: Path, result: Dict[str, Any], array_name: str = "stats") -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    payload = {k: v for k, v in result.items() if k != "header"}
    np.savez_compressed(path, header_json=json.dumps(json_safe(result["header"]), indent=2, sort_keys=True), **payload)


def write_stats_csv(path: Path, result: Dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("w", newline="", encoding="utf-8") as f:
        writer = csv.writer(f)
        metrics = list(result["metrics"])
        writer.writerow(["scan", "antenna", "stokes", "component", "valid_count", "total_count", "flagged_count", *metrics])
        for si, scan in enumerate(result["scan_numbers"]):
            for ai, ant in enumerate(result["antennas"]):
                for pi, pol in enumerate(result["stokes"]):
                    for ci, comp in enumerate(result["components"]):
                        vals = result["stats"][si, ai, pi, ci, :]
                        writer.writerow([int(scan), int(ant), int(pol), str(comp), int(result["valid_count"][si, ai, pi, ci]), int(result["total_count"][si, ai, pi, ci]), int(result["flagged_count"][si, ai, pi, ci]), *[float(x) if np.isfinite(x) else "nan" for x in vals]])


def parse_args() -> argparse.Namespace:
    p = argparse.ArgumentParser(description="Compute GDP gain/bandpass products.")
    p.add_argument("--input-table", dest="input_table_opt", default=None, help="Input CASA gain/bandpass table path.")
    p.add_argument("--gain-table", default=None, help="Input gain table. Defaults to saved gdp-setup gain_table in gain mode.")
    p.add_argument("--bandpass-table", default=None, help="Input bandpass table. Defaults to saved gdp-setup bandpass_table in bandpass mode.")
    p.add_argument("--setup-file", default=None, help="Setup JSON file to use. Relative names are resolved under the active runtime directory.")
    p.add_argument("--relative-path", action="store_true", help="Print runtime-relative file references after reporting the runtime directory; file writes are unchanged.")
    p.add_argument("--mode", choices=["auto", "gain", "bandpass"], default="auto", help="Statistics mode. Default: auto.")
    p.add_argument("--scan", default=None, help="Comma-separated scans to process. Default: all scans.")
    p.add_argument("--combine-scans", action="store_true", help="Combine selected scans into one allscans-style product. Default: false, write one product per scan.")
    p.add_argument("--antennas", nargs="+", default=None, help="Antenna list, inclusive range, or mixed selection. Examples: --antennas [0-9] for antennas 0 through 9; --antennas 2,3,4,31 or --antennas 2 3 4 31 for explicit antenna IDs; --antennas \"[1-5]\" 6 \"[9-12]\" 15 16 19 for mixed ranges and single antennas. Default: all antennas.")
    p.add_argument("--use-flags", action="store_true", help="Apply the matching GDP .flg sidecar to flagged stats, KS, self-corr, or cross-corr products. Default: false.")
    p.add_argument("--flagver", default=None, help="Flag sidecar version. With --smode gains, write NAME_fV<version>.flg; if omitted, write the next version. With --use-flags consumers, use this version; if omitted, use the highest available version and add _fV<version> to default output product names.")
    p.add_argument(
        "--smode",
        default=None,
        help=(
            "Stats mode(s), comma or space separated: gains, stats, "
            "ks, self-corr, all, cross-corr."
        ),
    )
    p.add_argument("--output-npz", default=None, help="Stats NPZ path.")
    p.add_argument("--output-gains-npz", default=None, help="Gains NPZ path.")
    p.add_argument("--output-ks-npz", default=None, help="KS NPZ path.")
    p.add_argument("--output-self-corr-npz", default=None, help="Self-correlation NPZ path.")
    p.add_argument("--output-cross-corr-npz", default=None, help="Cross-correlation NPZ output directory, or an NPZ file path when exactly one cross-corr option is selected.")
    p.add_argument("--output-cross-corr-csv", default=None, help="Reserved for future cross-correlation CSV output.")
    p.add_argument("--dry-run", action="store_true", help="For cross-corr, list selected correlation jobs and output names without writing products.")
    p.add_argument("--estimate", action="store_true", help="For cross-corr, run a small sample and estimate full runtime and disk usage without writing final products.")
    p.add_argument("--estimate-count", type=int, default=3, help="Number of cross-corr options to sample for --estimate. Default: 3.")
    p.add_argument("--parallel", nargs="?", const=True, default=None, metavar="NCPU", help="Run cross-corr options in parallel. With no NCPU, use available CPU count minus 2. Default: serial.")
    p.add_argument("--stokes", nargs="+", default=None, help="Cross-corr stokes selector. Examples: --stokes 0, --stokes 1, --stokes 01, --stokes 0 01. Default: all stokes pairings.")
    p.add_argument("--complex", nargs="+", default=None, help="Cross-corr component selector. Examples: --complex re, --complex im, --complex reim, --complex re im reim. Default: all real/imag pairings.")
    p.add_argument("--corr-threshold", type=float, default=0.7, help="Normalized S2 threshold for self/cross correlation time or frequency extraction. Default: 0.7.")
    p.add_argument("--corr-nbin", type=int, default=32, help="Structure-function lag bin count.")
    p.add_argument("--corr-bintype", choices=["log", "lin"], default="log", help="Structure-function lag binning.")
    p.add_argument("--corr-njack", type=int, default=32, help="Jackknife folds for structure-function errors.")
    p.add_argument("--adjust-mean", action="store_true", help="For --smode gain/gains or stats, adjust selected samples by the all-antenna finite unflagged mean per Stokes before writing the product. Real gain samples are divided by the real mean; imaginary samples subtract the imaginary mean.")
    p.add_argument("--csv", action="store_true", help="Also write optional CSV products for selected subtasks that support CSV.")
    p.add_argument("--output-csv", default=None, help="Stats CSV path; implies --csv.")
    return p.parse_args()


def apply_smode(args: argparse.Namespace) -> None:
    args.gains = False
    args.stats = False
    args.ks = False
    args.self_corr = False
    args.cross_corr = False
    tasks = parse_smode(args.smode)
    for task in tasks:
        setattr(args, task, True)


def resolve_input(value: Optional[str], mode: str) -> Path:
    if value:
        return Path(value).expanduser().resolve()
    cfg = load_config()
    if mode == "bandpass":
        source = cfg.get("bandpass_table")
    else:
        source = cfg.get("gain_table")
    if source:
        return Path(str(source)).expanduser().resolve()
    raise SystemExit(
        "Input table is required. Pass --input-table, "
        "--gain-table for gain mode, --bandpass-table for bandpass mode, or run gdp-setup first."
    )


def explicit_outputs(args: argparse.Namespace) -> List[str]:
    names = [
        "output_npz",
        "output_gains_npz",
        "output_ks_npz",
        "output_self_corr_npz",
        "output_cross_corr_npz",
        "output_cross_corr_csv",
        "output_csv",
    ]
    return [name for name in names if getattr(args, name, None)]


def scan_batches(input_table: Path, scans: Optional[List[int]], combine_scans: bool) -> List[Tuple[Optional[List[int]], str]]:
    if combine_scans:
        return [(scans, "allscans" if scans is None else "scan" + "-".join(str(s) for s in scans))]
    selected = scans if scans is not None else available_scans(input_table)
    return [([int(scan)], f"scan{int(scan)}") for scan in selected]


def saved_gain_scan_batches(mode: str, scans: Optional[List[int]], combine_scans: bool) -> List[Tuple[Optional[List[int]], str]]:
    if combine_scans:
        label = "allscans" if scans is None else "scan" + "-".join(str(s) for s in scans)
        path = build_default_output(Path("saved"), label, mode, "gains", "npz")
        if not path.exists():
            raise SystemExit(
                "ERROR: saved gains NPZ is required before cross-corr can run.\n"
                f"Missing gains NPZ: {display_path(path)}\n"
                f"Run first: gdp-stats --mode {mode}{'' if scans is None else ' --scan ' + ','.join(str(s) for s in scans)} --combine-scans --smode gains"
            )
        return [(scans, label)]
    if scans is not None:
        return [([int(scan)], f"scan{int(scan)}") for scan in scans]
    pattern = f"gdp-gains-{mode}-scan*.npz"
    found: List[Tuple[int, str]] = []
    for path in default_output_dir("gains", "npz").glob(pattern):
        match = re.fullmatch(rf"gdp-gains-{re.escape(mode)}-scan(\d+)\.npz", path.name)
        if match:
            found.append((int(match.group(1)), f"scan{int(match.group(1))}"))
    if not found:
        raise SystemExit(
            "ERROR: no saved per-scan gains NPZ products were found for cross-corr.\n"
            f"Looked in: {display_path(default_output_dir('gains', 'npz'))}\n"
            f"Run first: gdp-stats --mode {mode} --scan <scan> --smode gains"
        )
    return [([scan], label) for scan, label in sorted(found)]


def run_batch(
    args: argparse.Namespace,
    input_table: Path,
    mode: str,
    scans: Optional[List[int]],
    antennas: Optional[List[int]],
    antenna_flags: Optional[List[int]],
    scan_label: str,
    logger: TaskLogger,
) -> None:
    logger.write(f"gdp-stats batch={scan_label}")
    if antenna_flags:
        logger.write("force-flag antennas: " + ",".join(str(ant) for ant in antenna_flags))
    stats_result: Optional[Dict[str, Any]] = None
    output_label = scan_label
    gains_out = Path(args.output_gains_npz).expanduser().resolve() if args.output_gains_npz else build_default_output(input_table, output_label, mode, "gains", "npz")
    flag_lookup: Optional[Dict[Tuple[int, int, int], bool]] = None
    flag_header: Dict[str, Any] = {}
    applied_flag_version: Optional[int] = None
    applied_flag_path: Optional[Path] = None
    needs_sidecar_flags = bool(args.use_flags and (args.stats or args.ks or args.self_corr or args.cross_corr))
    if needs_sidecar_flags:
        if args.flagver is None and not flag_file_versions(gains_out) and args.gains:
            logger.write("No existing flag file found; the gains step will create fV1 before flagged subtasks run.")
        else:
            try:
                version, flag_path = resolve_flag_file(gains_out, args.flagver)
            except SystemExit as exc:
                logger.write(str(exc))
                raise SystemExit(1) from exc
            flag_lookup, flag_header = load_flag_lookup(flag_path)
            applied_flag_version = int(version)
            applied_flag_path = flag_path
            logger.write(f"Using flag file fV{version}: {flag_path}")

    if args.gains:
        t0 = logger.start(f"gains {scan_label}")
        gains = compute_gains(input_table, mode, scans, antennas, antenna_flags, args.use_flags, args.adjust_mean, None, None, args.flag_chans, None)
        out = gains_out
        write_npz(out, gains)
        logger.write(f"Wrote gains NPZ: {out}")
        if not needs_sidecar_flags or flag_lookup is None:
            flag_version = args.flagver if args.flagver is not None else next_flag_version(out)
            flag_out = flag_file_for_npz(out, flag_version)
            write_flag_file(flag_out, gains, flag_version, str(out))
            logger.write(f"Wrote flag file fV{flag_version}: {flag_out}")
            if needs_sidecar_flags:
                flag_lookup, flag_header = load_flag_lookup(flag_out)
                applied_flag_version = int(flag_version)
                applied_flag_path = flag_out
                logger.write(f"Using flag file fV{flag_version}: {flag_out}")
        logger.done(f"gains {scan_label}", t0)

    if args.stats:
        t0 = logger.start(f"stats {scan_label}")
        stats_result = compute_stats(input_table, mode, scans, antennas, antenna_flags, args.use_flags, args.adjust_mean, None, None, args.flag_chans, flag_lookup)
        if flag_header:
            stats_result["header"]["flag_file_version"] = flag_header.get("flag_version")
        out = Path(args.output_npz).expanduser().resolve() if args.output_npz else path_with_flag_version(build_default_output(input_table, output_label, mode, "stats", "npz"), applied_flag_version)
        write_npz(out, stats_result)
        logger.write(f"Wrote stats NPZ: {out}")
        if args.csv or args.output_csv:
            csv_out = Path(args.output_csv).expanduser().resolve() if args.output_csv else path_with_flag_version(build_default_output(input_table, output_label, mode, "stats", "csv"), applied_flag_version)
            write_stats_csv(csv_out, stats_result)
            logger.write(f"Wrote stats CSV: {csv_out}")
        logger.done(f"stats {scan_label}", t0)

    if args.ks:
        t0 = logger.start(f"ks {scan_label}")
        ks = compute_ks(input_table, mode, scans, antennas, antenna_flags, args.use_flags, None, None, args.flag_chans, flag_lookup)
        if flag_header:
            ks["header"]["flag_file_version"] = flag_header.get("flag_version")
        out = Path(args.output_ks_npz).expanduser().resolve() if args.output_ks_npz else path_with_flag_version(build_default_output(input_table, output_label, mode, "ks", "npz"), applied_flag_version)
        write_npz(out, ks)
        logger.write(f"Wrote KS NPZ: {out}")
        logger.done(f"ks {scan_label}", t0)

    if args.self_corr:
        t0 = logger.start(f"self-corr {scan_label}")
        self_corr = compute_self_corr(
            input_table,
            mode,
            scans,
            antennas,
            antenna_flags,
            args.use_flags,
            None,
            None,
            args.flag_chans,
            args.corr_nbin,
            args.corr_bintype,
            args.corr_njack,
            args.corr_threshold,
            flag_lookup,
        )
        if flag_header:
            self_corr["header"]["flag_file_version"] = flag_header.get("flag_version")
        out = Path(args.output_self_corr_npz).expanduser().resolve() if args.output_self_corr_npz else path_with_flag_version(build_default_output(input_table, output_label, mode, "self_corr", "npz"), applied_flag_version)
        write_npz(out, self_corr)
        logger.write(f"Wrote self-corr NPZ: {out}")
        logger.done(f"self-corr {scan_label}", t0)

    if args.cross_corr:
        t0 = logger.start(f"cross-corr {scan_label}")
        cross_gains_npz = gains_out if args.gains else resolve_cross_corr_gains_npz(gains_out, mode, scan_label)
        run_cross_corr_from_npz(
            args,
            cross_gains_npz,
            input_table,
            mode,
            scans,
            antennas,
            scan_label,
            applied_flag_path,
            applied_flag_version,
            logger,
        )
        logger.done(f"cross-corr {scan_label}", t0)


def main() -> None:
    global RELATIVE_PATHS
    args = parse_args()
    activate_config(args.setup_file)
    RELATIVE_PATHS = bool(args.relative_path)
    apply_smode(args)
    args.flagver = parse_flag_version(args.flagver)
    mode = args.mode
    if mode == "auto":
        mode = "bandpass" if args.bandpass_table else "gain"
    explicit_input = args.input_table_opt
    mode_input = args.bandpass_table if mode == "bandpass" else args.gain_table
    input_table = resolve_input(explicit_input or mode_input, mode)
    if not input_table.exists():
        raise FileNotFoundError(f"Input table not found: {input_table}")
    scans = parse_int_list(args.scan)
    cross_corr_only = bool(args.cross_corr and not any([args.gains, args.stats, args.ks, args.self_corr]))
    if not cross_corr_only:
        validate_requested_scans(input_table, mode, scans)
    antennas = parse_antenna_list(args.antennas, "--antennas")
    antenna_flags = None
    args.flag_chans = None
    validate_channel_options_for_mode(mode, args)
    if not any([args.gains, args.stats, args.ks, args.self_corr, args.cross_corr]):
        args.stats = True
    logger = TaskLogger(default_log_path(input_table))
    if args.relative_path:
        logger.write(f"Runtime directory: {runtime_dir()}")
    logger.write(f"gdp-stats input={input_table} mode={mode}")
    batches = saved_gain_scan_batches(mode, scans, args.combine_scans) if cross_corr_only else scan_batches(input_table, scans, args.combine_scans)
    outputs = explicit_outputs(args)
    if (
        len(batches) > 1
        and args.cross_corr
        and args.output_cross_corr_npz
        and Path(args.output_cross_corr_npz).expanduser().suffix != ".npz"
    ):
        outputs = [name for name in outputs if name != "output_cross_corr_npz"]
    if len(batches) > 1 and outputs:
        names = ", ".join("--" + name.replace("_", "-") for name in outputs)
        raise SystemExit(
            "Explicit output paths cannot be used when writing multiple per-scan products. "
            f"Use --combine-scans or remove: {names}"
        )
    for batch_scans, batch_label in batches:
        run_batch(args, input_table, mode, batch_scans, antennas, antenna_flags, batch_label, logger)
    logger.write(f"Log file: {logger.path}")


if __name__ == "__main__":
    main()
