#!/usr/bin/env python3
"""Initialize and remember a GDP runtime environment."""

from __future__ import annotations

import argparse
import json
import os
import shutil
from pathlib import Path
from typing import Dict, List
from datetime import datetime


CONFIG_NAME = ".gdp-config.json"
DEFAULT_SETUP_FILE_NAME = "gdp-setup.json"
RUNDIR_SUBDIRS = [
    "data-product",
    "data-product/gains",
    "data-product/gains/npz",
    "data-product/gains/csv",
    "data-product/stats",
    "data-product/stats/npz",
    "data-product/stats/csv",
    "data-product/ks",
    "data-product/ks/npz",
    "data-product/ks/csv",
    "data-product/self-corr",
    "data-product/self-corr/npz",
    "data-product/cross-corr",
    "data-product/cross-corr/npz",
    "data-product/cross-corr/csv",
    "data-product/flag",
    "data-product/flag/npz",
    "data-product/flag/csv",
    "logs",
    "gaintable",
    "plots",
    "plots/png",
    "plots/eps",
    "plots/pdf",
]
CLEAN_RUNTIME_DIRS = [
    "data-product",
    "plots",
    "logs",
    "gaintable",
]


def project_root() -> Path:
    return Path(__file__).resolve().parents[1]


def default_config_path() -> Path:
    return project_root() / CONFIG_NAME


def load_config(path: Path) -> Dict[str, object]:
    if not path.exists():
        return {}
    with path.open("r", encoding="utf-8") as f:
        return json.load(f)


def write_config(path: Path, data: Dict[str, object]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + ".tmp")
    with tmp.open("w", encoding="utf-8") as f:
        json.dump(data, f, indent=2, sort_keys=True)
        f.write("\n")
    tmp.replace(path)


def resolve_setup_file(rundir: Path, value: object | None) -> Path:
    name = str(value or DEFAULT_SETUP_FILE_NAME).strip()
    if not name:
        name = DEFAULT_SETUP_FILE_NAME
    path = Path(name).expanduser()
    if path.is_absolute():
        path = Path(path.name)
    resolved = (rundir / path).resolve()
    try:
        resolved.relative_to(rundir)
    except ValueError as exc:
        raise ValueError(f"--setup-file must stay inside the runtime directory: {name}") from exc
    return resolved


def archive_default_setup_file(path: Path, dry_run: bool = False) -> Path | None:
    if path.name != DEFAULT_SETUP_FILE_NAME or not path.exists():
        return None
    stamp = datetime.now().strftime("%Y%m%dT%H%M%S")
    archive = path.with_name(f"{path.name}.{stamp}")
    counter = 1
    while archive.exists():
        archive = path.with_name(f"{path.name}.{stamp}.{counter}")
        counter += 1
    if not dry_run:
        shutil.move(str(path), str(archive))
    return archive


def build_paths(rundir: Path) -> Dict[str, str]:
    return {
        "rundir": str(rundir),
        "data_product_dir": str(rundir / "data-product"),
        "gains_npz_dir": str(rundir / "data-product" / "gains" / "npz"),
        "gains_csv_dir": str(rundir / "data-product" / "gains" / "csv"),
        "stats_npz_dir": str(rundir / "data-product" / "stats" / "npz"),
        "stats_csv_dir": str(rundir / "data-product" / "stats" / "csv"),
        "ks_npz_dir": str(rundir / "data-product" / "ks" / "npz"),
        "ks_csv_dir": str(rundir / "data-product" / "ks" / "csv"),
        "self_corr_npz_dir": str(rundir / "data-product" / "self-corr" / "npz"),
        "cross_corr_npz_dir": str(rundir / "data-product" / "cross-corr" / "npz"),
        "cross_corr_csv_dir": str(rundir / "data-product" / "cross-corr" / "csv"),
        "flag_npz_dir": str(rundir / "data-product" / "flag" / "npz"),
        "flag_csv_dir": str(rundir / "data-product" / "flag" / "csv"),
        "logs_dir": str(rundir / "logs"),
        "gaintable_dir": str(rundir / "gaintable"),
        "plots_dir": str(rundir / "plots"),
        "plots_png_dir": str(rundir / "plots" / "png"),
        "plots_eps_dir": str(rundir / "plots" / "eps"),
        "plots_pdf_dir": str(rundir / "plots" / "pdf"),
    }


def ensure_rundir(rundir: Path, dry_run: bool = False) -> List[str]:
    created: List[str] = []
    for rel in [""] + RUNDIR_SUBDIRS:
        path = rundir / rel if rel else rundir
        if not path.exists():
            created.append(str(path))
            if not dry_run:
                path.mkdir(parents=True, exist_ok=True)
        elif not path.is_dir():
            raise NotADirectoryError(f"Path exists but is not a directory: {path}")
    return created


def assert_inside(parent: Path, child: Path) -> None:
    try:
        child.resolve().relative_to(parent.resolve())
    except ValueError as exc:
        raise ValueError(f"Refusing to clean path outside runtime directory: {child}") from exc


def clean_runtime_products(rundir: Path, dry_run: bool = False) -> List[str]:
    removed: List[str] = []
    for rel in CLEAN_RUNTIME_DIRS:
        root = (rundir / rel).resolve()
        assert_inside(rundir, root)
        if not root.exists():
            continue
        if not root.is_dir():
            raise NotADirectoryError(f"Runtime cleanup target is not a directory: {root}")
        for child in sorted(root.iterdir(), key=lambda item: str(item)):
            assert_inside(rundir, child)
            removed.append(str(child))
            if dry_run:
                continue
            if child.is_dir() and not child.is_symlink():
                shutil.rmtree(child)
            else:
                child.unlink()
    return removed


def clean_without_prompt(clean_value: object) -> bool:
    if clean_value in (None, False):
        return False
    if clean_value in (True, "prompt"):
        return False
    if str(clean_value).strip().lower() == "no-stop":
        return True
    raise SystemExit("--clean accepts only the optional value 'no-stop'.")


def confirm_clean(rundir: Path, removed: List[str]) -> bool:
    print(f"Clean GDP runtime outputs under: {rundir}")
    if removed:
        print("This will permanently remove:")
        for item in removed:
            print(f"  {item}")
    else:
        print("No GDP runtime outputs found to remove.")
        return True
    answer = input("Type 'yes' to continue: ").strip().lower()
    return answer == "yes"


def parse_args() -> argparse.Namespace:
    p = argparse.ArgumentParser(
        description=(
            "Set up the GDP runtime directory and remember default gain and "
            "bandpass tables for other GDP commands."
        )
    )
    p.add_argument(
        "--rundir",
        default=None,
        help="Runtime directory to create/use. Default: existing config value, else <GDP>/rundir.",
    )
    p.add_argument(
        "--gain-table",
        default=None,
        help="CASA gain calibration table to remember as the default gain-mode input.",
    )
    p.add_argument(
        "--bandpass-table",
        default=None,
        help="CASA bandpass calibration table to remember as the default bandpass-mode input.",
    )
    p.add_argument(
        "--source-data",
        default=None,
        help=argparse.SUPPRESS,
    )
    p.add_argument(
        "--gain-dir",
        default=None,
        help=argparse.SUPPRESS,
    )
    p.add_argument(
        "--config",
        default=None,
        help="Active configuration JSON path. Default: <GDP>/.gdp-config.json.",
    )
    p.add_argument(
        "--setup-file",
        default=None,
        help=(
            "Setup JSON file name to store inside the runtime directory. "
            f"Default: {DEFAULT_SETUP_FILE_NAME}."
        ),
    )
    p.add_argument(
        "--show",
        action="store_true",
        help="Show the current saved configuration and exit.",
    )
    p.add_argument(
        "--clean",
        nargs="?",
        const="prompt",
        default=None,
        metavar="no-stop",
        help=(
            "Delete GDP-generated runtime outputs under data-product/, plots/, "
            "logs/, and gaintable/, then recreate the standard runtime folders. "
            "Prompts before deletion unless used as '--clean no-stop'."
        ),
    )
    p.add_argument(
        "--dry-run",
        action="store_true",
        help="Print what would be created/written without changing files.",
    )
    p.add_argument(
        "--allow-missing-source",
        action="store_true",
        help=argparse.SUPPRESS,
    )
    p.add_argument(
        "--allow-missing-table",
        action="store_true",
        help="Allow gain or bandpass table paths to be recorded before they exist.",
    )
    return p.parse_args()


def resolve_optional_path(value: object) -> Path | None:
    if value in (None, ""):
        return None
    return Path(str(value)).expanduser().resolve()


def validate_existing_path(path: Path, label: str, allow_missing: bool) -> None:
    if not path.exists() and not allow_missing:
        raise FileNotFoundError(
            f"{label} does not exist: {path}\n"
            "Use --allow-missing-table if this path will be created later."
        )


def main() -> None:
    args = parse_args()
    cfg_path = Path(args.config).expanduser().resolve() if args.config else default_config_path()
    old = load_config(cfg_path)

    if args.show:
        print(json.dumps(old, indent=2, sort_keys=True))
        return

    rundir = Path(
        args.rundir
        or old.get("rundir")
        or (project_root() / "rundir")
    ).expanduser().resolve()
    setup_file = resolve_setup_file(rundir, args.setup_file)

    if args.clean is not None:
        no_stop = clean_without_prompt(args.clean)
        removed = clean_runtime_products(rundir, dry_run=True)
        if args.dry_run:
            created = ensure_rundir(rundir, dry_run=True)
            print(f"Would clean GDP runtime outputs under: {rundir}")
            if removed:
                print("Would remove:")
                for item in removed:
                    print(f"  {item}")
            else:
                print("No GDP runtime outputs found to remove.")
            if created:
                print("Would recreate directories:")
                for item in created:
                    print(f"  {item}")
            return
        if not no_stop and not confirm_clean(rundir, removed):
            print("Clean cancelled.")
            return
        removed = clean_runtime_products(rundir, dry_run=False)
        created = ensure_rundir(rundir, dry_run=args.dry_run)
        print(f"Cleaned GDP runtime outputs under: {rundir}")
        if removed:
            print("Removed:")
            for item in removed:
                print(f"  {item}")
        else:
            print("No GDP runtime outputs found to remove.")
        if created:
            print("Recreated directories:")
            for item in created:
                print(f"  {item}")
        return

    allow_missing = args.allow_missing_table or args.allow_missing_source
    gain_table = resolve_optional_path(args.gain_table or args.gain_dir or old.get("gain_table"))
    bandpass_table = resolve_optional_path(args.bandpass_table or old.get("bandpass_table"))

    if gain_table is None and bandpass_table is None:
        raise SystemExit(
            "At least one input location is required for first setup. "
            "Pass --gain-table and/or --bandpass-table."
        )
    if gain_table is not None and (args.gain_table or args.gain_dir):
        validate_existing_path(gain_table, "Gain table path", allow_missing)
    if bandpass_table is not None and args.bandpass_table:
        validate_existing_path(bandpass_table, "Bandpass table path", allow_missing)

    created = ensure_rundir(rundir, dry_run=args.dry_run)
    paths = build_paths(rundir)
    config: Dict[str, object] = {
        "project_root": str(project_root()),
        "config_file": str(cfg_path),
        "setup_file": str(setup_file),
        "setup_file_name": str(setup_file.relative_to(rundir)),
        "paths": paths,
        **paths,
    }
    if gain_table is not None:
        config["gain_table"] = str(gain_table)
    if bandpass_table is not None:
        config["bandpass_table"] = str(bandpass_table)

    if args.dry_run:
        archived = archive_default_setup_file(setup_file, dry_run=True)
        print("Would create directories:")
        for item in created:
            print(f"  {item}")
        if archived is not None:
            print(f"\nWould archive default setup file:\n  {setup_file} -> {archived}")
        print("\nWould write configuration:")
        print(f"  setup file:  {setup_file}")
        print(f"  active file: {cfg_path}")
        print(json.dumps(config, indent=2, sort_keys=True))
        return

    archived = archive_default_setup_file(setup_file)
    write_config(setup_file, config)
    write_config(cfg_path, config)
    print(f"GDP setup file written: {setup_file}")
    print(f"GDP active configuration written: {cfg_path}")
    if archived is not None:
        print(f"Previous default setup file archived: {archived}")
    print(f"Runtime directory: {rundir}")
    if gain_table is not None:
        print(f"Gain table:        {gain_table}")
    if bandpass_table is not None:
        print(f"Bandpass table:    {bandpass_table}")
    if created:
        print("Created directories:")
        for item in created:
            print(f"  {item}")
    else:
        print("Runtime directory structure already existed.")


if __name__ == "__main__":
    main()
