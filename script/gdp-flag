PLACEHOLDER_FMODES = {"auto_ante", "auto_chan"}


def project_root() -> Path:
    return Path(__file__).resolve().parents[1]


def load_gdp_stats_module() -> Any:
    path = project_root() / "script" / "gdp-stats"
    return SourceFileLoader("gdp_stats_impl", str(path)).load_module()


GSTATS = load_gdp_stats_module()


def load_project_config() -> Dict[str, Any]:
    path = project_root() / CONFIG_NAME
    if not path.exists():
        return {}
    with path.open("r", encoding="utf-8") as f:
        return json.load(f)


def resolve_setup_file_path(setup_file: Optional[str], base_config: Dict[str, Any]) -> Optional[Path]:
    if setup_file:
        path = Path(setup_file).expanduser()
        if path.is_absolute():
            return path.resolve()
        rundir = Path(str(base_config.get("rundir") or (project_root() / "rundir"))).expanduser().resolve()
        return (rundir / path).resolve()
    configured = base_config.get("setup_file")
    return Path(str(configured)).expanduser().resolve() if configured else None


def activate_config(setup_file: Optional[str] = None) -> Dict[str, Any]:
    base = load_project_config()
    setup_path = resolve_setup_file_path(setup_file, base)
    if setup_path and setup_path.exists():
        with setup_path.open("r", encoding="utf-8") as f:
            config = json.load(f)
    else:
        if setup_file:
            raise FileNotFoundError(f"Setup file not found: {setup_path}")
        config = base
    GSTATS.ACTIVE_CONFIG = config
    return config


def runtime_dir() -> Path:
    cfg = GSTATS.load_config()
    return Path(str(cfg.get("rundir") or (project_root() / "rundir"))).expanduser().resolve()


def format_path_text(text: object) -> str:
    value = str(text)
    if not RELATIVE_PATHS:
        return value
    prefix = str(runtime_dir()) + "/"
    return value.replace(prefix, "")


def display_path(path: object) -> str:
    return format_path_text(path)


def parse_flag_version(value: Optional[str], option_name: str = "--out-fver") -> Optional[int]:
    if value is None or str(value).strip().lower() == "highest":
        return None
    text = str(value).strip()
    lower = text.lower()
    if lower.startswith("fv"):
        text = text[2:]
    elif lower.startswith("v"):
        text = text[1:]
    if not text.isdigit() or int(text) < 1:
        raise SystemExit(f"{option_name} must be a positive integer version number.")
    return int(text)


def normalize_version_token(text: str, option_name: str) -> int:
    value = str(text).strip()
    lower = value.lower()
    if lower.startswith("fv"):
        value = value[2:]
    elif lower.startswith("v"):
        value = value[1:]
    if not value.isdigit() or int(value) < 1:
        raise SystemExit(
            f"{option_name} must be a positive integer version number, "
            "a closed range like [1-3], or an open range like [1:]."
        )
    return int(value)


def parse_remove_version_request(value: Optional[str]) -> Optional[Tuple[str, Any]]:
    if value is None or str(value).strip() == "":
        return None
    text = str(value).strip()
    bracketed = (
        (text.startswith("[") and text.endswith("]"))
        or (text.startswith("(") and text.endswith(")"))
    )
    if bracketed:
        inner = text[1:-1].strip()
        if ":" in inner:
            start_text, end_text = inner.split(":", 1)
            start_text = start_text.strip()
            end_text = end_text.strip()
            if not start_text or end_text:
                raise SystemExit(
                    "remove-version open ranges must be written like [1:] or (1:)."
                )
            return ("open", normalize_version_token(start_text, "remove-version"))
        if "-" in inner:
            start_text, end_text = inner.split("-", 1)
            start = normalize_version_token(start_text.strip(), "remove-version")
            end = normalize_version_token(end_text.strip(), "remove-version")
            if end < start:
                raise SystemExit("remove-version closed ranges must satisfy end >= start.")
            return ("closed", (start, end))
    return ("single", parse_flag_version(text, "remove-version"))


def parse_fmode(text: Optional[str]) -> str:
    key = "casa" if text is None or str(text).strip() == "" else str(text).strip()
    if key not in FMODE_ALIASES:
        valid = ", ".join(
            [
                "casa-flags",
                "man-antenna",
                "man-chan",
                "all-std-thrsld",
                "ante-std-thrsld",
                "ante-mean-thrsld",
                "ante-thrsld",
                "ks-thrsld",
                "auto-ante",
                "auto-chan",
                "remove-version",
                "summary",
            ]
        )
        raise SystemExit(f"Unknown fmode '{key}'. Valid modes: {valid}")
    return FMODE_ALIASES[key]


def normalize_list_text(text: object) -> str:
    if isinstance(text, (list, tuple)):
        return " ".join(str(item) for item in text)
    return str(text)


def parse_int_selection(text: object, option_name: str) -> Optional[List[int]]:
    return GSTATS.parse_antenna_list(text, option_name)


def split_manual_tokens(text: object) -> List[str]:
    value = normalize_list_text(text).strip()
    tokens: List[str] = []
    current: List[str] = []
    depth = 0
    for char in value:
        if char in "([":
            depth += 1
            current.append(char)
        elif char in ")]":
            depth = max(0, depth - 1)
            current.append(char)
        elif depth == 0 and char in {",", " ", "\t", "\n"}:
            token = "".join(current).strip()
            if token:
                tokens.append(token)
            current = []
        else:
            current.append(char)
    token = "".join(current).strip()
    if token:
        tokens.append(token)
    return tokens


def split_top_level_colon(token: str, option_name: str) -> Tuple[str, Optional[str]]:
    depth = 0
    for idx, char in enumerate(token):
        if char in "([":
            depth += 1
        elif char in ")]":
            depth = max(0, depth - 1)
        elif char == ":" and depth == 0:
            left = token[:idx].strip()
            right = token[idx + 1 :].strip()
            if not left or not right:
                raise SystemExit(f"{option_name} stokes form must be TARGET:STOKES, for example {option_name} 1:0")
            return left, right
    return token.strip(), None


def parse_manual_int_values(text: str, option_name: str) -> List[int]:
    value = text.strip()
    square_group = value.startswith("[") and value.endswith("]")
    if (value.startswith("(") and value.endswith(")")) or square_group:
        value = value[1:-1].strip()
    if not value:
        raise SystemExit(f"{option_name} contains an empty selection.")
    if square_group and "," in value and "-" not in value:
        parts = [item.strip() for item in value.split(",") if item.strip()]
        if len(parts) == 2:
            start, end = int(parts[0]), int(parts[1])
            step = 1 if end >= start else -1
            return list(range(start, end + step, step))
    values: List[int] = []
    for part in [item.strip() for item in value.split(",") if item.strip()]:
        if "-" in part and not part.startswith("-"):
            ends = [item.strip() for item in part.split("-", 1) if item.strip()]
            if len(ends) != 2:
                raise SystemExit(f"{option_name} range form must be two numbers, for example {option_name} [1-4]:0")
            start, end = int(ends[0]), int(ends[1])
            step = 1 if end >= start else -1
            values.extend(range(start, end + step, step))
        else:
            values.append(int(part))
    return sorted(set(values))


def parse_manual_selection(text: object, option_name: str) -> Optional[List[Tuple[List[int], Optional[List[int]]]]]:
    if text is None or normalize_list_text(text).strip() == "":
        return None
    selections: List[Tuple[List[int], Optional[List[int]]]] = []
    for token in split_manual_tokens(text):
        target_text, stokes_text = split_top_level_colon(token, option_name)
        targets = parse_manual_int_values(target_text, option_name)
        stokes = parse_manual_int_values(stokes_text, f"{option_name} stokes") if stokes_text is not None else None
        selections.append((targets, stokes))
    return selections


def parse_positive_float(value: Optional[str], option_name: str, default: float = 1.0) -> float:
    if value is None or str(value).strip() == "":
        return float(default)
    try:
        parsed = float(str(value).strip())
    except ValueError as exc:
        raise SystemExit(f"{option_name} must be a positive numeric value.") from exc
    if not np.isfinite(parsed) or parsed <= 0.0:
        raise SystemExit(f"{option_name} must be a positive numeric value.")
    return parsed


def parse_percent_value(value: Optional[str], option_name: str, default: float = 70.0) -> float:
    if value is None or str(value).strip() == "":
        return float(default)
    try:
        parsed = float(str(value).strip())
    except ValueError as exc:
        raise SystemExit(f"{option_name} must be a numeric percentage from 0 to 100.") from exc
    if not np.isfinite(parsed) or parsed < 0.0 or parsed > 100.0:
        raise SystemExit(f"{option_name} must be a numeric percentage from 0 to 100.")
    return parsed


def parse_threshold_factor(value: Optional[str], option_name: str, default: float = 1.0) -> float:
    return parse_positive_float(value, option_name, default)


def parse_scan_list(text: Optional[str]) -> Optional[List[int]]:
    return GSTATS.parse_int_list(text)


def flag_file_for_npz(npz_path: Path, version: int) -> Path:
    return GSTATS.flag_file_for_npz(npz_path, int(version))


def flag_file_versions(npz_path: Path) -> List[Tuple[int, Path]]:
    return GSTATS.flag_file_versions(npz_path)


def resolve_input(value: Optional[str], mode: str) -> Path:
    return GSTATS.resolve_input(value, mode)


def infer_mode(args: argparse.Namespace) -> str:
    mode = args.mode
    if mode != "auto":
        return mode
    if getattr(args, "fmode_resolved", None) == "man_chan":
        return "bandpass"
    if args.bandpass_table or args.bchan is not None or args.echan is not None or args.man_chan:
        return "bandpass"
    return "gain"


def build_gains_output(input_table: Path, scan_label: str, mode: str, args: argparse.Namespace) -> Path:
    return Path(args.output_gains_npz).expanduser().resolve() if args.output_gains_npz else GSTATS.build_default_output(
        input_table, scan_label, mode, "gains", "npz"
    )


def default_gaintable_dir() -> Path:
    path = GSTATS.config_path("gaintable_dir")
    if path is not None:
        return Path(path)
    return project_root() / "rundir" / "gaintable"


def default_output_table_path(input_table: Path, version: int) -> Path:
    out_dir = default_gaintable_dir()
    suffix = input_table.suffix
    stem = input_table.name[:-len(suffix)] if suffix else input_table.name
    return out_dir / f"{stem}_fV{int(version)}{suffix}"


def copy_table_tree(source: Path, destination: Path) -> None:
    if source.resolve() == destination.resolve():
        raise SystemExit("--output-table must be different from the input CASA table path.")
    destination.parent.mkdir(parents=True, exist_ok=True)
    if destination.exists():
        if destination.is_dir():
            shutil.rmtree(destination)
        else:
            destination.unlink()
    if source.is_dir():
        shutil.copytree(source, destination)
    else:
        shutil.copy2(source, destination)


def open_casa_table(tb: Any, path: Path, writable: bool = False) -> None:
    if writable:
        try:
            tb.open(str(path), nomodify=False)
            return
        except TypeError:
            pass
    tb.open(str(path))


def restore_flag_storage_shape(
    full_flag: np.ndarray,
    raw_template: np.ndarray,
    data_shape: Sequence[int],
    data_ch0: int = 0,
    flag_chans: Optional[Tuple[int, int]] = None,
) -> np.ndarray:
    raw = np.asarray(raw_template, dtype=bool)
    full = np.asarray(full_flag, dtype=bool)
    if raw.shape == tuple(data_shape):
        return full.astype(bool, copy=True)
    if raw.ndim == 2 and len(data_shape) == 3:
        npol, _, nrow = data_shape
        if raw.shape == (npol, nrow):
            return np.any(full, axis=1).astype(bool, copy=True)
    if raw.ndim == 3 and len(data_shape) == 3:
        npol, nchan, nrow = data_shape
        if raw.shape[0] == npol and raw.shape[2] == nrow:
            flag_nchan = int(raw.shape[1])
            if flag_chans is None:
                f0, f1 = int(data_ch0), int(data_ch0) + flag_nchan
            else:
                f0, f1 = int(flag_chans[0]), int(flag_chans[1])
            out = np.ones(raw.shape, dtype=bool)
            data_ch1 = int(data_ch0) + nchan
            overlap0 = max(int(data_ch0), f0)
            overlap1 = min(data_ch1, f1)
            if overlap1 > overlap0:
                src0 = overlap0 - int(data_ch0)
                src1 = overlap1 - int(data_ch0)
                dst0 = overlap0 - f0
                dst1 = overlap1 - f0
                out[:, dst0:dst1, :] = full[:, src0:src1, :]
            return out
    raise ValueError(
        f"Cannot restore FLAG storage shape {raw.shape} from normalized shape {tuple(full.shape)}."
    )


def write_npz_exact_suffix(path: Path, payload: Dict[str, Any]) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("wb") as handle:
        np.savez_compressed(handle, **payload)


def json_safe(value: Any) -> Any:
    return GSTATS.json_safe(value)


def load_flag_file(flag_path: Path, gains: Dict[str, Any]) -> Tuple[np.ndarray, Dict[str, Any]]:
    lookup, header = GSTATS.load_flag_lookup(flag_path)
    rows = np.asarray(gains["row"], dtype=int)
    stokes = np.asarray(gains["stokes"], dtype=int)
    channels = np.asarray(gains["channel"], dtype=int)
    flags = np.asarray(
        [lookup.get((int(row), int(pol), int(chan)), False) for row, pol, chan in zip(rows, stokes, channels)],
        dtype=bool,
    )
    return flags, header


def write_flag_intent_metadata(
    tb: Any,
    flag_version: int,
    flag_path: Path,
    header: Dict[str, Any],
) -> None:
    intents = normalize_flag_intents(header.get("flag-intent"))
    if hasattr(tb, "putkeyword"):
        for key, value in {
            "GDP_FLAG_VERSION": int(flag_version),
            "GDP_FLAG_FILE": str(flag_path),
            "GDP_FLAG_INTENT": intents,
            "GDP_FLAG_METADATA": json_safe(
                {
                    "flag_version": int(flag_version),
                    "flag_file": str(flag_path),
                    "flag_intent": intents,
                    "flag_created_utc": header.get("created_utc"),
                }
            ),
        }.items():
            try:
                tb.putkeyword(key, value)
            except Exception:
                pass
    if hasattr(tb, "addreadmeline"):
        try:
            tb.addreadmeline(f"GDP flag version applied: fV{int(flag_version)}")
            tb.addreadmeline(f"GDP flag source file: {flag_path}")
            for intent in intents:
                tb.addreadmeline(f"GDP flag intent: {intent}")
        except Exception:
            pass


def stokes_selection_mask(gains: Dict[str, Any], stokes: Optional[Sequence[int]]) -> np.ndarray:
    if stokes is None:
        return np.ones(np.asarray(gains["stokes"]).shape, dtype=bool)
    return np.isin(np.asarray(gains["stokes"], dtype=int), sorted({int(pol) for pol in stokes}))


def manual_antenna_mask(gains: Dict[str, Any], selections: Optional[Sequence[Tuple[Sequence[int], Optional[Sequence[int]]]]]) -> np.ndarray:
    mask = np.zeros(np.asarray(gains["antenna"]).shape, dtype=bool)
    antenna_values = np.asarray(gains["antenna"], dtype=int)
    for antennas, stokes in selections or []:
        selected = {int(ant) for ant in antennas or []}
        if selected:
            mask |= np.isin(antenna_values, sorted(selected)) & stokes_selection_mask(gains, stokes)
    return mask


def manual_channel_mask(gains: Dict[str, Any], selections: Optional[Sequence[Tuple[Sequence[int], Optional[Sequence[int]]]]]) -> np.ndarray:
    mask = np.zeros(np.asarray(gains["channel"]).shape, dtype=bool)
    channel_values = np.asarray(gains["channel"], dtype=int)
    for channels, stokes in selections or []:
        selected = {int(chan) for chan in channels or []}
        if selected:
            mask |= np.isin(channel_values, sorted(selected)) & stokes_selection_mask(gains, stokes)
    return mask


def std_threshold_mask(
    gains: Dict[str, Any],
    alpha: float,
    exclude_flags: Optional[np.ndarray],
    logger: TaskLogger,
    *,
    per_antenna: bool,
    fmode_label: str,
) -> Tuple[np.ndarray, List[str]]:
    real_values = (np.asarray(gains["real"], dtype=float) - 1.0) * 100.0
    imag_values = np.asarray(gains["imag"], dtype=float) * 100.0
    stokes_values = np.asarray(gains["stokes"], dtype=int)
    antenna_values = np.asarray(gains["antenna"], dtype=int)
    exclude = np.asarray(exclude_flags, dtype=bool) if exclude_flags is not None else np.zeros(real_values.shape, dtype=bool)
    mask = np.zeros(real_values.shape, dtype=bool)
    intent_parts: List[str] = [f"alpha={alpha:g}"]

    groups: List[Tuple[Optional[int], int]] = []
    if per_antenna:
        for antenna in sorted(int(ant) for ant in np.unique(antenna_values)):
            for stokes in sorted(int(pol) for pol in np.unique(stokes_values[antenna_values == antenna])):
                groups.append((antenna, stokes))
    else:
        groups = [(None, int(pol)) for pol in sorted(int(pol) for pol in np.unique(stokes_values))]

    for antenna, stokes in groups:
        group_selector = stokes_values == stokes
        group_text = f"stokes={stokes}"
        intent_group = f"stokes {stokes}"
        if antenna is not None:
            group_selector &= antenna_values == antenna
            group_text = f"antenna={antenna} stokes={stokes}"
            intent_group = f"antenna {antenna} stokes {stokes}"
        base = group_selector & ~exclude
        finite = base & np.isfinite(real_values) & np.isfinite(imag_values)
        npoint = int(np.count_nonzero(finite))
        if npoint < 2:
            logger.write(f"{fmode_label} {group_text}: skipped; finite_unflagged_samples={npoint}")
            intent_parts.append(f"{intent_group}: skipped n={npoint}")
            continue
        x = real_values[finite]
        y = imag_values[finite]
        xstd = float(np.nanstd(x))
        ystd = float(np.nanstd(y))
        if not all(np.isfinite(v) for v in (xstd, ystd)) or xstd <= 0.0 or ystd <= 0.0:
            logger.write(
                f"{fmode_label} {group_text}: skipped; invalid mean/std "
                f"real_std={xstd:.6g} imag_std={ystd:.6g}"
            )
            intent_parts.append(f"{intent_group}: skipped invalid mean/std n={npoint}")
            continue
        radius = math.sqrt(2.0 * math.log(float(npoint)))
        threshold = alpha * radius
        distance = np.full(real_values.shape, np.nan, dtype=float)
        distance[finite] = np.sqrt((real_values[finite] / xstd) ** 2 + (imag_values[finite] / ystd) ** 2)
        stokes_new = finite & (distance > threshold)
        mask |= stokes_new
        new_count = int(np.count_nonzero(stokes_new))
        pct = 100.0 * new_count / npoint if npoint else 0.0
        logger.write(
            f"{fmode_label} "
            f"{group_text} alpha={alpha:g} n={npoint} "
            f"real_std={xstd:.3f}% "
            f"imag_std={ystd:.3f}% "
            f"R={radius:.3f} threshold={threshold:.3f} "
            f"new_flags={new_count}/{npoint} ({pct:.2f}%)"
        )
        intent_parts.append(
            f"{intent_group}: n={npoint} std_real={xstd:.6g}% "
            f"std_imag={ystd:.6g}% R={radius:.6g} "
            f"alpha={alpha:g} new_flags={new_count}"
        )

    total = int(np.count_nonzero(~exclude & np.isfinite(real_values) & np.isfinite(imag_values)))
    total_new = int(np.count_nonzero(mask))
    pct_total = 100.0 * total_new / total if total else 0.0
    logger.write(f"{fmode_label} total_new_flags={total_new}/{total} ({pct_total:.2f}%)")
    return mask, intent_parts


def antenna_mean_threshold_mask(
    gains: Dict[str, Any],
    alpha: float,
    exclude_flags: Optional[np.ndarray],
    logger: TaskLogger,
) -> Tuple[np.ndarray, List[str]]:
    real_values = (np.asarray(gains["real"], dtype=float) - 1.0) * 100.0
    imag_values = np.asarray(gains["imag"], dtype=float) * 100.0
    stokes_values = np.asarray(gains["stokes"], dtype=int)
    antenna_values = np.asarray(gains["antenna"], dtype=int)
    exclude = np.asarray(exclude_flags, dtype=bool) if exclude_flags is not None else np.zeros(real_values.shape, dtype=bool)
    mask = np.zeros(real_values.shape, dtype=bool)
    intent_parts: List[str] = [f"threshold={alpha:g}", "cutoff=threshold_times_gamma_times_std_of_antenna_means"]

    for stokes in sorted(int(pol) for pol in np.unique(stokes_values)):
        antenna_stats: List[Tuple[int, int, float, float]] = []
        for antenna in sorted(int(ant) for ant in np.unique(antenna_values[stokes_values == stokes])):
            group_selector = (stokes_values == stokes) & (antenna_values == antenna)
            finite = group_selector & ~exclude & np.isfinite(real_values) & np.isfinite(imag_values)
            npoint = int(np.count_nonzero(finite))
            if npoint < 1:
                logger.write(f"ante-mean-thrsld antenna={antenna} stokes={stokes}: skipped; finite_unflagged_samples={npoint}")
                continue
            mean_real = float(np.nanmean(real_values[finite]))
            mean_imag = float(np.nanmean(imag_values[finite]))
            if not all(np.isfinite(v) for v in (mean_real, mean_imag)):
                logger.write(
                    f"ante-mean-thrsld antenna={antenna} stokes={stokes}: skipped; invalid mean "
                    f"mean_real={mean_real:.6g} mean_imag={mean_imag:.6g}"
                )
                continue
            antenna_stats.append((antenna, npoint, mean_real, mean_imag))

        nant = len(antenna_stats)
        antenna_text = format_int_values([antenna for antenna, _, _, _ in antenna_stats])
        if nant <= 7:
            logger.write(
                f"ante-mean-thrsld stokes={stokes}: skipped; insufficient number of antennas "
                f"valid_antennas={nant} antennas={antenna_text}; valid_antennas should be >7"
            )
            intent_parts.append(
                f"stokes {stokes}: skipped insufficient number of antennas "
                f"valid_antennas={nant} antennas={antenna_text}; valid_antennas should be >7"
            )
            continue

        means_real = np.asarray([mean_real for _, _, mean_real, _ in antenna_stats], dtype=float)
        means_imag = np.asarray([mean_imag for _, _, _, mean_imag in antenna_stats], dtype=float)
        center_real = float(np.nanmean(means_real))
        center_imag = float(np.nanmean(means_imag))
        std_mean_real = float(np.nanstd(means_real))
        std_mean_imag = float(np.nanstd(means_imag))
        valid_real_std = bool(np.isfinite(std_mean_real) and std_mean_real > 0.0)
        valid_imag_std = bool(np.isfinite(std_mean_imag) and std_mean_imag > 0.0)
        if not all(np.isfinite(v) for v in (center_real, center_imag)) or not (valid_real_std or valid_imag_std):
            logger.write(
                f"ante-mean-thrsld stokes={stokes}: skipped; invalid std of antenna means "
                f"center_real={center_real:.6g}% center_imag={center_imag:.6g}% "
                f"std_mean_real={std_mean_real:.6g}% std_mean_imag={std_mean_imag:.6g}%"
            )
            intent_parts.append(f"stokes {stokes}: skipped invalid std of antenna means")
            continue

        gamma = float(NormalDist().inv_cdf(1.0 - 1.0 / (2.0 * nant)))
        real_cutoff = alpha * gamma * std_mean_real if valid_real_std else float("inf")
        imag_cutoff = alpha * gamma * std_mean_imag if valid_imag_std else float("inf")

        for antenna, npoint, mean_real, mean_imag in antenna_stats:
            real_offset = abs(mean_real - center_real)
            imag_offset = abs(mean_imag - center_imag)
            promote_real = bool(valid_real_std and np.isfinite(real_offset) and real_offset > real_cutoff)
            promote_imag = bool(valid_imag_std and np.isfinite(imag_offset) and imag_offset > imag_cutoff)
            promote = promote_real or promote_imag
            if promote:
                mask |= (stokes_values == stokes) & (antenna_values == antenna)
            logger.write(
                "ante-mean-thrsld "
                f"antenna={antenna} stokes={stokes} threshold={alpha:g} "
                f"valid_antennas={nant} n={npoint} gamma={gamma:.6g} "
                f"center_real={center_real:.3f}% center_imag={center_imag:.3f}% "
                f"std_mean_real={std_mean_real:.3f}% std_mean_imag={std_mean_imag:.3f}% "
                f"mean_real={mean_real:.3f}% mean_imag={mean_imag:.3f}% "
                f"real_offset={real_offset:.3f}% imag_offset={imag_offset:.3f}% "
                f"real_cutoff={real_cutoff:.3f}% imag_cutoff={imag_cutoff:.3f}% "
                f"promote_real={'yes' if promote_real else 'no'} "
                f"promote_imag={'yes' if promote_imag else 'no'} "
                f"promote={'yes' if promote else 'no'}"
            )
            intent_parts.append(
                f"stokes {stokes} antenna {antenna}: valid_antennas={nant} n={npoint} gamma={gamma:.6g} "
                f"center_real={center_real:.6g}% center_imag={center_imag:.6g}% "
                f"std_mean_real={std_mean_real:.6g}% std_mean_imag={std_mean_imag:.6g}% "
                f"mean_real={mean_real:.6g}% mean_imag={mean_imag:.6g}% "
                f"real_offset={real_offset:.6g}% imag_offset={imag_offset:.6g}% "
                f"real_cutoff={real_cutoff:.6g}% imag_cutoff={imag_cutoff:.6g}% "
                f"threshold={alpha:g} "
                f"promote_real={'yes' if promote_real else 'no'} "
                f"promote_imag={'yes' if promote_imag else 'no'} "
                f"promote={'yes' if promote else 'no'}"
            )

    total = int(np.count_nonzero(~exclude & np.isfinite(real_values) & np.isfinite(imag_values)))
    total_new = int(np.count_nonzero(mask))
    pct_total = 100.0 * total_new / total if total else 0.0
    promoted = sorted({int(ant) for ant in antenna_values[mask]}) if np.any(mask) else []
    logger.write(
        f"ante-mean-thrsld promoted_antennas={format_int_values(promoted) if promoted else 'none'} "
        f"new_flags={total_new}/{total} ({pct_total:.2f}%)"
    )
    return mask, intent_parts


def antenna_flag_fraction_threshold_mask(
    gains: Dict[str, Any],
    source_flags: np.ndarray,
    percent: float,
    logger: TaskLogger,
) -> Tuple[np.ndarray, List[str]]:
    antenna_values = np.asarray(gains["antenna"], dtype=int)
    stokes_values = np.asarray(gains["stokes"], dtype=int)
    mode = str(gains.get("header", {}).get("mode") or "").strip().lower()
    if mode == "bandpass":
        axis_values = np.asarray(gains["channel"], dtype=int)
        axis_label = "channel"
    else:
        axis_values = np.asarray(gains["time"], dtype=float)
        axis_label = "time"
    source = np.asarray(source_flags, dtype=bool)
    mask = np.zeros(source.shape, dtype=bool)
    intent_parts: List[str] = [f"percent={percent:g}", f"availability_axis={axis_label}_by_stokes"]

    available_counts: Dict[int, int] = {}
    for antenna in sorted(int(ant) for ant in np.unique(antenna_values)):
        ant_mask = antenna_values == antenna
        available = {
            (int(pol), axis)
            for pol, axis, flagged in zip(stokes_values[ant_mask], axis_values[ant_mask], source[ant_mask])
            if not flagged
        }
        available_counts[antenna] = len(available)
    max_available = max(available_counts.values(), default=0)
    logger.write(
        f"ante-thrsld availability_axis={axis_label}_by_stokes "
        f"max_unflagged_units={max_available}"
    )

    for antenna in sorted(int(ant) for ant in np.unique(antenna_values)):
        ant_mask = antenna_values == antenna
        available = int(available_counts.get(antenna, 0))
        flagged = max(0, max_available - available)
        flagged_percent = 100.0 * flagged / max_available if max_available else 0.0
        promote = max_available > 0 and flagged_percent >= percent
        if promote:
            mask |= ant_mask
        logger.write(
            "ante-thrsld "
            f"antenna={antenna} percent_threshold={percent:g} "
            f"unflagged_{axis_label}_stokes={available}/{max_available} "
            f"flagged_fraction={flagged}/{max_available} ({flagged_percent:.2f}%) "
            f"promote={'yes' if promote else 'no'}"
        )
        intent_parts.append(
            f"antenna {antenna}: unflagged_{axis_label}_stokes={available}/{max_available} "
            f"flagged_fraction={flagged}/{max_available} "
            f"({flagged_percent:.6g}%) threshold={percent:g} "
            f"promote={'yes' if promote else 'no'}"
        )

    total_new = int(np.count_nonzero(mask))
    total_samples = int(mask.size)
    pct_total = 100.0 * total_new / total_samples if total_samples else 0.0
    promoted_antennas = sorted(int(ant) for ant in np.unique(antenna_values[mask])) if np.any(mask) else []
    logger.write(
        f"ante-thrsld promoted_antennas={format_int_values(promoted_antennas) if promoted_antennas else 'none'} "
        f"new_flags={total_new}/{total_samples} ({pct_total:.2f}%)"
    )
    return mask, intent_parts


def normal_ks_d(values: np.ndarray) -> float:
    x = np.sort(np.asarray(values, dtype=float)[np.isfinite(values)])
    if x.size < 2:
        return np.nan
    mean = float(np.mean(x))
    std = float(np.std(x, ddof=1))
    if not np.isfinite(std) or std <= 0.0:
        return np.nan
    cdf = 0.5 * (1.0 + np.vectorize(math.erf)((x - mean) / (std * math.sqrt(2.0))))
    empirical_hi = np.arange(1, x.size + 1, dtype=float) / x.size
    empirical_lo = np.arange(0, x.size, dtype=float) / x.size
    return float(max(np.max(np.abs(empirical_hi - cdf)), np.max(np.abs(cdf - empirical_lo))))


def two_sample_ks_d(x: np.ndarray, y: np.ndarray) -> float:
    x = np.sort(np.asarray(x, dtype=float)[np.isfinite(x)])
    y = np.sort(np.asarray(y, dtype=float)[np.isfinite(y)])
    if x.size < 2 or y.size < 2:
        return np.nan
    pooled = np.concatenate([x, y])
    cdf_x = np.searchsorted(x, pooled, side="right") / float(x.size)
    cdf_y = np.searchsorted(y, pooled, side="right") / float(y.size)
    return float(np.max(np.abs(cdf_x - cdf_y)))


def simulated_gaussian_ks_mean(n_sample: int, seed: int, realizations: int = 128) -> float:
    n = int(n_sample)
    if n < 2:
        return np.nan
    rng = np.random.default_rng(seed)
    values = np.asarray(
        [two_sample_ks_d(rng.normal(size=n), rng.normal(size=n)) for _ in range(max(1, int(realizations)))],
        dtype=float,
    )
    values = values[np.isfinite(values)]
    return float(np.mean(values)) if values.size else np.nan


def ks_threshold_mask(
    gains: Dict[str, Any],
    factor: float,
    exclude_flags: Optional[np.ndarray],
    logger: TaskLogger,
) -> Tuple[np.ndarray, List[str]]:
    real_values = (np.asarray(gains["real"], dtype=float) - 1.0) * 100.0
    imag_values = np.asarray(gains["imag"], dtype=float) * 100.0
    antenna_values = np.asarray(gains["antenna"], dtype=int)
    stokes_values = np.asarray(gains["stokes"], dtype=int)
    exclude = np.asarray(exclude_flags, dtype=bool) if exclude_flags is not None else np.zeros(real_values.shape, dtype=bool)
    mask = np.zeros(real_values.shape, dtype=bool)
    intent_parts: List[str] = [f"factor={factor:g}", "real=Real-1 percent", "imag=Imag percent", "gaussian_realizations=128"]

    for antenna in sorted(int(ant) for ant in np.unique(antenna_values)):
        antenna_selector = antenna_values == antenna
        for stokes in sorted(int(pol) for pol in np.unique(stokes_values[antenna_selector])):
            group_selector = antenna_selector & (stokes_values == stokes)
            component_results: List[str] = []
            promote = False
            for comp_index, (comp_name, values) in enumerate((("real", real_values), ("imag", imag_values))):
                finite = group_selector & ~exclude & np.isfinite(values)
                samples = values[finite]
                npoint = int(samples.size)
                observed = normal_ks_d(samples)
                sim_mean = simulated_gaussian_ks_mean(
                    npoint,
                    seed=20260806 + 1000003 * int(antenna) + 1009 * int(stokes) + 37 * comp_index,
                )
                threshold = factor * sim_mean if np.isfinite(sim_mean) else np.nan
                fail = bool(np.isfinite(observed) and np.isfinite(threshold) and observed > threshold)
                promote = promote or fail
                obs_pct = observed * 100.0 if np.isfinite(observed) else np.nan
                sim_pct = sim_mean * 100.0 if np.isfinite(sim_mean) else np.nan
                thresh_pct = threshold * 100.0 if np.isfinite(threshold) else np.nan
                logger.write(
                    "ks-thrsld "
                    f"antenna={antenna} stokes={stokes} component={comp_name} "
                    f"factor={factor:g} n={npoint} ks={obs_pct:.3f}% "
                    f"gaussian_mean_ks={sim_pct:.3f}% threshold={thresh_pct:.3f}% "
                    f"flag={'yes' if fail else 'no'}"
                )
                component_results.append(
                    f"{comp_name}: n={npoint} ks={obs_pct:.6g}% "
                    f"gaussian_mean_ks={sim_pct:.6g}% threshold={thresh_pct:.6g}% "
                    f"flag={'yes' if fail else 'no'}"
                )
            if promote:
                mask |= group_selector
            logger.write(
                f"ks-thrsld antenna={antenna} stokes={stokes} "
                f"promote={'yes' if promote else 'no'}"
            )
            intent_parts.append(
                f"antenna {antenna} stokes {stokes}: "
                + "; ".join(component_results)
                + f"; promote={'yes' if promote else 'no'}"
            )

    total_new = int(np.count_nonzero(mask))
    total_samples = int(mask.size)
    pct_total = 100.0 * total_new / total_samples if total_samples else 0.0
    promoted = sorted(
        {(int(ant), int(pol)) for ant, pol in zip(antenna_values[mask], stokes_values[mask])}
    )
    promoted_text = ",".join(f"{ant}:{pol}" for ant, pol in promoted) if promoted else "none"
    logger.write(f"ks-thrsld promoted_antenna_stokes={promoted_text} new_flags={total_new}/{total_samples} ({pct_total:.2f}%)")
    return mask, intent_parts


def flag_count_text(flag: np.ndarray) -> str:
    return f"{int(np.count_nonzero(flag))}/{int(flag.size)}"


def log_per_antenna_flag_summary(
    gains: Dict[str, Any],
    flags: np.ndarray,
    logger: TaskLogger,
    current_fmode_flags: Optional[np.ndarray] = None,
) -> None:
    antenna_values = np.asarray(gains["antenna"], dtype=int)
    flag_values = np.asarray(flags, dtype=bool)
    current_values = np.asarray(current_fmode_flags, dtype=bool) if current_fmode_flags is not None else None
    logger.write("Per-antenna final flag summary:")
    if current_values is None:
        logger.write(f"{'antenna':>7}  {'pts':>7}  {'fin_per':>7}")
    else:
        logger.write(f"{'antenna':>7}  {'fmod-per':>8}  {'pts':>7}  {'fin_per':>7}")
    for antenna in sorted(int(ant) for ant in np.unique(antenna_values)):
        ant_mask = antenna_values == antenna
        total = int(np.count_nonzero(ant_mask))
        flagged = int(np.count_nonzero(flag_values & ant_mask))
        percent = 100.0 * flagged / total if total else 0.0
        points = f"{flagged}/{total}"
        if current_values is None:
            logger.write(f"{antenna:7d}  {points:>7}  {percent:7.2f}")
        else:
            current_flagged = int(np.count_nonzero(current_values & ant_mask))
            current_percent = 100.0 * current_flagged / total if total else 0.0
            logger.write(
                f"{antenna:7d}  {current_percent:8.2f}  {points:>7}  {percent:7.2f}"
            )
    fully_flagged = [
        int(antenna)
        for antenna in sorted(int(ant) for ant in np.unique(antenna_values))
        if np.count_nonzero(antenna_values == antenna) > 0
        and np.all(flag_values[antenna_values == antenna])
    ]
    logger.write(
        "Completely flagged antennas: "
        + (format_int_values(fully_flagged) if fully_flagged else "none")
    )


def format_selection(values: Optional[Sequence[int]]) -> str:
    if not values:
        return "none"
    return ",".join(str(int(value)) for value in values)


def format_int_values(values: Sequence[int]) -> str:
    unique = sorted({int(value) for value in values})
    if not unique:
        return "none"
    ranges: List[str] = []
    start = prev = unique[0]
    for value in unique[1:]:
        if value == prev + 1:
            prev = value
            continue
        ranges.append(str(start) if start == prev else f"{start}-{prev}")
        start = prev = value
    ranges.append(str(start) if start == prev else f"{start}-{prev}")
    return ",".join(ranges)


def format_manual_selection(selections: Optional[Sequence[Tuple[Sequence[int], Optional[Sequence[int]]]]]) -> str:
    if not selections:
        return "none"
    parts: List[str] = []
    for targets, stokes in selections:
        target_text = format_int_values(targets)
        if stokes is None:
            parts.append(target_text)
        else:
            stokes_text = format_int_values(stokes)
            parts.append(f"{target_text}:{stokes_text}")
    return ";".join(parts)


def normalize_flag_intents(value: Any) -> List[str]:
    if value is None:
        return []
    if isinstance(value, (list, tuple)):
        return [str(item) for item in value if str(item).strip()]
    text = str(value).strip()
    return [text] if text else []


def merged_flag_intents(previous_header: Optional[Dict[str, Any]], new_intents: Sequence[str], new_flags_only: bool) -> List[str]:
    merged: List[str] = []
    if not new_flags_only and previous_header is not None:
        merged.extend(normalize_flag_intents(previous_header.get("flag-intent")))
    merged.extend(str(item) for item in new_intents if str(item).strip())
    return merged or ["NO NEW FLAGS"]


def log_flag_intents(logger: TaskLogger, intents: Sequence[str]) -> None:
    logger.write("Flag intent:")
    for intent in intents:
        logger.write(f"  - {intent}")


def write_flag_file(
    path: Path,
    gains: Dict[str, Any],
    version: int,
    source: str,
    flag: np.ndarray,
    intents: List[str],
    args: argparse.Namespace,
    previous_header: Optional[Dict[str, Any]] = None,
) -> None:
    header = dict(gains.get("header", {}))
    flag_header = {
        "format": "GDP_FLAG_FLG",
        "format_version": "0.2",
        "created_utc": datetime.now(timezone.utc).isoformat(),
        "flag_version": int(version),
        "source": str(source),
        "source_format": header.get("format"),
        "input_table": header.get("input_table"),
        "mode": header.get("mode"),
        "bchan": header.get("bchan"),
        "echan": header.get("echan"),
        "flag_chans": header.get("flag_chans"),
        "flag-intent": list(intents),
        "previous_flag_version": None if previous_header is None else previous_header.get("flag_version"),
        "new_flags_only": bool(args.new_flags),
        "fmode": args.fmode,
        "threshold_alpha": getattr(args, "threshold_alpha", None),
        "threshold_percent": getattr(args, "threshold_percent", None),
        "threshold_factor": getattr(args, "threshold_factor", None),
        "manual_antennas": format_manual_selection(args.manual_antennas),
        "manual_channels": format_manual_selection(args.manual_channels),
        "axes": {"flag": ["sample"]},
        "columns": ["scan", "antenna", "stokes", "channel", "row", "time", "flag"],
    }
    payload = {
        "header_json": json.dumps(json_safe(flag_header), indent=2, sort_keys=True),
        "scan": np.asarray(gains["scan"], dtype=int),
        "antenna": np.asarray(gains["antenna"], dtype=int),
        "stokes": np.asarray(gains["stokes"], dtype=int),
        "channel": np.asarray(gains["channel"], dtype=int),
        "row": np.asarray(gains["row"], dtype=int),
        "time": np.asarray(gains["time"], dtype=float),
        "flag": np.asarray(flag, dtype=bool),
    }
    write_npz_exact_suffix(path, payload)


class TaskLogger:
    def __init__(self, path: Path):
        self.path = path
        self.path.parent.mkdir(parents=True, exist_ok=True)

    def _token(self, message: str, name: str) -> Optional[str]:
        match = re.search(rf"\b{re.escape(name)}=([^;\s]+)", message)
        return match.group(1) if match else None

    def _prefix_timestamp(self, line: str, message: str) -> str:
        timestamp, sep, _ = line.partition(" ")
        return f"{timestamp}{sep}{message}" if sep else message

    def terminal_line(self, line: str) -> str:
        marker = " FLAGS:"
        idx = line.find(marker)
        if "  - " in line and idx >= 0:
            return line[: idx + len(marker)]
        _, sep, message = line.partition(" ")
        if not sep:
            return line
        compact = self.compact_fmode_message(message)
        if compact is not None:
            if compact == "":
                return ""
            return self._prefix_timestamp(line, compact)
        return line

    def compact_fmode_message(self, message: str) -> Optional[str]:
        stripped = message.strip()

        if stripped.startswith(("all-std-thrsld ", "ante-std-thrsld ")):
            if "skipped; invalid mean/std" in stripped:
                return stripped.split(" real_std=", 1)[0]
            if " real_std=" in stripped and " new_flags=" in stripped:
                label = stripped.split(" ", 1)[0]
                antenna = self._token(stripped, "antenna")
                stokes = self._token(stripped, "stokes")
                new_flags = stripped.split(" new_flags=", 1)[1]
                parts = [label]
                if antenna is not None:
                    parts.append(f"antenna={antenna}")
                if stokes is not None:
                    parts.append(f"stokes={stokes}")
                parts.append(f"new_flags={new_flags}")
                return " ".join(parts)

        if stripped.startswith("ante-mean-thrsld "):
            if stripped.startswith("ante-mean-thrsld promoted_antennas="):
                return ""
            if "finite_unflagged_samples=" in stripped:
                return ""
            if "skipped; invalid mean" in stripped:
                return ""
            if "skipped; invalid std of antenna means" in stripped:
                return stripped.split(" center_real=", 1)[0]
            if " center_real=" in stripped and " promote=" in stripped:
                return ""

        if stripped.startswith("ante-thrsld "):
            if " unflagged_" in stripped and " promote=" in stripped:
                return ""

        if stripped.startswith("ks-thrsld "):
            if " gaussian_mean_ks=" in stripped:
                return ""
            if " promote=" in stripped and "antenna=" in stripped and "stokes=" in stripped:
                return ""

        return None

    def write(self, message: str) -> None:
        line = format_path_text(f"{datetime.now().isoformat(timespec='seconds')} {message}")
        terminal = self.terminal_line(line)
        if terminal:
            print(terminal)
        with self.path.open("a", encoding="utf-8") as f:
            f.write(line + "\n")

    def start(self, name: str) -> float:
        self.write(f"START {name}")
        return time.perf_counter()

    def done(self, name: str, start: float) -> None:
        self.write(f"DONE  {name} elapsed_sec={time.perf_counter() - start:.3f}")


def default_log_path(input_table: Path) -> Path:
    logs_dir = GSTATS.config_path("logs_dir") or (project_root() / "rundir" / "logs")
    return logs_dir / f"{input_table.name.rstrip('/')}_gdp-flag_{datetime.now().strftime('%Y%m%d_%H%M%S')}.log"


def logged_error(logger: TaskLogger, message: str) -> None:
    logger.write(message)
    raise SystemExit(1)


def resolve_previous_flags(
    gains_out: Path,
    use_flags: Optional[str],
    logger: TaskLogger,
) -> Tuple[Optional[np.ndarray], Optional[Dict[str, Any]], Optional[Path], Optional[int]]:
    if use_flags is None:
        return None, None, None, None
    requested = parse_flag_version(use_flags, "--use-flags")
    if requested is None:
        versions = flag_file_versions(gains_out)
        if not versions:
            logged_error(logger, f"ERROR: no flag versions found for {gains_out}.")
        version, path = versions[-1]
    else:
        version = requested
        path = flag_file_for_npz(gains_out, version)
        if not path.exists():
            logged_error(logger, f"ERROR: requested flag version fV{version} does not exist: {path}")
    return None, {"flag_version": version, "path": str(path)}, path, version


def default_previous_flag_path(gains_out: Path) -> Tuple[Optional[int], Optional[Path]]:
    versions = flag_file_versions(gains_out)
    return versions[-1] if versions else (None, None)


def selected_flag_version(gains_out: Path, requested: Optional[str]) -> int:
    parsed = parse_flag_version(requested, "--out-fver")
    return parsed if parsed is not None else GSTATS.next_flag_version(gains_out)


def remove_flag_version(gains_out: Path, requested: Optional[str], logger: TaskLogger) -> None:
    request = parse_remove_version_request(requested)
    if request is None:
        versions = flag_file_versions(gains_out)
        if not versions:
            logged_error(logger, f"ERROR: no flag versions found for {gains_out}.")
        target, path = versions[-1]
        path.unlink()
        logger.write(f"Removed flag file fV{target}: {path}")
        return

    kind, payload = request
    if kind == "single":
        target = int(payload)
        path = flag_file_for_npz(gains_out, target)
        if not path.exists():
            logged_error(logger, f"ERROR: requested flag version fV{target} does not exist: {path}")
        path.unlink()
        logger.write(f"Removed flag file fV{target}: {path}")
        return

    versions = flag_file_versions(gains_out)
    if not versions:
        logged_error(logger, f"ERROR: no flag versions found for {gains_out}.")
    version_map = {int(version): path for version, path in versions}

    if kind == "closed":
        start, end = payload
        targets = list(range(int(start), int(end) + 1))
        missing = [version for version in targets if version not in version_map]
        if missing:
            missing_text = ", ".join(f"fV{version}" for version in missing)
            logged_error(logger, f"ERROR: requested flag versions do not exist: {missing_text}")
    else:
        start = int(payload)
        targets = [version for version in sorted(version_map) if version >= start]
        if not targets:
            logged_error(logger, f"ERROR: no flag versions found at or above fV{start} for {gains_out}.")

    for target in targets:
        version_map[target].unlink()
        logger.write(f"Removed flag file fV{target}: {version_map[target]}")


def resolve_summary_flag_version(gains_out: Path, requested: Optional[str], logger: TaskLogger) -> Tuple[int, Path]:
    requested_version = parse_flag_version(requested, "summary")
    if requested_version is None:
        versions = flag_file_versions(gains_out)
        if not versions:
            logged_error(logger, f"ERROR: no flag versions found for {gains_out}.")
        return int(versions[-1][0]), versions[-1][1]
    path = flag_file_for_npz(gains_out, requested_version)
    if not path.exists():
        logged_error(logger, f"ERROR: requested flag version fV{requested_version} does not exist: {path}")
    return int(requested_version), path


def non_casa_batches(scans: Optional[List[int]], combine_scans: bool) -> List[Tuple[Optional[List[int]], str]]:
    if combine_scans:
        return [(scans, "allscans" if scans is None else "scan" + "-".join(str(s) for s in scans))]
    if scans is None:
        raise SystemExit("--fmode remove-version requires --scan unless --combine-scans is used.")
    return [([int(scan)], f"scan{int(scan)}") for scan in scans]


def run_batch(
    args: argparse.Namespace,
    input_table: Path,
    mode: str,
    scans: Optional[List[int]],
    selected_antennas: Optional[List[int]],
    scan_label: str,
    logger: TaskLogger,
) -> None:
    logger.write(f"gdp-flag batch={scan_label}")
    gains_out = build_gains_output(input_table, scan_label, mode, args)
    t0 = logger.start(f"read-gains {scan_label}")
    gains = GSTATS.compute_gains(input_table, mode, scans, selected_antennas, None, False, False, args.bchan, args.echan, None, None)
    if args.write_gains_npz or not gains_out.exists():
        GSTATS.write_npz(gains_out, gains)
        logger.write(f"Wrote gains NPZ for flag dimensions: {gains_out}")
    else:
        logger.write(f"Using gains NPZ naming base: {gains_out}")
    logger.done(f"read-gains {scan_label}", t0)

    table_flags = np.asarray(gains.get("table_flagged", gains.get("flagged")), dtype=bool)
    new_flags = np.zeros(table_flags.shape, dtype=bool)
    intents: List[str] = []

    previous_flags = None
    previous_header = None
    previous_path = None
    previous_version = None
    previous_ref = None
    if args.new_flags:
        logger.write("--new-flags set; previous flag versions will not be carried forward.")
    elif args.use_flags is None:
        previous_version, previous_path = default_previous_flag_path(gains_out)
        if previous_path is None:
            logger.write("No previous flag version found; writing only the new flags.")
        else:
            previous_ref = {"flag_version": previous_version, "path": str(previous_path)}
    else:
        _, previous_ref, previous_path, previous_version = resolve_previous_flags(gains_out, args.use_flags, logger)
    if previous_path is not None:
        previous_flags, previous_header = load_flag_file(previous_path, gains)
        previous_header = previous_header or previous_ref
        logger.write(f"Loaded previous flag file fV{previous_version}: {previous_path} flags={flag_count_text(previous_flags)}")

    fmode = args.fmode_resolved
    if fmode in PLACEHOLDER_FMODES:
        logger.write(f"fmode {args.fmode} is a placeholder; no threshold flagging algorithm has been implemented yet.")

    if fmode == "casa":
        new_flags |= table_flags
        intents.append("CASA FLAGS")
    elif fmode == "man_antenna":
        new_flags |= manual_antenna_mask(gains, args.manual_antennas)
        intents.append(f"MANUAL ANTENNA FLAGS: {format_manual_selection(args.manual_antennas)}")
    elif fmode == "man_chan":
        new_flags |= manual_channel_mask(gains, args.manual_channels)
        intents.append(f"MANUAL CHANNEL FLAGS: {format_manual_selection(args.manual_channels)}")
    elif fmode in {"all_std_thrsld", "ante_std_thrsld"}:
        exclude_flags = table_flags.copy()
        if previous_flags is not None and not args.new_flags:
            exclude_flags |= previous_flags
        fmode_label = "ante-std-thrsld" if fmode == "ante_std_thrsld" else "all-std-thrsld"
        threshold_flags, threshold_intent = std_threshold_mask(
            gains,
            args.threshold_alpha,
            exclude_flags,
            logger,
            per_antenna=fmode == "ante_std_thrsld",
            fmode_label=fmode_label,
        )
        new_flags |= threshold_flags
        intent_name = "ANTENNA STD THRESHOLD FLAGS" if fmode == "ante_std_thrsld" else "ALL STD THRESHOLD FLAGS"
        intents.append(f"{intent_name}: " + "; ".join(threshold_intent))
    elif fmode == "ante_mean_thrsld":
        exclude_flags = table_flags.copy()
        if previous_flags is not None and not args.new_flags:
            exclude_flags |= previous_flags
        threshold_flags, threshold_intent = antenna_mean_threshold_mask(
            gains,
            args.threshold_alpha,
            exclude_flags,
            logger,
        )
        new_flags |= threshold_flags
        intents.append("ANTENNA MEAN THRESHOLD FLAGS: " + "; ".join(threshold_intent))
    elif fmode == "ante_thrsld":
        source_flags = table_flags.copy()
        if previous_flags is not None and not args.new_flags:
            source_flags = previous_flags
        threshold_flags, threshold_intent = antenna_flag_fraction_threshold_mask(gains, source_flags, args.threshold_percent, logger)
        new_flags |= threshold_flags
        intents.append("ANTENNA FLAG FRACTION THRESHOLD FLAGS: " + "; ".join(threshold_intent))
    elif fmode == "ks_thrsld":
        exclude_flags = table_flags.copy()
        if previous_flags is not None and not args.new_flags:
            exclude_flags |= previous_flags
        threshold_flags, threshold_intent = ks_threshold_mask(gains, args.threshold_factor, exclude_flags, logger)
        new_flags |= threshold_flags
        intents.append("KS THRESHOLD FLAGS: " + "; ".join(threshold_intent))

    if previous_flags is not None and not args.new_flags:
        out_flags = previous_flags | new_flags
    else:
        out_flags = new_flags

    stored_intents = merged_flag_intents(previous_header, intents, bool(args.new_flags))
    out_version = selected_flag_version(gains_out, args.out_fver)
    flag_out = flag_file_for_npz(gains_out, out_version)
    t1 = logger.start(f"write-flags {scan_label}")
    write_flag_file(flag_out, gains, out_version, str(gains_out), out_flags, stored_intents, args, previous_header)
    new_pct = 100.0 * int(np.count_nonzero(new_flags)) / int(new_flags.size) if new_flags.size else 0.0
    out_pct = 100.0 * int(np.count_nonzero(out_flags)) / int(out_flags.size) if out_flags.size else 0.0
    logger.write(
        f"Wrote flag file fV{out_version}: {flag_out} "
        f"new_flags={flag_count_text(new_flags)} ({new_pct:.2f}%) "
        f"total_flags={flag_count_text(out_flags)} ({out_pct:.2f}%)"
    )
    log_flag_intents(logger, stored_intents)
    log_per_antenna_flag_summary(gains, out_flags, logger, new_flags)
    logger.done(f"write-flags {scan_label}", t1)


def run_remove_batch(
    args: argparse.Namespace,
    input_table: Path,
    mode: str,
    scans: Optional[List[int]],
    scan_label: str,
    logger: TaskLogger,
) -> None:
    logger.write(f"gdp-flag remove-version batch={scan_label}")
    gains_out = build_gains_output(input_table, scan_label, mode, args)
    target = args.remove_version
    t0 = logger.start(f"remove-version {scan_label}")
    remove_flag_version(gains_out, target, logger)
    logger.done(f"remove-version {scan_label}", t0)


def run_summary_batch(
    args: argparse.Namespace,
    input_table: Path,
    mode: str,
    scans: Optional[List[int]],
    selected_antennas: Optional[List[int]],
    scan_label: str,
    logger: TaskLogger,
) -> None:
    logger.write(f"gdp-flag summary batch={scan_label}")
    gains_out = build_gains_output(input_table, scan_label, mode, args)
    version, path = resolve_summary_flag_version(gains_out, args.summary_version, logger)
    t0 = logger.start(f"summary {scan_label}")
    gains = GSTATS.compute_gains(input_table, mode, scans, selected_antennas, None, False, False, args.bchan, args.echan, None, None)
    flags, header = load_flag_file(path, gains)
    logger.write(f"Loaded flag file fV{version}: {path} flags={flag_count_text(flags)}")
    log_flag_intents(logger, normalize_flag_intents((header or {}).get("flag-intent")))
    log_per_antenna_flag_summary(gains, flags, logger)
    logger.done(f"summary {scan_label}", t0)


def run_apply_batch(
    args: argparse.Namespace,
    input_table: Path,
    mode: str,
    scans: Optional[List[int]],
    selected_antennas: Optional[List[int]],
    scan_label: str,
    logger: TaskLogger,
) -> None:
    logger.write(f"gdp-flag apply batch={scan_label}")
    gains_out = build_gains_output(input_table, scan_label, mode, args)
    requested = parse_flag_version(args.apply_flag, "--apply-flag")
    version, flag_path = resolve_summary_flag_version(gains_out, str(requested) if requested is not None else None, logger)
    output_table = (
        Path(args.output_table).expanduser().resolve()
        if args.output_table
        else default_output_table_path(input_table, version)
    )
    gains = GSTATS.compute_gains(
        input_table,
        mode,
        scans,
        selected_antennas,
        None,
        False,
        False,
        args.bchan,
        args.echan,
        None,
        None,
    )
    if gains["row"].size == 0:
        logged_error(logger, f"ERROR: no matching rows found for {input_table} batch={scan_label}.")
    lookup, header = GSTATS.load_flag_lookup(flag_path)
    t0 = logger.start(f"apply-flag {scan_label}")
    copy_table_tree(input_table, output_table)
    casatable = GSTATS.casatable_factory()
    tb = casatable()
    applied_points = 0
    try:
        open_casa_table(tb, output_table, writable=True)
        cols = list(tb.colnames())
        if "FLAG" not in cols:
            logged_error(logger, f"ERROR: output CASA table has no FLAG column: {output_table}")
        data_col = GSTATS.choose_data_column(cols, mode)
        flag_chans = header.get("flag_chans")
        if isinstance(flag_chans, list) and len(flag_chans) == 2:
            flag_chans_tuple = (int(flag_chans[0]), int(flag_chans[1]))
        else:
            flag_chans_tuple = None
        row_values = np.asarray(gains["row"], dtype=int)
        stokes_values = np.asarray(gains["stokes"], dtype=int)
        channel_values = np.asarray(gains["channel"], dtype=int)
        output_flags = np.asarray(
            [
                bool(lookup.get((int(row), int(pol), int(chan)), False))
                for row, pol, chan in zip(row_values, stokes_values, channel_values)
            ],
            dtype=bool,
        )
        for row_id in sorted(int(row) for row in np.unique(row_values)):
            row_mask = row_values == row_id
            data_raw = np.asarray(tb.getcol(data_col, startrow=row_id, nrow=1))
            if data_raw.ndim == 2:
                data_raw = data_raw[:, None, :]
            raw_flag = np.asarray(tb.getcol("FLAG", startrow=row_id, nrow=1))
            full_flag = GSTATS.normalize_flag(raw_flag, data_raw.shape, 0, flag_chans_tuple)
            for pol, chan, flag in zip(stokes_values[row_mask], channel_values[row_mask], output_flags[row_mask]):
                full_flag[int(pol), int(chan), 0] = bool(flag)
                applied_points += 1
            stored_flag = restore_flag_storage_shape(full_flag, raw_flag, data_raw.shape, 0, flag_chans_tuple)
            tb.putcol("FLAG", np.asarray(stored_flag, dtype=bool), startrow=row_id, nrow=1)
        write_flag_intent_metadata(tb, version, flag_path, header or {})
    finally:
        try:
            tb.close()
        except Exception:
            pass
    logger.write(
        f"Applied flag version fV{version}: {flag_path} -> {output_table} "
        f"updated_points={applied_points}"
    )
    logger.done(f"apply-flag {scan_label}", t0)


def parse_args() -> argparse.Namespace:
    p = argparse.ArgumentParser(description="Create GDP .flg sidecar files from CASA flags or manual flag intents.")
    p.add_argument("--input-table", dest="input_table_opt", default=None, help="Input CASA gain/bandpass table path.")
    p.add_argument("--gain-table", default=None, help="Input gain table. Defaults to saved gdp-setup gain_table in gain mode.")
    p.add_argument("--bandpass-table", default=None, help="Input bandpass table. Defaults to saved gdp-setup bandpass_table in bandpass mode.")
    p.add_argument("--setup-file", default=None, help="Setup JSON file to use. Relative names are resolved under the active runtime directory.")
    p.add_argument("--relative-path", action="store_true", help="Print runtime-relative file references after reporting the runtime directory; file writes are unchanged.")
    p.add_argument("--mode", choices=["auto", "gain", "bandpass"], default="auto", help="Flagging mode. Default: auto.")
    p.add_argument("--scan", default=None, help="Comma-separated scans to process. Default: all scans.")
    p.add_argument("--combine-scans", "--combine", action="store_true", help="Combine selected scans into one allscans-style flag product.")
    p.add_argument("--antennas", "--antenna", nargs="+", default=None, help="Antenna selection used to define the flag product dimensions.")
    p.add_argument("--bchan", type=int, default=None, help="Start channel, inclusive. Bandpass mode only.")
    p.add_argument("--echan", type=int, default=None, help="End channel, exclusive. Bandpass mode only.")
    p.add_argument("--use-flags", nargs="?", const="highest", default=None, metavar="VERSION", help="Carry an existing GDP .flg version into the output. Omit VERSION to use the highest available version. By default, gdp-flag carries the highest previous version when one exists.")
    p.add_argument("--new-flags", action="store_true", help="Write only the new fmode flags; do not carry previous GDP flag versions.")
    p.add_argument("--out-fver", dest="out_fver", default=None, help="Output flag version. Default: next version beside the matching gains NPZ.")
    p.add_argument("--apply-flag", nargs="?", const="highest", default=None, metavar="VERSION", help="Apply an existing GDP .flg version back into a copied CASA table. Omit VERSION to use the highest available matching version.")
    p.add_argument("--output-table", default=None, help="Output CASA table path for --apply-flag. Default: rundir/gaintable/<original>_fV<VERSION>.")
    p.add_argument("--fmode", default="casa-flags", help="Flag mode: casa-flags, man-antenna, man-chan, all-std-thrsld, ante-std-thrsld, ante-mean-thrsld, remove-version, summary, ante-thrsld, ks-thrsld, auto-ante, auto-chan.")
    p.add_argument("--alpha", dest="threshold_alpha_opt", default=None, help="Threshold value for --fmode all-std-thrsld, ante-std-thrsld, or ante-mean-thrsld. If omitted, the default is 1. A trailing value after the fmode is also accepted.")
    p.add_argument("--percent", dest="threshold_percent_opt", default=None, help="Flagged-data percentage threshold for --fmode ante-thrsld. If omitted, percent=70. A trailing value after the fmode is also accepted.")
    p.add_argument("--factor", dest="threshold_factor_opt", default=None, help="Multiplier for --fmode ks-thrsld. If omitted, factor=1. A trailing value after the fmode is also accepted.")
    p.add_argument("--man-antenna", "--man-antennas", nargs="+", dest="man_antenna", default=None, help="Manual antenna list/range for --fmode man-antenna. Add :STOKES to flag selected stokes only, for example 1:0, [1-4]:1, or 23 for all stokes.")
    p.add_argument("--man-chan", "--man-channel", nargs="+", dest="man_chan", default=None, help="Manual bandpass channel list/range for --fmode man-chan. Add :STOKES to flag selected stokes only, for example 900:0, [900-1200]:1, or 1300 for all stokes.")
    p.add_argument("--output-gains-npz", default=None, help="Matching gains NPZ path used as the flag filename base.")
    p.add_argument("--write-gains-npz", action="store_true", help="Rewrite the matching gains NPZ even if it already exists.")
    p.add_argument("fmode_values", nargs="*", help=argparse.SUPPRESS)
    return p.parse_args()


def main() -> None:
    global RELATIVE_PATHS
    args = parse_args()
    activate_config(args.setup_file)
    RELATIVE_PATHS = bool(args.relative_path)
    GSTATS.RELATIVE_PATHS = bool(args.relative_path)
    args.fmode_resolved = parse_fmode(args.fmode)
    mode = infer_mode(args)
    applying_flags = args.apply_flag is not None
    if applying_flags and args.fmode != "casa-flags":
        raise SystemExit("--apply-flag is a standalone action; do not combine it with a non-default --fmode.")
    if args.fmode_resolved == "man_chan" and mode != "bandpass":
        raise SystemExit("ERROR: --fmode man-chan works only with --mode bandpass.")
    explicit_input = args.input_table_opt
    mode_input = args.bandpass_table if mode == "bandpass" else args.gain_table
    input_table = resolve_input(explicit_input or mode_input, mode)
    if not input_table.exists():
        raise FileNotFoundError(f"Input table not found: {input_table}")
    scans = parse_scan_list(args.scan)
    if args.fmode_resolved != "remove_version":
        GSTATS.validate_requested_scans(input_table, mode, scans)
    selected_antennas = parse_int_selection(args.antennas, "--antennas")
    args.manual_antennas = parse_manual_selection(args.man_antenna or args.fmode_values if args.fmode_resolved == "man_antenna" else args.man_antenna, "--man-antenna")
    args.manual_channels = parse_manual_selection(args.man_chan or args.fmode_values if args.fmode_resolved == "man_chan" else args.man_chan, "--man-chan")
    args.remove_version = str(args.fmode_values[0]) if args.fmode_resolved == "remove_version" and args.fmode_values else None
    args.summary_version = str(args.fmode_values[0]) if args.fmode_resolved == "summary" and args.fmode_values else None
    if args.fmode_resolved == "remove_version" and len(args.fmode_values) > 1:
        raise SystemExit("--fmode remove-version accepts at most one trailing version selector.")
    if args.fmode_resolved == "summary" and len(args.fmode_values) > 1:
        raise SystemExit("--fmode summary accepts at most one trailing version selector.")
    threshold_fmodes = {"all_std_thrsld", "ante_std_thrsld", "ante_mean_thrsld"}
    percent_fmodes = {"ante_thrsld"}
    factor_fmodes = {"ks_thrsld"}
    if args.fmode_resolved in threshold_fmodes and len(args.fmode_values) > 1:
        raise SystemExit(f"--fmode {args.fmode} accepts at most one trailing alpha value.")
    if args.fmode_resolved in percent_fmodes and len(args.fmode_values) > 1:
        raise SystemExit(f"--fmode {args.fmode} accepts at most one trailing percent value.")
    if args.fmode_resolved in factor_fmodes and len(args.fmode_values) > 1:
        raise SystemExit(f"--fmode {args.fmode} accepts at most one trailing multiplier value.")
    if args.fmode_resolved not in threshold_fmodes and args.threshold_alpha_opt is not None:
        raise SystemExit("--alpha is valid only with --fmode all-std-thrsld, ante-std-thrsld, or ante-mean-thrsld.")
    if args.fmode_resolved not in percent_fmodes and args.threshold_percent_opt is not None:
        raise SystemExit("--percent is valid only with --fmode ante-thrsld.")
    if args.fmode_resolved not in factor_fmodes and args.threshold_factor_opt is not None:
        raise SystemExit("--factor is valid only with --fmode ks-thrsld.")
    alpha_value = args.threshold_alpha_opt or (str(args.fmode_values[0]) if args.fmode_resolved in threshold_fmodes and args.fmode_values else None)
    alpha_default = 1.0
    args.threshold_alpha = parse_positive_float(alpha_value, f"{args.fmode} alpha", alpha_default)
    percent_value = args.threshold_percent_opt or (str(args.fmode_values[0]) if args.fmode_resolved in percent_fmodes and args.fmode_values else None)
    args.threshold_percent = parse_percent_value(percent_value, f"{args.fmode} percent", 70.0)
    factor_value = args.threshold_factor_opt or (str(args.fmode_values[0]) if args.fmode_resolved in factor_fmodes and args.fmode_values else None)
    args.threshold_factor = parse_threshold_factor(factor_value, f"{args.fmode} factor", 1.0)
    if mode == "gain" and (args.bchan is not None or args.echan is not None):
        raise SystemExit("Channel options --bchan/--echan are valid only in bandpass mode.")
    if args.fmode_resolved == "man_antenna" and not args.manual_antennas:
        raise SystemExit("--fmode man-antenna requires --man-antenna or trailing antenna values.")
    if args.fmode_resolved == "man_chan" and not args.manual_channels:
        raise SystemExit("--fmode man-chan requires --man-chan or trailing channel values.")
    logger = TaskLogger(default_log_path(input_table))
    if args.relative_path:
        logger.write(f"Runtime directory: {runtime_dir()}")
    logger.write(f"gdp-flag input={input_table} mode={mode} fmode={args.fmode}")
    batches = non_casa_batches(scans, args.combine_scans) if args.fmode_resolved == "remove_version" else GSTATS.scan_batches(input_table, scans, args.combine_scans)
    if len(batches) > 1 and (args.output_gains_npz or args.out_fver):
        raise SystemExit("Explicit --output-gains-npz or --out-fver cannot be used when writing multiple per-scan flag products.")
    if applying_flags and len(batches) > 1 and args.output_table:
        raise SystemExit("Explicit --output-table cannot be used when --apply-flag would write multiple per-scan tables.")
    for batch_scans, batch_label in batches:
        if applying_flags:
            run_apply_batch(args, input_table, mode, batch_scans, selected_antennas, batch_label, logger)
        elif args.fmode_resolved == "remove_version":
            run_remove_batch(args, input_table, mode, batch_scans, batch_label, logger)
        elif args.fmode_resolved == "summary":
            run_summary_batch(args, input_table, mode, batch_scans, selected_antennas, batch_label, logger)
        else:
            run_batch(args, input_table, mode, batch_scans, selected_antennas, batch_label, logger)
    logger.write(f"Log file: {logger.path}")


if __name__ == "__main__":
    try:
        main()
    except RuntimeError as exc:
        if "casatools.table" in str(exc):
            raise SystemExit(str(exc)) from exc
        raise
