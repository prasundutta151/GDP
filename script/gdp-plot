except Exception as exc:
    raise RuntimeError("gdp-plot requires matplotlib. See REQUIREMENTS.md.") from exc


CONFIG_NAME = ".gdp-config.json"
ACTIVE_CONFIG: Optional[Dict[str, Any]] = None
ACTIVE_FLAGVER: Optional[int] = None
APPLY_FLAG_FILES: bool = False
RELATIVE_PATHS = False
DEFAULT_PLOT_DPI = 320
CLI_PARSER: Optional[argparse.ArgumentParser] = None


class GDPArgumentParser(argparse.ArgumentParser):
    """Show the complete command help for invalid command-line input."""

    def error(self, message: str) -> None:
        self.print_help(sys.stderr)
        self.exit(2, f"\n{self.prog}: error: {message}\n")


