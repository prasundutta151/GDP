#!/usr/bin/env python3
"""Plot GDP products, creating missing NPZ products with gdp-stats when needed."""

from __future__ import annotations

import argparse
import json
import math
import re
import subprocess
import sys
import time
from pathlib import Path
from typing import Any, Dict, Iterable, List, Optional, Sequence, Tuple

import numpy as np

try:
    import matplotlib

    matplotlib.use("Agg")
    from matplotlib.patches import Ellipse
    import matplotlib.pyplot as plt
except Exception as exc:
    raise RuntimeError("gdp-plot requires matplotlib. See REQUIREMENTS.md.") from exc


CONFIG_NAME = ".gdp-config.json"
ACTIVE_CONFIG: Optional[Dict[str, Any]] = None
ACTIVE_FLAGVER: Optional[int] = None
APPLY_FLAG_FILES: bool = False
DEFAULT_PLOT_DPI = 320
PRODUCTS = {
    "gain_colormap": ("gains", "gains_npz_dir", "gains"),
    "gain_hist": ("gains", "gains_npz_dir", "gains"),
    "reim": ("gains", "gains_npz_dir", "gains"),
    "antenna": ("gains", "gains_npz_dir", "gains"),
    "stats": ("gains", "gains_npz_dir", "gains"),
    "ks": ("ks", "ks_npz_dir", "ks"),
    "self_corr_colormap": ("self_corr", "self_corr_npz_dir", "self-corr"),
    "self_corr_antenna": ("self_corr", "self_corr_npz_dir", "self-corr"),
    "cross_corr_colormap": ("cross_corr", "cross_corr_npz_dir", "cross-corr"),
}
ALL_PMODE_TASKS = ["gain_colormap", "gain_hist", "stats", "ks"]
PLOT_TASK_NAMES = {
    "gain_colormap": "colormap",
    "gain_hist": "hist",
}

PMODE_ALIASES = {
    "all": "all",
    "colormap": "gain_colormap",
    "gain-colormap": "gain_colormap",
    "gain_colormap": "gain_colormap",
    "hist": "gain_hist",
    "gain-hist": "gain_hist",
    "gain_hist": "gain_hist",
    "reim": "reim",
    "antenna": "antenna",
    "stats": "stats",
    "ks": "ks",
    "self-corr-colormap": "self_corr_colormap",
    "self_corr_colormap": "self_corr_colormap",
    "self-corr-antenna": "self_corr_antenna",
    "self_corr_antenna": "self_corr_antenna",
    "cross-corr-colormap": "cross_corr_colormap",
    "cross_corr_colormap": "cross_corr_colormap",
}


def project_root() -> Path:
    return Path(__file__).resolve().parents[1]


def script_dir() -> Path:
    return project_root() / "script"


def load_project_config() -> Dict[str, Any]:
    path = project_root() / CONFIG_NAME
    if not path.exists():
        return {}
    with path.open("r", encoding="utf-8") as f:
        return json.load(f)


def resolve_setup_file_path(setup_file: Optional[str], base_config: Dict[str, Any]) -> Optional[Path]:
    if setup_file:
        path = Path(setup_file).expanduser()
        if path.is_absolute():
            return path.resolve()
        rundir = Path(str(base_config.get("rundir") or (project_root() / "rundir"))).expanduser().resolve()
        return (rundir / path).resolve()
    configured = base_config.get("setup_file")
    return Path(str(configured)).expanduser().resolve() if configured else None


def activate_config(setup_file: Optional[str] = None) -> Dict[str, Any]:
    global ACTIVE_CONFIG
    base = load_project_config()
    setup_path = resolve_setup_file_path(setup_file, base)
    if setup_path and setup_path.exists():
        with setup_path.open("r", encoding="utf-8") as f:
            ACTIVE_CONFIG = json.load(f)
    else:
        if setup_file:
            raise FileNotFoundError(f"Setup file not found: {setup_path}")
        ACTIVE_CONFIG = base
    return ACTIVE_CONFIG


def load_config() -> Dict[str, Any]:
    return ACTIVE_CONFIG if ACTIVE_CONFIG is not None else activate_config()


def config_path(key: str) -> Optional[Path]:
    cfg = load_config()
    value = cfg.get(key)
    if value is None and isinstance(cfg.get("paths"), dict):
        value = cfg["paths"].get(key)
    return Path(str(value)).expanduser().resolve() if value else None


def parse_int_list(text: Optional[str]) -> Optional[List[int]]:
    if text is None or str(text).strip() == "":
        return None
    return sorted({int(part.strip()) for part in str(text).split(",") if part.strip()})


def normalize_list_text(text: object) -> str:
    if isinstance(text, (list, tuple)):
        return " ".join(str(item) for item in text)
    return str(text)


def antenna_tokens(text: object) -> List[str]:
    value = normalize_list_text(text).strip()
    raw_tokens = re.findall(r"[\(\[][^\)\]]+[\)\]]|[^\s]+", value)
    tokens: List[str] = []
    for raw in raw_tokens:
        if (raw.startswith("(") and raw.endswith(")")) or (raw.startswith("[") and raw.endswith("]")):
            tokens.append(raw)
        else:
            tokens.extend(part for part in raw.split(",") if part)
    return [token.strip() for token in tokens if token.strip()]


def parse_antenna_token(token: str, option_name: str) -> List[int]:
    value = token.strip()
    if (value.startswith("(") and value.endswith(")")) or (value.startswith("[") and value.endswith("]")):
        value = value[1:-1].strip()
    if "," in value:
        parts = [part.strip() for part in value.split(",") if part.strip()]
        if len(parts) != 2:
            raise SystemExit(f"{option_name} range form must be two numbers, for example {option_name} [0,9]")
        start, end = int(parts[0]), int(parts[1])
        step = 1 if end >= start else -1
        return list(range(start, end + step, step))
    if "-" in value and not value.startswith("-"):
        parts = [part.strip() for part in value.split("-", 1) if part.strip()]
        if len(parts) != 2:
            raise SystemExit(f"{option_name} range form must be two numbers, for example {option_name} 0-9")
        start, end = int(parts[0]), int(parts[1])
        step = 1 if end >= start else -1
        return list(range(start, end + step, step))
    return [int(value)]


def parse_antenna_list(text: object, option_name: str = "--antenna") -> Optional[List[int]]:
    if text is None or normalize_list_text(text).strip() == "":
        return None
    antennas: List[int] = []
    for token in antenna_tokens(text):
        antennas.extend(parse_antenna_token(token, option_name))
    return sorted(set(antennas))


def parse_float_range(text: Optional[str]) -> Optional[Tuple[float, float]]:
    if text is None or str(text).strip() == "":
        return None
    parts = [float(part.strip()) for part in str(text).split(",") if part.strip()]
    if len(parts) != 2:
        raise ValueError("--hist-range must be two comma-separated numbers: min,max")
    if parts[0] == parts[1]:
        raise ValueError("--hist-range min and max must differ.")
    return (min(parts), max(parts))


def parse_channel_pair(text: object, option_name: str = "-pchans") -> Optional[Tuple[int, int]]:
    if text is None or normalize_list_text(text).strip() == "":
        return None
    value = normalize_list_text(text).strip()
    if (value.startswith("[") and value.endswith("]")) or (value.startswith("(") and value.endswith(")")):
        value = value[1:-1]
    parts = [part.strip() for part in value.replace(",", " ").split() if part.strip()]
    if len(parts) != 2:
        raise SystemExit(f"{option_name} must be two channel numbers, for example {option_name} '[0,128]'")
    start, end = int(parts[0]), int(parts[1])
    if end <= start:
        raise SystemExit(f"{option_name} end channel must be greater than start channel.")
    return start, end


def parse_pmode(text: Optional[str]) -> List[str]:
    if text is None or str(text).strip() == "":
        return []
    modes: List[str] = []
    for part in str(text).replace(",", " ").split():
        key = part.strip()
        if not key:
            continue
        if key not in PMODE_ALIASES:
            valid = ", ".join(sorted(k for k in PMODE_ALIASES if "-" in k or k in {"all", "colormap", "hist", "reim", "antenna", "stats", "ks"}))
            raise ValueError(f"Unknown pmode '{key}'. Valid modes: {valid}")
        task = PMODE_ALIASES[key]
        if task == "all":
            for expanded in ALL_PMODE_TASKS:
                if expanded not in modes:
                    modes.append(expanded)
        elif task not in modes:
            modes.append(task)
    return modes


def antenna_from_pmode_values(args: argparse.Namespace, tasks: Sequence[str]) -> Optional[str]:
    if args.antenna:
        return normalize_list_text(args.antenna)
    if "antenna" not in tasks or not args.pmode_values:
        return None
    return ",".join(str(value) for value in args.pmode_values)


def scan_text(scans: Optional[List[int]]) -> str:
    return "allscans" if scans is None else "scan" + "-".join(str(s) for s in scans)


def channel_tag(mode: str, bchan: Optional[int], echan: Optional[int]) -> str:
    if mode == "bandpass" and bchan is not None and echan is not None:
        return f"chan_{int(bchan)}_{int(echan)}"
    return ""


def label_with_channel(scan_label: str, mode: str, bchan: Optional[int], echan: Optional[int]) -> str:
    tag = channel_tag(mode, bchan, echan)
    return f"{scan_label}-{tag}" if tag else scan_label


def plot_channel_tag(pchans: Optional[Tuple[int, int]]) -> str:
    if pchans is None:
        return ""
    return f"pchan_{int(pchans[0])}_{int(pchans[1])}"


def label_with_plot_channels(scan_label: str, pchans: Optional[Tuple[int, int]]) -> str:
    tag = plot_channel_tag(pchans)
    return f"{scan_label}-{tag}" if tag else scan_label


def validate_channel_options_for_mode(mode: str, args: argparse.Namespace, pchans: Optional[Tuple[int, int]]) -> None:
    if mode != "gain":
        return
    used = []
    if args.bchan is not None:
        used.append("--bchan")
    if args.echan is not None:
        used.append("--echan")
    if pchans is not None:
        used.append("-pchans/--pchans")
    if used:
        raise SystemExit(
            "Channel options are valid only in bandpass mode. "
            f"Remove {', '.join(used)} or run with --mode bandpass."
        )


def default_product_dir(product: str) -> Path:
    _, config_key, folder = PRODUCTS[product]
    configured = config_path(config_key)
    if configured is not None:
        return configured
    return project_root() / "rundir" / "data-product" / folder / "npz"


def default_product_path(product: str, mode: str, scan_label: str, bchan: Optional[int] = None, echan: Optional[int] = None) -> Path:
    product_name, _, _ = PRODUCTS[product]
    output_label = label_with_channel(scan_label, mode, bchan, echan)
    return default_product_dir(product) / f"gdp-{product_name.replace('_', '-')}-{mode}-{output_label}.npz"


def discover_scan_products(product: str, mode: str, bchan: Optional[int] = None, echan: Optional[int] = None) -> List[Tuple[str, Path]]:
    product_name, _, _ = PRODUCTS[product]
    tag = channel_tag(mode, bchan, echan)
    suffix = f"-{tag}" if tag else ""
    pattern = f"gdp-{product_name.replace('_', '-')}-{mode}-scan*{suffix}.npz"
    found = []
    for path in sorted(default_product_dir(product).glob(pattern)):
        label = path.stem.split(f"gdp-{product_name.replace('_', '-')}-{mode}-", 1)[-1]
        found.append((label, path))
    return found


def label_from_npz_path(path: Path, product: str, mode: str) -> str:
    product_name, _, _ = PRODUCTS[product]
    prefix = f"gdp-{product_name.replace('_', '-')}-{mode}-"
    if path.stem.startswith(prefix):
        return path.stem[len(prefix):]
    return path.stem


def default_plot_dir(fmt: str) -> Path:
    key = f"plots_{fmt}_dir"
    configured = config_path(key)
    if configured is not None:
        return configured
    return project_root() / "rundir" / "plots" / fmt


def output_path(plot_dir: Path, task: str, mode: str, scan_label: str, fmt: str) -> Path:
    task_name = PLOT_TASK_NAMES.get(task, task.replace("_", "-"))
    return plot_dir / f"gdp-plot-{task_name}-{mode}-{scan_label}.{fmt}"


def stats_output_path(plot_dir: Path, mode: str, scan_label: str, fmt: str, adjust_mean: bool) -> Path:
    suffix = "-adjust-mean" if adjust_mean else ""
    return plot_dir / f"gdp-plot-stats-{mode}-{scan_label}{suffix}.{fmt}"


def product_message_name(product: str) -> str:
    product_name, _, _ = PRODUCTS[product]
    return f"{product_name} NPZ for {product.replace('_', '-')}" if product_name != product else f"{product} NPZ"


def ensure_npz(product: str, mode: str, args: argparse.Namespace, scans: Optional[List[int]], scan_label: str) -> Path:
    path = default_product_path(product, mode, scan_label, args.bchan, args.echan)
    if path.exists() and not args.recompute:
        print(f"Using existing {product_message_name(product)}: {path}")
        return path

    smode = {
        "gain_colormap": "gains",
        "gain_hist": "gains",
        "reim": "gains",
        "antenna": "gains",
        "stats": "gains",
        "ks": "ks",
        "self_corr_colormap": "self-corr",
        "self_corr_antenna": "self-corr",
        "cross_corr_colormap": "cross-corr",
    }[product]
    output_flag = {
        "gain_colormap": "--output-gains-npz",
        "gain_hist": "--output-gains-npz",
        "reim": "--output-gains-npz",
        "antenna": "--output-gains-npz",
        "stats": "--output-gains-npz",
        "ks": "--output-ks-npz",
        "self_corr_colormap": "--output-self-corr-npz",
        "self_corr_antenna": "--output-self-corr-npz",
        "cross_corr_colormap": "--output-cross-corr-npz",
    }[product]

    cmd = [str(script_dir() / "gdp-stats"), "--mode", mode, "--combine-scans", "--smode", smode, output_flag, str(path)]
    if args.setup_file:
        cmd.extend(["--setup-file", args.setup_file])
    if args.input_table:
        cmd.extend(["--input-table", args.input_table])
    elif mode == "bandpass" and args.bandpass_table:
        cmd.extend(["--bandpass-table", args.bandpass_table])
    elif mode == "gain" and args.gain_table:
        cmd.extend(["--gain-table", args.gain_table])
    if scans is not None:
        cmd.extend(["--scan", ",".join(str(s) for s in scans)])
    if args.antenna:
        cmd.extend(["--antennas", args.antenna])
    if args.bchan is not None:
        cmd.extend(["--bchan", str(args.bchan)])
    if args.echan is not None:
        cmd.extend(["--echan", str(args.echan)])
    if args.use_flags:
        cmd.append("--use-flags")
    if args.flagver is not None:
        cmd.extend(["--flagver", str(args.flagver)])

    print("Creating missing NPZ with gdp-stats:")
    print("$ " + " ".join(cmd))
    if args.dry_run:
        return path
    subprocess.run(cmd, cwd=str(project_root()), check=True)
    if not path.exists():
        raise FileNotFoundError(f"gdp-stats completed but expected product is missing: {path}")
    return path


def ensure_npzs(product: str, mode: str, args: argparse.Namespace, scans: Optional[List[int]]) -> List[Tuple[str, Path]]:
    if args.npz_path:
        path = Path(args.npz_path).expanduser().resolve()
        if not path.exists():
            raise FileNotFoundError(f"--npz-path does not exist: {path}")
        print(f"Using supplied NPZ for {product.replace('_', '-')}: {path}")
        return [(label_from_npz_path(path, product, mode), path)]

    if args.combine_scans:
        label = scan_text(scans)
        return [(label_with_channel(label, mode, args.bchan, args.echan), ensure_npz(product, mode, args, scans, label))]

    if scans is not None:
        labels = [f"scan{int(scan)}" for scan in scans]
        existing = [(label_with_channel(label, mode, args.bchan, args.echan), default_product_path(product, mode, label, args.bchan, args.echan)) for label in labels]
    else:
        existing = discover_scan_products(product, mode, args.bchan, args.echan)
        labels = [label for label, _ in existing]
    if existing and not args.recompute and all(path.exists() for _, path in existing):
        for _, path in existing:
            print(f"Using existing {product_message_name(product)}: {path}")
        return existing

    smode = {
        "gain_colormap": "gains",
        "gain_hist": "gains",
        "reim": "gains",
        "antenna": "gains",
        "stats": "gains",
        "ks": "ks",
        "self_corr_colormap": "self-corr",
        "self_corr_antenna": "self-corr",
        "cross_corr_colormap": "cross-corr",
    }[product]
    cmd = [str(script_dir() / "gdp-stats"), "--mode", mode, "--smode", smode]
    if args.setup_file:
        cmd.extend(["--setup-file", args.setup_file])
    if args.input_table:
        cmd.extend(["--input-table", args.input_table])
    elif mode == "bandpass" and args.bandpass_table:
        cmd.extend(["--bandpass-table", args.bandpass_table])
    elif mode == "gain" and args.gain_table:
        cmd.extend(["--gain-table", args.gain_table])
    if scans is not None:
        cmd.extend(["--scan", ",".join(str(s) for s in scans)])
    if args.antenna:
        cmd.extend(["--antennas", args.antenna])
    if args.bchan is not None:
        cmd.extend(["--bchan", str(args.bchan)])
    if args.echan is not None:
        cmd.extend(["--echan", str(args.echan)])
    if args.use_flags:
        cmd.append("--use-flags")
    if args.flagver is not None:
        cmd.extend(["--flagver", str(args.flagver)])

    print("Creating missing per-scan NPZ products with gdp-stats:")
    print("$ " + " ".join(cmd))
    if args.dry_run:
        return existing
    subprocess.run(cmd, cwd=str(project_root()), check=True)

    if scans is not None:
        result = [(label_with_channel(label, mode, args.bchan, args.echan), default_product_path(product, mode, label, args.bchan, args.echan)) for label in labels]
    else:
        result = discover_scan_products(product, mode, args.bchan, args.echan)
    missing = [str(path) for _, path in result if not path.exists()]
    if missing:
        raise FileNotFoundError(f"Missing expected per-scan products: {missing}")
    if not result:
        raise FileNotFoundError(f"No per-scan {product} products found after running gdp-stats.")
    return result


def load_npz(path: Path) -> Dict[str, np.ndarray]:
    with np.load(path, allow_pickle=True) as data:
        loaded = {key: data[key] for key in data.files}
    if APPLY_FLAG_FILES and path.suffix != ".flg" and {"real", "imag", "row", "stokes", "channel"}.issubset(loaded):
        return apply_flag_file_to_gains(loaded, path, ACTIVE_FLAGVER)
    return loaded


def parse_flag_version(value: Optional[str]) -> Optional[int]:
    if value is None:
        return None
    text = str(value).strip()
    if text.lower().startswith("v"):
        text = text[1:]
    if not text.isdigit() or int(text) < 1:
        raise SystemExit("--flagver must be a positive integer version number.")
    return int(text)


def flag_file_for_npz(npz_path: Path, version: int) -> Path:
    return npz_path.with_name(f"{npz_path.stem}_V{int(version)}.flg")


def flag_file_versions(npz_path: Path) -> List[Tuple[int, Path]]:
    versions: List[Tuple[int, Path]] = []
    for path in npz_path.parent.glob(f"{npz_path.stem}_V*.flg"):
        match = re.fullmatch(rf"{re.escape(npz_path.stem)}_V(\d+)\.flg", path.name)
        if match:
            versions.append((int(match.group(1)), path))
    return sorted(versions, key=lambda item: item[0])


def resolve_flag_file(npz_path: Path, flagver: Optional[int]) -> Tuple[int, Path]:
    if flagver is not None:
        path = flag_file_for_npz(npz_path, flagver)
        if not path.exists():
            raise SystemExit(f"ERROR: requested flag version V{int(flagver)} does not exist: {path}")
        return flagver, path
    versions = flag_file_versions(npz_path)
    if not versions:
        raise SystemExit(f"ERROR: no flag versions found for {npz_path}. Run gdp-stats --smode gains first.")
    return versions[-1]


def apply_flag_file_to_gains(z: Dict[str, np.ndarray], npz_path: Path, flagver: Optional[int]) -> Dict[str, np.ndarray]:
    required = {"row", "stokes", "channel"}
    if not required.issubset(z):
        return z
    version, flag_path = resolve_flag_file(npz_path, flagver)
    flag_data = load_npz(flag_path)
    missing = {"row", "stokes", "channel", "flag"} - set(flag_data)
    if missing:
        raise RuntimeError(f"{flag_path} missing arrays: {sorted(missing)}")
    lookup = {
        (int(row), int(pol), int(chan)): bool(flag)
        for row, pol, chan, flag in zip(
            np.asarray(flag_data["row"], dtype=int),
            np.asarray(flag_data["stokes"], dtype=int),
            np.asarray(flag_data["channel"], dtype=int),
            np.asarray(flag_data["flag"], dtype=bool),
        )
    }
    flags = np.asarray(
        [
            lookup.get((int(row), int(pol), int(chan)), False)
            for row, pol, chan in zip(
                np.asarray(z["row"], dtype=int),
                np.asarray(z["stokes"], dtype=int),
                np.asarray(z["channel"], dtype=int),
            )
        ],
        dtype=bool,
    )
    out = dict(z)
    out["flagged"] = flags
    print(f"Using flag file V{version}: {flag_path}")
    return out


def filter_antennas(values: np.ndarray, antennas: Optional[List[int]]) -> np.ndarray:
    if antennas is None:
        return np.asarray(values)
    values = np.asarray(values)
    return values[np.isin(values, np.asarray(antennas, dtype=values.dtype))]


def plot_channel_mask(channels: np.ndarray, pchans: Optional[Tuple[int, int]], context: str) -> np.ndarray:
    channels = np.asarray(channels, dtype=int)
    if pchans is None:
        return np.ones(channels.shape, dtype=bool)
    mask = (channels >= int(pchans[0])) & (channels < int(pchans[1]))
    if not np.any(mask):
        raise ValueError(f"No channels in {context} match -pchans [{int(pchans[0])}, {int(pchans[1])}).")
    return mask


def pchan_title_text(pchans: Optional[Tuple[int, int]]) -> str:
    if pchans is None:
        return ""
    return f" | PChans: {int(pchans[0])}-{int(pchans[1]) - 1}"


def colorbar_ticks_7(limit: float) -> np.ndarray:
    limit = float(limit)
    if not np.isfinite(limit) or limit <= 0:
        limit = 15.0
    limit = float(max(15, int(math.ceil(limit / 5.0)) * 5))
    candidates = [value for value in range(5, int(limit), 5)]
    if len(candidates) >= 2:
        inner = [candidates[len(candidates) // 3], candidates[(2 * len(candidates)) // 3]]
    elif len(candidates) == 1:
        inner = [candidates[0], candidates[0]]
    else:
        inner = [limit, limit]
    return np.asarray([-limit, -inner[1], -inner[0], 0.0, inner[0], inner[1], limit], dtype=float)


def apply_style(ax: Any, title: str, xlabel: str = "", ylabel: str = "") -> None:
    ax.set_title(title)
    ax.set_xlabel(xlabel)
    ax.set_ylabel(ylabel)
    ax.grid(False)


def save_figure(fig: Any, path: Path) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fig.tight_layout()
    fig.savefig(path, dpi=DEFAULT_PLOT_DPI, bbox_inches="tight")
    plt.close(fig)
    print(f"Wrote plot: {path}")


def plot_gain_colormap(
    npz_path: Path,
    out: Path,
    antennas: Optional[List[int]],
    mode: str,
    pchans: Optional[Tuple[int, int]] = None,
    plot_range: Optional[float] = None,
) -> None:
    z = load_npz(npz_path)
    required = {"scan", "antenna", "stokes", "channel", "real", "imag"}
    missing = required - set(z)
    if missing:
        raise ValueError(f"{npz_path} missing arrays: {sorted(missing)}")

    ant_all = filter_antennas(np.unique(z["antenna"]).astype(int), antennas)
    stokes_all = np.unique(z["stokes"]).astype(int)
    if ant_all.size == 0 or stokes_all.size == 0:
        raise ValueError("No antennas/stokes available for gain colormap.")
    chan_arr_all = z["channel"].astype(int)
    pchan_mask = plot_channel_mask(chan_arr_all, pchans, str(npz_path))

    header = {}
    if "header_json" in z:
        try:
            header = json.loads(str(np.asarray(z["header_json"]).item()))
        except Exception:
            header = {}
    table_name = Path(str(header.get("input_table", "gain table"))).name
    if not table_name:
        table_name = "gain table"

    if mode == "bandpass":
        x_key = "channel"
        x_values = np.unique(z[x_key][pchan_mask]).astype(int)
        chan_freq_arr = z["channel_freq_hz"].astype(float) if "channel_freq_hz" in z else np.full(chan_arr_all.shape, np.nan)
        chan_width_arr = z["channel_width_hz"].astype(float) if "channel_width_hz" in z else np.full(chan_arr_all.shape, np.nan)
        freq_by_chan = np.full(x_values.shape, np.nan, dtype=float)
        width_by_chan = np.full(x_values.shape, np.nan, dtype=float)
        for idx, chan in enumerate(x_values):
            selector = (chan_arr_all == int(chan)) & pchan_mask
            freqs = chan_freq_arr[selector]
            widths = chan_width_arr[selector]
            if freqs.size and np.any(np.isfinite(freqs)):
                freq_by_chan[idx] = float(np.nanmedian(freqs))
            if widths.size and np.any(np.isfinite(widths)):
                width_by_chan[idx] = float(np.nanmedian(np.abs(widths)))
        if np.any(np.isfinite(freq_by_chan)):
            y_centers = freq_by_chan / 1.0e6
            finite_widths = width_by_chan[np.isfinite(width_by_chan) & (width_by_chan > 0)]
            delta_nu_mhz = float(np.nanmedian(finite_widths) / 1.0e6) if finite_widths.size else np.nan
            if not np.isfinite(delta_nu_mhz) or delta_nu_mhz <= 0:
                diffs = np.diff(y_centers[np.isfinite(y_centers)])
                delta_nu_mhz = float(np.nanmedian(np.abs(diffs[diffs != 0]))) if diffs.size else 1.0
            y_centers[~np.isfinite(y_centers)] = np.arange(np.count_nonzero(~np.isfinite(y_centers)), dtype=float)
        else:
            y_centers = np.arange(len(x_values), dtype=float)
            delta_nu_mhz = np.nan
        y_edges = np.empty(len(x_values) + 1, dtype=float)
        if len(x_values) == 1:
            half = 0.5 * (delta_nu_mhz if np.isfinite(delta_nu_mhz) and delta_nu_mhz > 0 else 1.0)
            y_edges[0] = y_centers[0] - half
            y_edges[1] = y_centers[0] + half
        else:
            y_edges[1:-1] = 0.5 * (y_centers[:-1] + y_centers[1:])
            y_edges[0] = y_centers[0] - 0.5 * (y_centers[1] - y_centers[0])
            y_edges[-1] = y_centers[-1] + 0.5 * (y_centers[-1] - y_centers[-2])
        y_labels = [f"{float(v):.0f}" for v in y_centers]
        channel_row_labels = [str(int(v)) for v in x_values]
        x_label = r"$\nu$ (MHz)"
    elif "time" in z:
        x_key = "time"
        raw_times = z[x_key].astype(float)
        x_values = np.unique(raw_times[np.isfinite(raw_times)])
        t0 = float(np.nanmin(x_values)) if x_values.size else 0.0
        elapsed_centers = x_values - t0
        y_centers = elapsed_centers.copy()
        interval_arr = z["interval"].astype(float) if "interval" in z else np.full(raw_times.shape, np.nan)
        intervals = np.full(x_values.shape, np.nan, dtype=float)
        for idx, tv in enumerate(x_values):
            vals = interval_arr[np.isfinite(interval_arr) & (raw_times == tv) & (interval_arr > 0)]
            if vals.size:
                intervals[idx] = float(np.nanmedian(vals))
        fallback = np.diff(y_centers)
        fallback_dt = float(np.nanmedian(fallback[fallback > 0])) if np.any(fallback > 0) else 1.0
        intervals[~np.isfinite(intervals) | (intervals <= 0)] = fallback_dt
        y_edges = np.empty(len(x_values) + 1, dtype=float)
        y_edges[0] = y_centers[0] - 0.5 * intervals[0]
        y_edges[1:] = y_centers + 0.5 * intervals
        if y_edges[0] < 0:
            shift = y_edges[0]
            y_edges = y_edges - shift
            y_centers = y_centers - shift
        y_labels = [f"{v:.0f}" for v in elapsed_centers]
        delta_t = float(np.nanmedian(intervals[np.isfinite(intervals) & (intervals > 0)])) if np.any(np.isfinite(intervals) & (intervals > 0)) else fallback_dt
        time_row_labels = [str(int(round(v / delta_t))) if np.isfinite(delta_t) and delta_t > 0 else str(i) for i, v in enumerate(elapsed_centers)]
        x_label = "Time (s)"
    else:
        x_key = "row"
        x_values = np.unique(z[x_key]).astype(int)
        y_edges = None
        y_labels = [str(int(v)) for v in x_values]
        time_row_labels = []
        delta_t = np.nan
        x_label = "Table row"
    if mode == "bandpass":
        time_row_labels = []
        delta_t = np.nan
    if x_values.size == 0:
        raise ValueError("No x-axis values available for gain colormap.")

    nrows = len(stokes_all)
    fig_height = max(6.0, 3.0 * nrows)
    fig = plt.figure(figsize=(fig_height * 4.0 / 3.0, fig_height))
    grid = fig.add_gridspec(nrows, 4, width_ratios=[1.0, 1.0, 0.32, 0.055], wspace=0.10, hspace=0.34)
    axes = np.asarray([[fig.add_subplot(grid[row, col]) for col in range(2)] for row in range(nrows)])
    cax = fig.add_subplot(grid[:, 3])
    cmap = plt.get_cmap("coolwarm").copy()
    cmap.set_bad(color="white")
    stokes_data: Dict[int, Tuple[np.ma.MaskedArray, np.ma.MaskedArray]] = {}
    scale_values: List[np.ndarray] = []

    ant_arr = z["antenna"].astype(int)
    stokes_arr = z["stokes"].astype(int)
    x_arr = z[x_key].astype(float if x_key == "time" else int)
    real_arr = z["real"].astype(float)
    imag_arr = z["imag"].astype(float)
    flagged_arr = z["flagged"].astype(bool) if "flagged" in z else np.zeros(real_arr.shape, dtype=bool)

    for stokes in stokes_all:
        real_mat = np.full((len(x_values), len(ant_all)), np.nan, dtype=float)
        imag_mat = np.full((len(x_values), len(ant_all)), np.nan, dtype=float)
        flag_mask = np.ones(real_mat.shape, dtype=bool)
        for ai, ant in enumerate(ant_all):
            for xi, xv in enumerate(x_values):
                selector = (ant_arr == ant) & (stokes_arr == stokes) & (x_arr == xv)
                if not np.any(selector):
                    continue
                valid = selector & pchan_mask & ~flagged_arr
                rvals = (real_arr[valid] - 1.0) * 100.0
                ivals = imag_arr[valid] * 100.0
                if rvals.size or ivals.size:
                    real_mat[xi, ai] = float(np.nanmean(rvals)) if rvals.size else np.nan
                    imag_mat[xi, ai] = float(np.nanmean(ivals)) if ivals.size else np.nan
                    flag_mask[xi, ai] = not (np.isfinite(real_mat[xi, ai]) or np.isfinite(imag_mat[xi, ai]))
        real_masked = np.ma.array(real_mat, mask=flag_mask | ~np.isfinite(real_mat))
        imag_masked = np.ma.array(imag_mat, mask=flag_mask | ~np.isfinite(imag_mat))
        stokes_data[int(stokes)] = (real_masked, imag_masked)
        if real_masked.count():
            scale_values.append(np.abs(real_masked.compressed()))
        if imag_masked.count():
            scale_values.append(np.abs(imag_masked.compressed()))

    if scale_values:
        vmax = float(np.nanmax(np.concatenate(scale_values)))
    else:
        vmax = 1.0
    if plot_range is not None:
        vmax = float(plot_range)
    if not np.isfinite(vmax) or vmax <= 0:
        vmax = 1.0
    vmax = float(max(15, int(math.ceil(vmax / 5.0)) * 5))
    vmin = -vmax

    def skew(values: np.ndarray) -> float:
        vals = values[np.isfinite(values)]
        if vals.size < 3:
            return np.nan
        mu = float(np.mean(vals))
        sigma = float(np.std(vals))
        return np.nan if sigma <= 0 else float(np.mean(((vals - mu) / sigma) ** 3))

    def kurt(values: np.ndarray) -> float:
        vals = values[np.isfinite(values)]
        if vals.size < 4:
            return np.nan
        mu = float(np.mean(vals))
        sigma = float(np.std(vals))
        return np.nan if sigma <= 0 else float(np.mean(((vals - mu) / sigma) ** 4) - 3.0)

    def stats_text(values: np.ma.MaskedArray) -> str:
        vals = values.compressed()
        if vals.size == 0:
            return "mean=nan std=nan skew=nan kurt=nan"
        return f"mean={np.nanmean(vals):.1f} std={np.nanstd(vals):.1f} skew={skew(vals):.1f} kurt={kurt(vals):.1f}"

    for ri, stokes in enumerate(stokes_all):
        real_masked, imag_masked = stokes_data[int(stokes)]
        for ci, (label, data) in enumerate([("Real-1", real_masked), ("Imag", imag_masked)]):
            ax = axes[ri, ci]
            if y_edges is not None:
                im = ax.pcolormesh(np.arange(len(ant_all) + 1), y_edges, data, cmap=cmap, vmin=vmin, vmax=vmax, shading="auto")
            else:
                im = ax.pcolormesh(data, cmap=cmap, vmin=vmin, vmax=vmax, shading="auto")
            ax.set_title(f"Stokes {stokes} {label}\n{stats_text(data)}", fontsize=8)
            ax.set_xlim(0, len(ant_all))
            ax.set_ylim(float(y_edges[0]), float(y_edges[-1])) if y_edges is not None else ax.set_ylim(0, len(x_values))
            ax.set_xticks(np.arange(len(ant_all)) + 0.5)
            ax.set_xticklabels([str(a) if i % 2 == 0 or i == len(ant_all) - 1 else "" for i, a in enumerate(ant_all)], fontsize=6)
            nticks = min(6, len(x_values))
            tick_idx = np.unique(np.linspace(0, len(x_values) - 1, nticks, dtype=int))
            ax.set_yticks(y_centers[tick_idx] if y_edges is not None else tick_idx + 0.5)
            ax.set_yticklabels([y_labels[i] for i in tick_idx], fontsize=6)
            ax.set_ylabel(x_label if ci == 0 else "", fontsize=8)
            if ci == 1 and mode == "bandpass":
                tax = ax.twinx()
                tax.set_ylim(ax.get_ylim())
                tax.set_yticks(y_centers[tick_idx])
                tax.set_yticklabels([channel_row_labels[i] for i in tick_idx], fontsize=6)
                tax.set_ylabel("Channel", fontsize=8, labelpad=10)
                tax.tick_params(axis="y", labelsize=6)
            if ci == 1 and x_key == "time":
                tax = ax.twinx()
                tax.set_ylim(ax.get_ylim())
                tax.set_yticks(y_centers[tick_idx])
                tax.set_yticklabels([time_row_labels[i] for i in tick_idx], fontsize=6)
                tax.set_ylabel("Time row", fontsize=8, labelpad=10)
                tax.tick_params(axis="y", labelsize=6)
            if ri == nrows - 1:
                ax.set_xlabel("Antenna", fontsize=8)
            ax.tick_params(axis="both", labelsize=6)
            if ci == 1 and (x_key == "time" or mode == "bandpass"):
                ax.tick_params(axis="y", left=False, labelleft=False)
    cbar = fig.colorbar(im, cax=cax, orientation="vertical")
    cbar.ax.set_title("Percent", fontsize=8, pad=6)
    cbar.ax.yaxis.set_ticks_position("left")
    cbar.ax.tick_params(labelsize=6, labelleft=True, labelright=False)
    ticks = colorbar_ticks_7(vmax)
    cbar.set_ticks(ticks)
    cbar.set_ticklabels([f"{tick:.0f}" for tick in ticks])
    scans = np.unique(z["scan"].astype(int))
    scan_label = str(int(scans[0])) if scans.size == 1 else "allscans"
    dt_text = f" | $\\Delta t$ = {delta_t:.2f} s" if np.isfinite(delta_t) else ""
    dnu_text = f" | $\\Delta \\nu$ = {delta_nu_mhz * 1000.0:.2f} kHz" if mode == "bandpass" and np.isfinite(delta_nu_mhz) else ""
    fig.suptitle(f"Gain Table: {table_name} | Scan: {scan_label}{dt_text}{dnu_text}{pchan_title_text(pchans)}", fontsize=12)
    out.parent.mkdir(parents=True, exist_ok=True)
    fig.subplots_adjust(top=0.88)
    fig.savefig(out, dpi=DEFAULT_PLOT_DPI)
    plt.close(fig)
    print(f"Wrote plot: {out}")


def compact_number(value: float) -> str:
    if not np.isfinite(value):
        return "nan"
    if value == 0:
        return "0"
    abs_value = abs(value)
    if abs_value >= 1000 or abs_value < 0.01:
        return f"{value:.1e}"
    return f"{value:.3g}"


def factor_two_levels(max_value: float, start: float = 0.25) -> np.ndarray:
    if not np.isfinite(max_value) or max_value <= start:
        return np.asarray([start], dtype=float)
    levels = [float(start)]
    while levels[-1] * 2.0 <= max_value * (1.0 + 1e-12):
        levels.append(levels[-1] * 2.0)
    return np.asarray(levels, dtype=float)


def gain_product_header(z: Dict[str, np.ndarray]) -> Dict[str, Any]:
    if "header_json" not in z:
        return {}
    try:
        return json.loads(str(np.asarray(z["header_json"]).item()))
    except Exception:
        return {}


def sample_stats_text(values: np.ndarray) -> str:
    vals = np.asarray(values, dtype=float)
    vals = vals[np.isfinite(vals)]
    if vals.size == 0:
        return "mean=nan std=nan skew=nan kurt=nan"
    mean = float(np.mean(vals))
    std = float(np.std(vals))
    if vals.size < 3 or std <= 0:
        skew = np.nan
    else:
        skew = float(np.mean(((vals - mean) / std) ** 3))
    if vals.size < 4 or std <= 0:
        kurt = np.nan
    else:
        kurt = float(np.mean(((vals - mean) / std) ** 4) - 3.0)
    return f"mean={mean:.1f} std={std:.1f} skew={skew:.1f} kurt={kurt:.1f}"


def axis_limit_pair(real: np.ndarray, imag: np.ndarray) -> Tuple[float, float, float, float]:
    real = np.asarray(real, dtype=float)
    imag = np.asarray(imag, dtype=float)
    finite_real = real[np.isfinite(real)]
    finite_imag = imag[np.isfinite(imag)]
    if finite_real.size:
        xmin, xmax = float(np.nanmin(finite_real)), float(np.nanmax(finite_real))
    else:
        xmin, xmax = -1.0, 1.0
    if finite_imag.size:
        ymin, ymax = float(np.nanmin(finite_imag)), float(np.nanmax(finite_imag))
    else:
        ymin, ymax = -1.0, 1.0
    if xmin == xmax:
        xmin, xmax = xmin - 1.0, xmax + 1.0
    if ymin == ymax:
        ymin, ymax = ymin - 1.0, ymax + 1.0
    xpad = 0.06 * (xmax - xmin)
    ypad = 0.06 * (ymax - ymin)
    return xmin - xpad, xmax + xpad, ymin - ypad, ymax + ypad


def gaussian_one_point_ellipse(real: np.ndarray, imag: np.ndarray) -> Optional[Tuple[float, float, float, float]]:
    npoint = int(np.count_nonzero(np.isfinite(real) & np.isfinite(imag)))
    if npoint < 2:
        return None
    xmean = float(np.nanmean(real))
    ymean = float(np.nanmean(imag))
    xstd = float(np.nanstd(real))
    ystd = float(np.nanstd(imag))
    if not all(np.isfinite(v) for v in (xmean, ymean, xstd, ystd)) or xstd <= 0.0 or ystd <= 0.0:
        return None
    radius = math.sqrt(2.0 * math.log(float(npoint)))
    return xmean, ymean, 2.0 * radius * xstd, 2.0 * radius * ystd


def add_gaussian_one_point_ellipse(ax: Any, ellipse_spec: Optional[Tuple[float, float, float, float]]) -> None:
    if ellipse_spec is None:
        return
    xmean, ymean, width, height = ellipse_spec
    ax.add_patch(
        Ellipse(
            (xmean, ymean),
            width=width,
            height=height,
            angle=0.0,
            fill=False,
            edgecolor="red",
            linestyle="--",
            linewidth=2.0,
        )
    )


def log_count_levels(max_count: float, nlevels: int = 7, start: float = 1.0) -> np.ndarray:
    if not np.isfinite(max_count) or max_count <= 0:
        max_count = start
    high = max(start * 10.0, float(max_count))
    exponent = math.floor(math.log10(high))
    scale = 10.0 ** exponent
    mantissa = high / scale
    for nice in (1.0, 2.0, 5.0, 10.0):
        if mantissa <= nice:
            high = nice * scale
            break
    levels = np.rint(np.geomspace(start, high, nlevels)).astype(float)
    levels = np.maximum(levels, start)
    return np.unique(levels)


def count_tick_label(value: float) -> str:
    return f"{int(round(value))}"


def points_outside_ellipse(
    real: np.ndarray,
    imag: np.ndarray,
    ellipse_spec: Optional[Tuple[float, float, float, float]],
) -> np.ndarray:
    if ellipse_spec is None:
        return np.zeros(np.asarray(real).shape, dtype=bool)
    xmean, ymean, width, height = ellipse_spec
    xrad = 0.5 * width
    yrad = 0.5 * height
    if xrad <= 0.0 or yrad <= 0.0:
        return np.zeros(np.asarray(real).shape, dtype=bool)
    return (((real - xmean) / xrad) ** 2 + ((imag - ymean) / yrad) ** 2) > 1.0


def ellipse_radius(ellipse_spec: Optional[Tuple[float, float, float, float]]) -> float:
    if ellipse_spec is None:
        return 0.0
    _, _, width, height = ellipse_spec
    return 0.5 * max(float(width), float(height))


def shared_reim_axis_limit(panel_specs: Sequence[Tuple[int, np.ndarray, np.ndarray, Optional[Tuple[float, float, float, float]]]]) -> float:
    radii = [ellipse_radius(spec) for _, _, _, spec in panel_specs]
    limit = 1.5 * max(radii, default=0.0)
    if not np.isfinite(limit) or limit <= 0.0:
        finite_values: List[np.ndarray] = []
        for _, real, imag, _ in panel_specs:
            if real.size:
                finite_values.append(np.abs(real[np.isfinite(real)]))
            if imag.size:
                finite_values.append(np.abs(imag[np.isfinite(imag)]))
        limit = float(np.nanmax(np.concatenate(finite_values))) if finite_values else 1.0
    return max(1.0, min(100.0, float(limit)))


def add_outside_ellipse_text(ax: Any, outside_count: int, total_count: int) -> None:
    ax.text(
        0.03,
        0.94,
        f"Outside ellipse: {outside_count}/{total_count}",
        transform=ax.transAxes,
        ha="left",
        va="top",
        fontsize=7,
        color="black",
        bbox={"facecolor": "white", "edgecolor": "0.65", "alpha": 0.78, "pad": 2.0},
    )


def antenna_range_pair(text: Optional[str]) -> Optional[Tuple[int, int]]:
    if text is None:
        return None
    value = normalize_list_text(text).strip()
    if not ((value.startswith("(") and value.endswith(")")) or (value.startswith("[") and value.endswith("]"))):
        return None
    parts = [part.strip() for part in value[1:-1].split(",") if part.strip()]
    if len(parts) != 2:
        return None
    try:
        return int(parts[0]), int(parts[1])
    except ValueError:
        return None


def antenna_selection_tag_parts(text: Optional[str]) -> Optional[List[str]]:
    if text is None or normalize_list_text(text).strip() == "":
        return None
    parts: List[str] = []
    for token in antenna_tokens(text):
        value = token.strip()
        if (value.startswith("(") and value.endswith(")")) or (value.startswith("[") and value.endswith("]")):
            value = value[1:-1].strip()
        if "," in value:
            range_parts = [part.strip() for part in value.split(",") if part.strip()]
            if len(range_parts) == 2:
                parts.append(f"{int(range_parts[0])}-{int(range_parts[1])}")
                continue
        if "-" in value and not value.startswith("-"):
            range_parts = [part.strip() for part in value.split("-", 1) if part.strip()]
            if len(range_parts) == 2:
                parts.append(f"{int(range_parts[0])}-{int(range_parts[1])}")
                continue
        parts.append(str(int(value)))
    return parts


def antenna_selection_title_parts(text: Optional[str]) -> Optional[List[str]]:
    tag_parts = antenna_selection_tag_parts(text)
    if not tag_parts:
        return None
    title_parts: List[str] = []
    for part in tag_parts:
        if "-" in part and not part.startswith("-"):
            title_parts.append(f"[{part}]")
        else:
            title_parts.append(part)
    return title_parts


def antenna_selection_tag(antennas: Optional[List[int]], selected: np.ndarray, antenna_text: Optional[str] = None) -> str:
    if antennas is None:
        return "allants"
    parts = antenna_selection_tag_parts(antenna_text)
    if parts:
        return "ants" + "_".join(parts)
    return "ants" + "_".join(str(int(ant)) for ant in selected)


def antenna_selection_title(antennas: Optional[List[int]], selected: np.ndarray, antenna_text: Optional[str] = None) -> str:
    if antennas is None:
        return f"all antennas ({len(selected)})"
    parts = antenna_selection_title_parts(antenna_text)
    if parts:
        return " ".join(parts)
    return " ".join(str(int(ant)) for ant in selected)


def plot_reim_products(
    npz_path: Path,
    out_base: Path,
    antennas: Optional[List[int]],
    mode: str,
    pchans: Optional[Tuple[int, int]] = None,
    antenna_text: Optional[str] = None,
) -> List[Path]:
    z = load_npz(npz_path)
    required = {"scan", "antenna", "stokes", "channel", "real", "imag"}
    missing = required - set(z)
    if missing:
        raise ValueError(f"{npz_path} missing arrays: {sorted(missing)}")

    available_antennas = np.unique(z["antenna"]).astype(int)
    ant_all = filter_antennas(available_antennas, antennas)
    stokes_all = np.unique(z["stokes"]).astype(int)
    if ant_all.size == 0:
        print("SKIP reim plots: none of the requested antennas are present in the gains NPZ.")
        return []
    if antennas is not None:
        missing_ants = [int(ant) for ant in antennas if int(ant) not in set(int(a) for a in ant_all)]
        for ant in missing_ants:
            print(f"SKIP reim antenna {ant}: antenna is not present in the gains NPZ.")
    if stokes_all.size == 0:
        print("SKIP reim plots: no Stokes values are present in the gains NPZ.")
        return []

    header = gain_product_header(z)
    table_name = Path(str(header.get("input_table", "gain table"))).name or "gain table"
    scans = np.unique(z["scan"].astype(int))
    scan_label = str(int(scans[0])) if scans.size == 1 else "allscans"
    ant_arr = z["antenna"].astype(int)
    stokes_arr = z["stokes"].astype(int)
    chan_arr = z["channel"].astype(int)
    real_arr = z["real"].astype(float)
    imag_arr = z["imag"].astype(float)
    flagged_arr = z["flagged"].astype(bool) if "flagged" in z else np.zeros(real_arr.shape, dtype=bool)
    pchan_mask = plot_channel_mask(chan_arr, pchans, str(npz_path))

    panels: List[Tuple[int, np.ndarray, np.ndarray]] = []
    for stokes in stokes_all:
        selector = np.isin(ant_arr, ant_all) & (stokes_arr == int(stokes)) & pchan_mask & ~flagged_arr
        real_vals = (real_arr[selector] - 1.0) * 100.0
        imag_vals = imag_arr[selector] * 100.0
        finite = np.isfinite(real_vals) & np.isfinite(imag_vals)
        panels.append((int(stokes), real_vals[finite], imag_vals[finite]))

    if not any(real_vals.size for _, real_vals, _ in panels):
        print("SKIP reim plot: selected antennas/stokes have no finite unflagged real/imag pairs.")
        return []

    panel_specs = [
        (stokes, real_vals, imag_vals, gaussian_one_point_ellipse(real_vals, imag_vals) if real_vals.size else None)
        for stokes, real_vals, imag_vals in panels
    ]
    axis_limit = shared_reim_axis_limit(panel_specs)

    out_base.parent.mkdir(parents=True, exist_ok=True)
    ncols = len(panel_specs)
    fig_width = max(7.2, 3.6 * ncols)
    fig, axes = plt.subplots(2, ncols, figsize=(fig_width, fig_width * 3.0 / 4.0), squeeze=False)
    for ci, (stokes, real_vals, imag_vals, ellipse_spec) in enumerate(panel_specs):
        ax_scatter = axes[0, ci]
        ax_density = axes[1, ci]
        if real_vals.size == 0:
            title = f"Stokes {stokes}\nRe-1: mean=nan std=nan skew=nan kurt=nan\nIm: mean=nan std=nan skew=nan kurt=nan"
            ax_scatter.set_title(title, fontsize=7)
            ax_scatter.text(0.5, 0.5, "No finite data", ha="center", va="center", transform=ax_scatter.transAxes, fontsize=8)
            ax_density.text(0.5, 0.5, "No finite data", ha="center", va="center", transform=ax_density.transAxes, fontsize=8)
        else:
            xmean = float(np.nanmean(real_vals))
            ymean = float(np.nanmean(imag_vals))
            xmin, xmax, ymin, ymax = -axis_limit, axis_limit, -axis_limit, axis_limit
            visible = (real_vals >= xmin) & (real_vals <= xmax) & (imag_vals >= ymin) & (imag_vals <= ymax)
            outside_ellipse = points_outside_ellipse(real_vals, imag_vals, ellipse_spec)
            outside_count = int(np.count_nonzero(outside_ellipse))
            title = (
                f"Stokes {stokes}\n"
                f"Re-1: {sample_stats_text(real_vals)}\n"
                f"Im: {sample_stats_text(imag_vals)}"
            )

            ax = ax_scatter
            ax.scatter(real_vals, imag_vals, s=8, alpha=0.55, color="tab:blue", edgecolors="none")
            ax.axvline(xmean, color="black", linestyle="--", linewidth=1.2)
            ax.axhline(ymean, color="black", linestyle="--", linewidth=1.2)
            add_gaussian_one_point_ellipse(ax, ellipse_spec)
            ax.set_xlim(xmin, xmax)
            ax.set_ylim(ymin, ymax)
            ax.set_title(title, fontsize=7)
            ax.grid(True, linestyle=":", linewidth=0.6, alpha=0.55)
            add_outside_ellipse_text(ax, outside_count, int(real_vals.size))

            ax = ax_density
            bins = 48
            counts, xedges, yedges = np.histogram2d(real_vals[visible], imag_vals[visible], bins=bins, range=[[xmin, xmax], [ymin, ymax]])
            density = counts.T
            count_ticks = log_count_levels(float(np.nanmax(density)) if density.size else 0.0)
            log_vmin = float(np.log10(count_ticks[0]))
            log_vmax = float(np.log10(count_ticks[-1]))
            log_density = np.full_like(density, np.nan, dtype=float)
            positive_mask = density > 0
            log_density[positive_mask] = np.log10(density[positive_mask])
            masked = np.ma.array(log_density, mask=~np.isfinite(log_density))
            im = ax.pcolormesh(xedges, yedges, masked, cmap="viridis", shading="auto", vmin=log_vmin, vmax=log_vmax)
            positive = log_density[np.isfinite(log_density)]
            if positive.size and np.nanmax(positive) > np.nanmin(positive):
                levels = np.log10(count_ticks[(count_ticks > 1.0) & (count_ticks <= float(np.nanmax(density)))])
                if levels.size < 2:
                    levels = np.linspace(float(np.nanmin(positive)), float(np.nanmax(positive)), 5)[1:]
                xcenters = 0.5 * (xedges[:-1] + xedges[1:])
                ycenters = 0.5 * (yedges[:-1] + yedges[1:])
                ax.contour(xcenters, ycenters, log_density, levels=levels, colors="white", linewidths=0.7, alpha=0.85)
            ax.axvline(xmean, color="black", linestyle="--", linewidth=1.2)
            ax.axhline(ymean, color="black", linestyle="--", linewidth=1.2)
            add_gaussian_one_point_ellipse(ax, ellipse_spec)
            ax.set_xlim(xmin, xmax)
            ax.set_ylim(ymin, ymax)
            ax.grid(False)
            add_outside_ellipse_text(ax, outside_count, int(real_vals.size))
            cbar = fig.colorbar(im, ax=ax, fraction=0.046, pad=0.025)
            cbar.ax.tick_params(labelsize=6)
            cbar.set_ticks(np.log10(count_ticks))
            cbar.set_ticklabels([count_tick_label(level) for level in count_ticks])
            cbar.set_label("Points", fontsize=7)

        if ci == 0:
            axes[0, ci].set_ylabel("Imag [%]")
            axes[1, ci].set_ylabel("Imag [%]")
        else:
            axes[0, ci].tick_params(axis="y", left=False, labelleft=False)
            axes[1, ci].tick_params(axis="y", left=False, labelleft=False)
        axes[1, ci].set_xlabel("Real-1 [%]")
        axes[0, ci].tick_params(axis="both", labelsize=7)
        axes[1, ci].tick_params(axis="both", labelsize=7)

    ant_title = antenna_selection_title(antennas, ant_all, antenna_text)
    fig.suptitle(f"Gain Table: {table_name} | Scan: {scan_label}{pchan_title_text(pchans)}\nAntennas: {ant_title}", fontsize=10, y=0.975)
    fig.tight_layout(rect=(0, 0.015, 1, 0.985), h_pad=0.55, w_pad=0.65)
    out = derived_output_path(out_base, antenna_selection_tag(antennas, ant_all, antenna_text))
    fig.savefig(out, dpi=DEFAULT_PLOT_DPI)
    plt.close(fig)
    print(f"Wrote plot: {out}")
    return [out]


def plot_gain_histogram(
    npz_path: Path,
    out: Path,
    antennas: Optional[List[int]],
    mode: str,
    nbin: int,
    hist_range: Optional[Tuple[float, float]],
    pchans: Optional[Tuple[int, int]] = None,
) -> None:
    z = load_npz(npz_path)
    required = {"scan", "antenna", "stokes", "channel", "real", "imag"}
    missing = required - set(z)
    if missing:
        raise ValueError(f"{npz_path} missing arrays: {sorted(missing)}")

    ant_all = filter_antennas(np.unique(z["antenna"]).astype(int), antennas)
    stokes_all = np.unique(z["stokes"]).astype(int)
    if ant_all.size == 0 or stokes_all.size == 0:
        raise ValueError("No antennas/stokes available for gain histogram.")

    ant_arr = z["antenna"].astype(int)
    stokes_arr = z["stokes"].astype(int)
    real_arr = z["real"].astype(float)
    imag_arr = z["imag"].astype(float)
    flagged_arr = z["flagged"].astype(bool) if "flagged" in z else np.zeros(real_arr.shape, dtype=bool)
    pchan_mask = plot_channel_mask(z["channel"].astype(int), pchans, str(npz_path))

    all_values: List[np.ndarray] = []
    stokes_hist: Dict[int, Tuple[List[np.ndarray], List[np.ndarray]]] = {}
    for stokes in stokes_all:
        real_by_ant: List[np.ndarray] = []
        imag_by_ant: List[np.ndarray] = []
        for ant in ant_all:
            selector = (ant_arr == int(ant)) & (stokes_arr == int(stokes)) & pchan_mask & ~flagged_arr
            rv = (real_arr[selector] - 1.0) * 100.0
            iv = imag_arr[selector] * 100.0
            rv = rv[np.isfinite(rv)]
            iv = iv[np.isfinite(iv)]
            real_by_ant.append(rv)
            imag_by_ant.append(iv)
            if rv.size:
                all_values.append(rv)
            if iv.size:
                all_values.append(iv)
        stokes_hist[int(stokes)] = (real_by_ant, imag_by_ant)

    if hist_range is None:
        if all_values:
            concat = np.concatenate([vals for vals in all_values if vals.size])
            vmax_abs = float(np.nanmax(np.abs(concat))) if concat.size else 1.0
            vmin, vmax = -vmax_abs, vmax_abs
        else:
            vmin, vmax = -1.0, 1.0
    else:
        vmin, vmax = hist_range
    if not np.isfinite(vmin) or not np.isfinite(vmax) or vmin == vmax:
        vmin, vmax = -1.0, 1.0

    nbin = max(1, int(nbin))
    y_edges = np.linspace(vmin, vmax, nbin + 1)
    x_edges = np.arange(0, len(ant_all) + 1, 1)
    x_grid, y_grid = np.meshgrid(x_edges, y_edges)

    cmap = plt.get_cmap("coolwarm").copy()
    cmap.set_bad(color="white")

    hist_panels: Dict[int, Tuple[Tuple[np.ma.MaskedArray, np.ndarray], Tuple[np.ma.MaskedArray, np.ndarray]]] = {}
    scale_values: List[np.ndarray] = []
    for ri, stokes in enumerate(stokes_all):
        real_by_ant, imag_by_ant = stokes_hist[int(stokes)]
        matrices = []
        for vals_by_ant in (real_by_ant, imag_by_ant):
            counts = np.zeros((nbin, len(ant_all)), dtype=float)
            for ai, vals in enumerate(vals_by_ant):
                if vals.size:
                    counts[:, ai], _ = np.histogram(vals, bins=y_edges)
            pct = np.zeros_like(counts, dtype=float)
            col_sums = counts.sum(axis=0)
            for ai, total in enumerate(col_sums):
                if total > 0:
                    pct[:, ai] = (counts[:, ai] / total) * 100.0
            log_pct = np.full_like(pct, np.nan, dtype=float)
            positive_mask = pct > 0.0
            log_pct[positive_mask] = np.log10(pct[positive_mask])
            vis = np.ma.array(log_pct)
            vis.mask = np.isnan(vis)
            if vis.count():
                scale_values.append(vis.compressed())
            panel_values = [vals for vals in vals_by_ant if vals.size]
            vals_for_stats = np.concatenate(panel_values) if panel_values else np.array([], dtype=float)
            matrices.append((vis, vals_for_stats))
        hist_panels[int(stokes)] = (matrices[0], matrices[1])

    if scale_values:
        all_log_values = np.concatenate(scale_values)
        log_vmin = float(np.nanmin(all_log_values))
        log_vmax = float(np.nanmax(all_log_values))
    else:
        log_vmin, log_vmax = -2.0, 0.0
    percent_levels = factor_two_levels(10.0 ** log_vmax)
    log_ticks = np.log10(percent_levels)
    log_vmin = min(log_vmin, float(log_ticks[0]))
    log_vmax = max(log_vmax, float(log_ticks[-1]))
    if not np.isfinite(log_vmin) or not np.isfinite(log_vmax) or log_vmin == log_vmax:
        log_vmin, log_vmax = -2.0, 0.0

    nrows = len(stokes_all)
    fig_height = max(6.0, 3.0 * nrows)
    fig = plt.figure(figsize=(fig_height * 4.0 / 3.0, fig_height))
    grid = fig.add_gridspec(nrows, 3, width_ratios=[1.0, 1.0, 0.05], wspace=0.035, hspace=0.28)
    axes = np.asarray([[fig.add_subplot(grid[row, col]) for col in range(2)] for row in range(nrows)])
    cax = fig.add_subplot(grid[:, 2])

    last_im = None
    for ri, stokes in enumerate(stokes_all):
        matrices = hist_panels[int(stokes)]
        for ci, (label, matrix) in enumerate([("Real-1", matrices[0]), ("Imag", matrices[1])]):
            ax = axes[ri, ci]
            vis, vals_for_stats = matrix
            last_im = ax.pcolormesh(x_grid, y_grid, vis, cmap=cmap, shading="auto", vmin=log_vmin, vmax=log_vmax)
            ax.set_title(f"Stokes {stokes} {label}\n{sample_stats_text(vals_for_stats)}", fontsize=8)
            ax.set_xlim(0, len(ant_all))
            ax.set_ylim(vmin, vmax)
            ax.set_xticks(np.arange(len(ant_all)) + 0.5)
            ax.set_xticklabels([str(a) if i % 2 == 0 or i == len(ant_all) - 1 else "" for i, a in enumerate(ant_all)], fontsize=6)
            ax.tick_params(axis="both", labelsize=6)
            if ci == 0:
                ax.tick_params(axis="y", pad=1)
            ax.set_axisbelow(False)
            ax.grid(axis="y", linestyle=":", linewidth=0.6, color="0.35", alpha=0.65)
            ax.set_ylabel("Gain value [%]" if ci == 0 else "", fontsize=8, labelpad=2)
            if ci == 1:
                ax.tick_params(axis="y", left=False, labelleft=False)
            if ri == nrows - 1:
                ax.set_xlabel("Antenna", fontsize=8)

    if last_im is not None:
        cbar = fig.colorbar(last_im, cax=cax, orientation="vertical")
        cbar.ax.set_title("Percent", fontsize=8, pad=6)
        cbar.ax.tick_params(labelsize=6)
        cbar.set_ticks(log_ticks)
        cbar.set_ticklabels([f"{level:.2f}" for level in percent_levels])

    header = gain_product_header(z)
    table_name = Path(str(header.get("input_table", "gain table"))).name or "gain table"
    scans = np.unique(z["scan"].astype(int))
    scan_label = str(int(scans[0])) if scans.size == 1 else "allscans"
    fig.suptitle(f"Gain Histogram: {table_name} | Scan: {scan_label}{pchan_title_text(pchans)}", fontsize=12)
    out.parent.mkdir(parents=True, exist_ok=True)
    fig.subplots_adjust(left=0.06, right=0.95, bottom=0.075, top=0.9)
    fig.savefig(out, dpi=DEFAULT_PLOT_DPI)
    plt.close(fig)
    print(f"Wrote plot: {out}")


def derived_output_path(base: Path, suffix: str) -> Path:
    return base.with_name(f"{base.stem}-{suffix}{base.suffix}")


def plot_single_antenna_gain_products(
    npz_path: Path,
    out_base: Path,
    antennas: Optional[List[int]],
    mode: str,
    pchans: Optional[Tuple[int, int]] = None,
) -> List[Path]:
    z = load_npz(npz_path)
    required = {"scan", "antenna", "stokes", "channel", "real", "imag"}
    missing = required - set(z)
    if missing:
        raise ValueError(f"{npz_path} missing arrays: {sorted(missing)}")

    available_antennas = np.unique(z["antenna"]).astype(int)
    if antennas is None:
        ant_all = available_antennas
    else:
        requested = np.asarray(antennas, dtype=int)
        missing_antennas = [int(ant) for ant in requested if ant not in set(available_antennas.tolist())]
        for ant in missing_antennas:
            print(f"SKIP antenna {ant}: not present in {npz_path}")
        ant_all = filter_antennas(available_antennas, antennas)
    stokes_all = np.unique(z["stokes"]).astype(int)
    if ant_all.size == 0:
        print("SKIP antenna plots: none of the requested antennas are present in the gains NPZ.")
        return []
    if stokes_all.size == 0:
        print("SKIP antenna plots: no Stokes values are present in the gains NPZ.")
        return []

    header = {}
    if "header_json" in z:
        try:
            header = json.loads(str(np.asarray(z["header_json"]).item()))
        except Exception:
            header = {}
    table_name = Path(str(header.get("input_table", "gain table"))).name
    if not table_name:
        table_name = "gain table"

    ant_arr = z["antenna"].astype(int)
    stokes_arr = z["stokes"].astype(int)
    scan_arr = z["scan"].astype(int)
    chan_arr = z["channel"].astype(int)
    real_arr = z["real"].astype(float)
    imag_arr = z["imag"].astype(float)
    row_arr = z["row"].astype(float) if "row" in z else np.arange(real_arr.size, dtype=float)
    flagged_arr = z["flagged"].astype(bool) if "flagged" in z else np.zeros(real_arr.shape, dtype=bool)
    pchan_mask = plot_channel_mask(chan_arr, pchans, str(npz_path))
    time_arr = z["time"].astype(float) if "time" in z else None
    interval_arr = z["interval"].astype(float) if "interval" in z else None
    channel_freq_arr = z["channel_freq_hz"].astype(float) if "channel_freq_hz" in z else np.full(chan_arr.shape, np.nan)
    channel_width_arr = z["channel_width_hz"].astype(float) if "channel_width_hz" in z else np.full(chan_arr.shape, np.nan)

    scans = np.unique(scan_arr)
    scan_label = str(int(scans[0])) if scans.size == 1 else "allscans"
    written: List[Path] = []
    out_base.parent.mkdir(parents=True, exist_ok=True)

    for ant in ant_all:
        antenna_panels: List[Tuple[int, np.ndarray, np.ndarray, np.ndarray, str, Optional[np.ndarray], Optional[np.ndarray], Optional[np.ndarray]]] = []
        delta_t_values: List[float] = []
        delta_nu_values: List[float] = []
        for stokes in stokes_all:
            selector = (ant_arr == int(ant)) & (stokes_arr == int(stokes)) & pchan_mask & ~flagged_arr
            if not np.any(selector):
                continue

            time_rows: Optional[np.ndarray] = None
            freq_mhz: Optional[np.ndarray] = None
            channel_labels: Optional[np.ndarray] = None
            if mode == "bandpass":
                source_axis = chan_arr.astype(float)
                axis_values = np.unique(chan_arr[selector]).astype(float)
                freq_mhz = np.full(axis_values.shape, np.nan, dtype=float)
                width_hz = np.full(axis_values.shape, np.nan, dtype=float)
                for idx, chan in enumerate(axis_values.astype(int)):
                    chan_selector = selector & (chan_arr == int(chan))
                    freqs = channel_freq_arr[chan_selector]
                    widths = channel_width_arr[chan_selector]
                    if freqs.size and np.any(np.isfinite(freqs)):
                        freq_mhz[idx] = float(np.nanmedian(freqs) / 1.0e6)
                    if widths.size and np.any(np.isfinite(widths)):
                        width_hz[idx] = float(np.nanmedian(np.abs(widths)))
                if not np.any(np.isfinite(freq_mhz)):
                    freq_mhz = axis_values.copy()
                finite_widths = width_hz[np.isfinite(width_hz) & (width_hz > 0)]
                if finite_widths.size:
                    delta_nu_values.append(float(np.nanmedian(finite_widths) / 1.0e3))
                elif np.count_nonzero(np.isfinite(freq_mhz)) > 1:
                    diffs = np.diff(freq_mhz[np.isfinite(freq_mhz)])
                    finite_diffs = np.abs(diffs[np.isfinite(diffs) & (diffs != 0)])
                    if finite_diffs.size:
                        delta_nu_values.append(float(np.nanmedian(finite_diffs) * 1.0e3))
                channel_labels = axis_values.astype(int)
                x_label = r"$\nu$ (MHz)"
            else:
                if time_arr is not None:
                    finite_times = time_arr[selector][np.isfinite(time_arr[selector])]
                    if finite_times.size:
                        t0 = float(np.nanmin(finite_times))
                        source_axis = time_arr - t0
                        axis_values = np.unique(source_axis[selector & np.isfinite(source_axis)])
                        if interval_arr is not None:
                            valid_intervals = interval_arr[selector & np.isfinite(interval_arr) & (interval_arr > 0)]
                            delta_t = float(np.nanmedian(valid_intervals)) if valid_intervals.size else np.nan
                        else:
                            delta_t = np.nan
                        if not np.isfinite(delta_t) or delta_t <= 0:
                            diffs = np.diff(axis_values)
                            delta_t = float(np.nanmedian(diffs[diffs > 0])) if np.any(diffs > 0) else 1.0
                        time_rows = np.asarray([int(round(float(v) / delta_t)) for v in axis_values], dtype=int)
                        if np.isfinite(delta_t) and delta_t > 0:
                            delta_t_values.append(delta_t)
                    else:
                        source_axis = row_arr
                        axis_values = np.unique(source_axis[selector])
                else:
                    source_axis = row_arr
                    axis_values = np.unique(source_axis[selector])
                x_label = "Time [s]"

            real_series = np.full(axis_values.shape, np.nan, dtype=float)
            imag_series = np.full(axis_values.shape, np.nan, dtype=float)
            for idx, xv in enumerate(axis_values):
                m = selector & (source_axis == xv)
                if np.any(m):
                    real_series[idx] = float(np.nanmean((real_arr[m] - 1.0) * 100.0))
                    imag_series[idx] = float(np.nanmean(imag_arr[m] * 100.0))

            antenna_panels.append((int(stokes), axis_values, real_series, imag_series, x_label, time_rows, freq_mhz, channel_labels))

        if not antenna_panels:
            total = int(np.count_nonzero((ant_arr == int(ant)) & pchan_mask))
            flagged = int(np.count_nonzero((ant_arr == int(ant)) & pchan_mask & flagged_arr))
            print(
                f"SKIP antenna {int(ant)}: no finite unflagged samples "
                f"(samples={total}, flagged={flagged}, pchans={pchans})"
            )
            continue

        panel_values = []
        for _, _, real_series, imag_series, _, _, _, _ in antenna_panels:
            panel_values.extend([real_series[np.isfinite(real_series)], imag_series[np.isfinite(imag_series)]])
        finite_values = np.concatenate([vals for vals in panel_values if vals.size]) if any(vals.size for vals in panel_values) else np.array([])
        shared_abs_limit = float(np.nanmax(np.abs(finite_values))) if finite_values.size else 1.0
        if not np.isfinite(shared_abs_limit) or shared_abs_limit <= 0:
            shared_abs_limit = 1.0

        ncols = len(antenna_panels)
        fig_width = max(6.4, 3.6 * ncols)
        fig, axs = plt.subplots(2, ncols, figsize=(fig_width, fig_width * 3.0 / 4.0), sharex="col", squeeze=False)
        for ci, (stokes, axis_values, real_series, imag_series, x_label, time_rows, freq_mhz, channel_labels) in enumerate(antenna_panels):
            axs[0, ci].plot(axis_values, real_series, color="blue", label=f"Stokes {stokes}")
            axs[0, ci].set_ylim(-shared_abs_limit, shared_abs_limit)
            axs[0, ci].legend(loc="upper right", fontsize=8, frameon=True)
            axs[0, ci].grid(True, ls=":")
            if mode == "bandpass" and channel_labels is not None and axis_values.size:
                nticks = min(6, axis_values.size)
                tick_idx = np.unique(np.linspace(0, axis_values.size - 1, nticks, dtype=int))
                top_ax = axs[0, ci].twiny()
                top_ax.set_xlim(axs[0, ci].get_xlim())
                top_ax.set_xticks(axis_values[tick_idx])
                top_ax.set_xticklabels([str(int(channel_labels[i])) for i in tick_idx], fontsize=7)
                top_ax.set_xlabel("Channel", fontsize=8)
                top_ax.tick_params(axis="x", labelsize=7)
            elif time_rows is not None and axis_values.size:
                nticks = min(6, axis_values.size)
                tick_idx = np.unique(np.linspace(0, axis_values.size - 1, nticks, dtype=int))
                top_ax = axs[0, ci].twiny()
                top_ax.set_xlim(axs[0, ci].get_xlim())
                top_ax.set_xticks(axis_values[tick_idx])
                top_ax.set_xticklabels([str(int(time_rows[i])) for i in tick_idx], fontsize=7)
                top_ax.set_xlabel("Time row", fontsize=8)
                top_ax.tick_params(axis="x", labelsize=7)
            axs[1, ci].plot(axis_values, imag_series, color="red", label=f"Stokes {stokes}")
            axs[1, ci].set_xlabel(x_label)
            if mode == "bandpass" and freq_mhz is not None and axis_values.size:
                nticks = min(6, axis_values.size)
                tick_idx = np.unique(np.linspace(0, axis_values.size - 1, nticks, dtype=int))
                axs[1, ci].set_xticks(axis_values[tick_idx])
                axs[1, ci].set_xticklabels([f"{float(freq_mhz[i]):.0f}" for i in tick_idx], fontsize=7)
            axs[1, ci].set_ylim(-shared_abs_limit, shared_abs_limit)
            axs[1, ci].legend(loc="upper right", fontsize=8, frameon=True)
            axs[1, ci].grid(True, ls=":")
            if ci == 0:
                axs[0, ci].set_ylabel("Real-1 [%]")
                axs[1, ci].set_ylabel("Imag [%]")
            else:
                axs[0, ci].tick_params(axis="y", left=False, labelleft=False)
                axs[1, ci].tick_params(axis="y", left=False, labelleft=False)

        dt_text = ""
        if mode != "bandpass" and delta_t_values:
            delta_t = float(np.nanmedian(np.asarray(delta_t_values, dtype=float)))
            if np.isfinite(delta_t) and delta_t > 0:
                dt_text = f" | $\\Delta t$ = {delta_t:.2f} s"
        dnu_text = ""
        if mode == "bandpass" and delta_nu_values:
            delta_nu = float(np.nanmedian(np.asarray(delta_nu_values, dtype=float)))
            if np.isfinite(delta_nu) and delta_nu > 0:
                dnu_text = f" | $\\Delta \\nu$ = {delta_nu:.2f} kHz"
        title = (
            f"Gain Table: {table_name} | Antenna: {int(ant)}\n"
            f"Scan: {scan_label}{dt_text}{dnu_text}{pchan_title_text(pchans)}"
        )
        title_size = max(7.0, 10.0 - max(0, max(len(line) for line in title.splitlines()) - 80) * 0.035)
        title_y = 0.965 if mode == "bandpass" else 0.98
        fig.suptitle(title, fontsize=title_size, y=title_y)
        top_rect = 0.95 if mode == "bandpass" else 0.88
        fig.tight_layout(rect=(0, 0, 1, top_rect))

        out = derived_output_path(out_base, f"ant{int(ant)}")
        fig.savefig(out, dpi=DEFAULT_PLOT_DPI)
        plt.close(fig)
        written.append(out)
        print(f"Wrote plot: {out}")

    if not written:
        print("SKIP antenna plots: no selected antenna had finite unflagged data to plot.")
    return written


def metric_index(metrics: Sequence[Any], name: str) -> Optional[int]:
    labels = [str(x) for x in metrics]
    return labels.index(name) if name in labels else None


def finite_gain_values(
    z: Dict[str, np.ndarray],
    ant: int,
    stokes: int,
    component: str,
    pchans: Optional[Tuple[int, int]] = None,
) -> np.ndarray:
    selector = (z["antenna"].astype(int) == int(ant)) & (z["stokes"].astype(int) == int(stokes))
    if pchans is not None:
        selector &= plot_channel_mask(z["channel"].astype(int), pchans, "gains NPZ")
    if "flagged" in z:
        selector &= ~z["flagged"].astype(bool)
    source = z["real"].astype(float) if component == "real" else z["imag"].astype(float)
    vals = source[selector]
    if component == "real":
        vals = (vals - 1.0) * 100.0
    else:
        vals = vals * 100.0
    return vals[np.isfinite(vals)].ravel()


def raw_gain_values(
    z: Dict[str, np.ndarray],
    ant: int,
    stokes: int,
    component: str,
    pchans: Optional[Tuple[int, int]] = None,
) -> np.ndarray:
    selector = (z["antenna"].astype(int) == int(ant)) & (z["stokes"].astype(int) == int(stokes))
    if pchans is not None:
        selector &= plot_channel_mask(z["channel"].astype(int), pchans, "gains NPZ")
    if "flagged" in z:
        selector &= ~z["flagged"].astype(bool)
    source = z["real"].astype(float) if component == "real" else z["imag"].astype(float)
    vals = source[selector]
    return vals[np.isfinite(vals)].ravel()


def gain_component_metrics(vals: np.ndarray, component: str) -> Dict[str, float]:
    vals = np.asarray(vals, dtype=float)
    vals = vals[np.isfinite(vals)]
    if vals.size == 0:
        return {"mean": np.nan, "std": np.nan, "skew": np.nan, "kurt": np.nan}
    mean = float(np.mean(vals))
    std = float(np.std(vals))
    skew, kurt = nan_skew_kurt(vals)
    display_mean = (mean - 1.0) * 100.0 if component == "real" else mean * 100.0
    return {"mean": display_mean, "std": std * 100.0, "skew": skew, "kurt": kurt}


def nan_skew_kurt(vals: np.ndarray) -> Tuple[float, float]:
    vals = np.asarray(vals, dtype=float)
    vals = vals[np.isfinite(vals)]
    if vals.size == 0:
        return np.nan, np.nan
    mean = float(np.mean(vals))
    std = float(np.std(vals))
    if std <= 0:
        return np.nan, np.nan
    skew = float(np.mean(((vals - mean) / std) ** 3)) if vals.size >= 3 else np.nan
    kurt = float(np.mean(((vals - mean) / std) ** 4) - 3.0) if vals.size >= 4 else np.nan
    return skew, kurt


def component_index(components: Sequence[Any], name: str) -> Optional[int]:
    labels = [str(x) for x in components]
    return labels.index(name) if name in labels else None


def plot_antenna_gain_stats_grid(
    npz_path: Path,
    out: Path,
    antennas: Optional[List[int]],
    adjust_mean: bool = False,
    pchans: Optional[Tuple[int, int]] = None,
) -> None:
    z = load_npz(npz_path)
    if "stats" in z:
        if pchans is not None:
            raise ValueError("-pchans for stats plots requires a gains NPZ product so statistics can be recalculated.")
        if adjust_mean:
            raise ValueError("--adjust-mean for stats plots requires a gains NPZ product.")
        required = {"scan_numbers", "antennas", "stokes", "components", "metrics", "stats"}
        missing = required - set(z)
        if missing:
            raise ValueError(f"{npz_path} missing arrays: {sorted(missing)}")
        stored_ants = z["antennas"].astype(int)
        ant_all = filter_antennas(stored_ants, antennas)
        stokes_all = z["stokes"].astype(int)
        if ant_all.size == 0 or stokes_all.size == 0:
            raise ValueError("No antennas/stokes available for stats grid.")
        ant_lookup = {int(ant): idx for idx, ant in enumerate(stored_ants)}
        comp_lookup = {comp: component_index(z["components"], comp) for comp in ("real", "imag")}
        metric_lookup = {
            "mean": metric_index(z["metrics"], "mean"),
            "std": metric_index(z["metrics"], "std"),
            "skew": metric_index(z["metrics"], "skew"),
            "kurt": metric_index(z["metrics"], "kurtosis"),
        }
        stats: Dict[int, Dict[str, Dict[str, np.ndarray]]] = {}
        source = z["stats"].astype(float)
        for pi, stokes in enumerate(stokes_all):
            stats[int(stokes)] = {
                comp: {metric: np.full(len(ant_all), np.nan) for metric in ["mean", "std", "skew", "kurt"]}
                for comp in ("real", "imag")
            }
            for ai, ant in enumerate(ant_all):
                stored_ai = ant_lookup[int(ant)]
                for comp in ("real", "imag"):
                    ci = comp_lookup[comp]
                    if ci is None:
                        continue
                    for metric, mi in metric_lookup.items():
                        if mi is not None:
                            vals = source[:, stored_ai, pi, ci, mi]
                            stats[int(stokes)][comp][metric][ai] = float(np.nanmean(vals)) if np.any(np.isfinite(vals)) else np.nan
        scans = z["scan_numbers"].astype(int)
    else:
        required = {"antenna", "stokes", "channel", "real", "imag"}
        missing = required - set(z)
        if missing:
            raise ValueError(f"{npz_path} missing arrays: {sorted(missing)}")
        ant_all = filter_antennas(np.unique(z["antenna"]).astype(int), antennas)
        stokes_all = np.unique(z["stokes"]).astype(int)
        if ant_all.size == 0 or stokes_all.size == 0:
            raise ValueError("No antennas/stokes available for stats grid.")

        group_means: Dict[Tuple[int, str], float] = {}
        if adjust_mean:
            for stokes in stokes_all:
                for comp in ("real", "imag"):
                    combined = [
                        raw_gain_values(z, int(ant), int(stokes), comp, pchans)
                        for ant in ant_all
                    ]
                    vals = np.concatenate([item for item in combined if item.size]) if any(item.size for item in combined) else np.array([])
                    mean = float(np.mean(vals)) if vals.size else np.nan
                    group_means[(int(stokes), comp)] = mean if np.isfinite(mean) else np.nan

        stats = {}
        for stokes in stokes_all:
            stats[int(stokes)] = {
                comp: {metric: np.full(len(ant_all), np.nan) for metric in ["mean", "std", "skew", "kurt"]}
                for comp in ("real", "imag")
            }
            for ai, ant in enumerate(ant_all):
                for comp in ("real", "imag"):
                    vals = raw_gain_values(z, int(ant), int(stokes), comp, pchans)
                    if vals.size == 0:
                        continue
                    if adjust_mean:
                        group_mean = group_means.get((int(stokes), comp), np.nan)
                        if not np.isfinite(group_mean) or (comp == "real" and group_mean == 0.0):
                            continue
                        vals = vals / group_mean if comp == "real" else vals - group_mean
                    metrics = gain_component_metrics(vals, comp)
                    for metric, value in metrics.items():
                        stats[int(stokes)][comp][metric][ai] = value
        scans = np.unique(z["scan"].astype(int)) if "scan" in z else np.array([])

    fig, axes = plt.subplots(2, 2, figsize=(10, 7.5), constrained_layout=True)
    ax_mean, ax_std = axes[0, 0], axes[0, 1]
    ax_skew, ax_kurt = axes[1, 1], axes[1, 0]
    axes_map = [("mean", ax_mean, "Mean [%]"), ("std", ax_std, "Std [%]"), ("skew", ax_skew, "Skewness"), ("kurt", ax_kurt, "Kurtosis")]
    markers = ["o", "s", "^", "D", "v", "P", "X"]
    colors = plt.rcParams["axes.prop_cycle"].by_key().get("color", ["C0", "C1", "C2", "C3"])
    xs = np.arange(len(ant_all))
    xticklabels = [str(a) if i % 2 == 0 else "" for i, a in enumerate(ant_all)]
    for si, stokes in enumerate(stokes_all):
        color = colors[si % len(colors)]
        marker = markers[si % len(markers)]
        label_base = str(int(stokes))
        for metric, ax, _title in axes_map:
            ax.plot(xs, stats[int(stokes)]["real"][metric], marker=marker, ms=5, color=color, linestyle="-", label=f"{label_base}-re-1", markerfacecolor=color)
            ax.plot(xs, stats[int(stokes)]["imag"][metric], marker=marker, ms=5, color=color, linestyle="--", label=f"{label_base}-im", markerfacecolor="white")
    for metric, ax, title in axes_map:
        all_vals = []
        for stokes in stokes_all:
            for comp in ("real", "imag"):
                vals = stats[int(stokes)][comp][metric]
                all_vals.extend(vals[np.isfinite(vals)])
        if metric in {"mean", "skew", "kurt"}:
            all_vals.append(0.0)
        if all_vals:
            vmin, vmax = float(np.min(all_vals)), float(np.max(all_vals))
            pad = 0.05 * (vmax - vmin) if vmax > vmin else 1.0
            ax.set_ylim(vmin - pad, vmax + pad)
        if metric in {"mean", "skew", "kurt"}:
            ax.axhline(0.0, color="black", linestyle="--", linewidth=2)
        ax.set_xlim(-0.5, len(ant_all) - 0.5)
        ax.set_xticks(xs)
        ax.set_xticklabels(xticklabels)
        ax.set_title(title, fontsize=10)
        ax.grid(True, ls=":", alpha=0.4)
    handles, labels = ax_mean.get_legend_handles_labels()
    seen, uniq_h, uniq_l = set(), [], []
    for h, label in zip(handles, labels):
        if label not in seen:
            seen.add(label)
            uniq_h.append(h)
            uniq_l.append(label)
    ax_mean.legend(uniq_h, uniq_l, loc="upper right", frameon=True, fontsize=8)
    axes[1, 0].set_xlabel("Antenna")
    axes[1, 1].set_xlabel("Antenna")
    scan_label = str(int(scans[0])) if scans.size == 1 else "allscans"
    header = gain_product_header(z)
    table_name = Path(str(header.get("input_table", "gain table"))).name or "gain table"
    adjust_text = " | adjust-mean" if adjust_mean else ""
    fig.suptitle(f"Gain Table: {table_name} | Scan: {scan_label}{adjust_text}{pchan_title_text(pchans)}", fontsize=12)
    out.parent.mkdir(parents=True, exist_ok=True)
    fig.savefig(out, dpi=DEFAULT_PLOT_DPI)
    plt.close(fig)
    print(f"Wrote plot: {out}")


def normal_ks_d(vals: np.ndarray) -> float:
    vals = np.sort(np.asarray(vals, dtype=float)[np.isfinite(vals)])
    if vals.size < 2:
        return np.nan
    mu = float(np.mean(vals))
    sigma = float(np.std(vals, ddof=1))
    if not np.isfinite(sigma) or sigma <= 0:
        return np.nan
    cdf = 0.5 * (1.0 + np.vectorize(math.erf)((vals - mu) / (sigma * math.sqrt(2.0))))
    empirical_hi = np.arange(1, vals.size + 1, dtype=float) / vals.size
    empirical_lo = np.arange(0, vals.size, dtype=float) / vals.size
    return float(max(np.max(np.abs(empirical_hi - cdf)), np.max(np.abs(cdf - empirical_lo))))


def two_sample_ks_d(x: np.ndarray, y: np.ndarray) -> float:
    x = np.sort(np.asarray(x, dtype=float)[np.isfinite(x)])
    y = np.sort(np.asarray(y, dtype=float)[np.isfinite(y)])
    if x.size < 2 or y.size < 2:
        return np.nan
    pooled = np.concatenate([x, y])
    cdf_x = np.searchsorted(x, pooled, side="right") / float(x.size)
    cdf_y = np.searchsorted(y, pooled, side="right") / float(y.size)
    return float(np.max(np.abs(cdf_x - cdf_y)))


def simulated_gaussian_ks_percent(n_sample: float, seed: int, realizations: int = 128) -> float:
    n = int(round(float(n_sample))) if np.isfinite(n_sample) else 0
    if n < 2:
        return np.nan
    rng = np.random.default_rng(seed)
    values = [
        two_sample_ks_d(rng.normal(size=n), rng.normal(size=n))
        for _ in range(max(1, int(realizations)))
    ]
    finite = np.asarray(values, dtype=float)
    finite = finite[np.isfinite(finite)]
    return float(np.mean(finite) * 100.0) if finite.size else np.nan


def plot_antenna_gain_ks_grid(npz_path: Path, out: Path, antennas: Optional[List[int]]) -> None:
    z = load_npz(npz_path)
    if "ks" in z:
        required = {"scan_numbers", "antennas", "stokes", "components", "metrics", "ks"}
        missing = required - set(z)
        if missing:
            raise ValueError(f"{npz_path} missing arrays: {sorted(missing)}")
        stored_ants = z["antennas"].astype(int)
        ant_all = filter_antennas(stored_ants, antennas)
        stokes_all = z["stokes"].astype(int)
        ant_lookup = {int(ant): idx for idx, ant in enumerate(stored_ants)}
        comp_lookup = {comp: component_index(z["components"], comp) for comp in ("real", "imag")}
        d_idx = metric_index(z["metrics"], "d_statistic")
        n_idx = metric_index(z["metrics"], "n_sample")
        scans = z["scan_numbers"].astype(int)
    else:
        required = {"antenna", "stokes", "real", "imag"}
        missing = required - set(z)
        if missing:
            raise ValueError(f"{npz_path} missing arrays: {sorted(missing)}")
        ant_all = filter_antennas(np.unique(z["antenna"]).astype(int), antennas)
        stokes_all = np.unique(z["stokes"]).astype(int)
        ant_lookup = {}
        comp_lookup = {}
        d_idx = None
        n_idx = None
        scans = np.unique(z["scan"].astype(int)) if "scan" in z else np.array([])
    if ant_all.size == 0 or stokes_all.size == 0:
        raise ValueError("No antennas/stokes available for KS grid.")
    xs = np.arange(len(ant_all))
    fig, ax = plt.subplots(figsize=(10, 7.5))
    markers = ["o", "s", "^", "D"]
    colors = ["C0", "C1", "C2", "C3", "C4", "C5"]
    sim_linestyles = ["--", "-.", (0, (5, 2)), (0, (2, 2))]
    y_values: List[float] = []
    for si, stokes in enumerate(stokes_all):
        marker = markers[si % len(markers)]
        for comp_pos, comp in enumerate(("real", "imag")):
            vals = np.full(len(ant_all), np.nan)
            sample_counts: List[float] = []
            for ai, ant in enumerate(ant_all):
                if "ks" in z:
                    comp_idx = comp_lookup[comp]
                    if comp_idx is not None and d_idx is not None:
                        product_vals = z["ks"].astype(float)[:, ant_lookup[int(ant)], si, comp_idx, d_idx]
                        vals[ai] = float(np.nanmean(product_vals)) if np.any(np.isfinite(product_vals)) else np.nan
                        if "sample_count" in z:
                            count_vals = z["sample_count"].astype(float)[:, ant_lookup[int(ant)], si, comp_idx]
                        elif n_idx is not None:
                            count_vals = z["ks"].astype(float)[:, ant_lookup[int(ant)], si, comp_idx, n_idx]
                        else:
                            count_vals = np.array([])
                        if count_vals.size and np.any(np.isfinite(count_vals)):
                            sample_counts.append(float(np.nanmean(count_vals)))
                else:
                    sample_vals = finite_gain_values(z, int(ant), int(stokes), comp)
                    d = normal_ks_d(sample_vals)
                    vals[ai] = d * 100.0 if np.isfinite(d) else np.nan
                    if sample_vals.size:
                            sample_counts.append(float(sample_vals.size))
            color = colors[(2 * si + comp_pos) % len(colors)]
            ax.plot(xs, vals, color=color, linestyle="-", marker=marker, label=f"{int(stokes)}-{'re' if comp == 'real' else 'im'}", markerfacecolor=color if comp == "real" else "white")
            y_values.extend(float(v) for v in vals[np.isfinite(vals)])
            finite_counts = np.asarray(sample_counts, dtype=float)
            finite_counts = finite_counts[np.isfinite(finite_counts)]
            if finite_counts.size:
                sim_ref = simulated_gaussian_ks_percent(
                    float(np.nanmedian(finite_counts)),
                    seed=20260729 + 101 * int(stokes) + 1009 * comp_pos,
                )
                if np.isfinite(sim_ref):
                    sim_label = f"{int(stokes)}-{'re' if comp == 'real' else 'im'} sim"
                    style = sim_linestyles[(2 * si + comp_pos) % len(sim_linestyles)]
                    ax.hlines(sim_ref, xs[0] - 0.35, xs[-1] + 0.35, color=color, linestyle=style, linewidth=1.0, label=sim_label, zorder=5)
                    y_values.append(float(sim_ref))
    ax.set_xticks(xs)
    ax.set_xticklabels([str(a) for a in ant_all])
    ax.set_xlim(-0.5, len(ant_all) - 0.5)
    ax.set_xlabel("Antenna", fontsize=14)
    ax.set_ylabel("KS-statistic [%]", fontsize=14)
    scan_label = str(int(scans[0])) if scans.size == 1 else "allscans"
    header = gain_product_header(z)
    table_name = Path(str(header.get("input_table", "gain table"))).name or "gain table"
    fig.suptitle(f"Gain Table: {table_name} | Scan: {scan_label}", fontsize=12)
    if y_values:
        ymax = float(np.nanmax(np.asarray(y_values, dtype=float)))
        upper = ymax * 1.08 if ymax > 0 else ymax + 1.0
        ax.set_ylim(0.0, upper)
    ax.grid(True, ls=":")
    ax.legend(fontsize=10, ncol=4, loc="lower center", bbox_to_anchor=(0.5, 0.03), frameon=True)
    ax.tick_params(axis="both", labelsize=12)
    out.parent.mkdir(parents=True, exist_ok=True)
    fig.subplots_adjust(left=0.07, right=0.985, bottom=0.105, top=0.92)
    fig.savefig(out, dpi=DEFAULT_PLOT_DPI)
    plt.close(fig)
    print(f"Wrote plot: {out}")


def tau_at_threshold(tau: np.ndarray, s2: np.ndarray, threshold: float) -> float:
    tau = np.asarray(tau, dtype=float)
    s2 = np.asarray(s2, dtype=float)
    valid = np.isfinite(tau) & np.isfinite(s2)
    if np.count_nonzero(valid) < 2:
        return np.nan
    t = tau[valid]
    y = s2[valid]
    order = np.argsort(t)
    t, y = t[order], y[order]
    if y[0] >= threshold:
        return float(t[0])
    above = np.where(y >= threshold)[0]
    if above.size == 0:
        return float(t[-1])
    i = int(above[0])
    if i == 0:
        return float(t[0])
    if y[i] == y[i - 1]:
        return float(t[i])
    return float(t[i - 1] + (threshold - y[i - 1]) * (t[i] - t[i - 1]) / (y[i] - y[i - 1]))


def plot_self_corr_colormap(npz_path: Path, out: Path, antennas: Optional[List[int]], threshold: float) -> None:
    z = load_npz(npz_path)
    required = {"antenna", "stokes", "component", "tau", "s2"}
    missing = required - set(z)
    if missing:
        raise ValueError(f"{npz_path} missing arrays: {sorted(missing)}")
    ant_all = filter_antennas(np.unique(z["antenna"]).astype(int), antennas)
    stokes_all = np.unique(z["stokes"]).astype(int)
    comps = [comp for comp in ("real", "imag") if comp in set(z["component"].astype(str))]
    tau = np.unique(z["tau"].astype(float))
    tau = tau[np.isfinite(tau)]
    if ant_all.size == 0 or stokes_all.size == 0 or tau.size == 0 or not comps:
        raise ValueError("No self-correlation panels available.")
    fig, axes = plt.subplots(len(stokes_all), 2, figsize=(8.2, max(3.6, 2.6 * len(stokes_all))), squeeze=False, constrained_layout=True)
    cmap = plt.get_cmap("coolwarm").copy()
    cmap.set_bad(color="white")
    x_edges = np.arange(0, len(ant_all) + 1, 1)
    if tau.size > 1:
        y_edges = np.concatenate([[tau[0] - (tau[1] - tau[0]) / 2], 0.5 * (tau[:-1] + tau[1:]), [tau[-1] + (tau[-1] - tau[-2]) / 2]])
    else:
        y_edges = np.array([tau[0] * 0.9, tau[0] * 1.1])
    matrices: Dict[Tuple[int, str], np.ndarray] = {}
    min_positive = np.inf
    for stokes in stokes_all:
        for comp in ("real", "imag"):
            mat = np.full((len(tau), len(ant_all)), np.nan)
            for ai, ant in enumerate(ant_all):
                for ti, tv in enumerate(tau):
                    selector = (
                        (z["antenna"].astype(int) == int(ant))
                        & (z["stokes"].astype(int) == int(stokes))
                        & (z["component"].astype(str) == comp)
                        & (z["tau"].astype(float) == tv)
                    )
                    vals = z["s2"].astype(float)[selector]
                    if vals.size:
                        finite_vals = vals[np.isfinite(vals)]
                        if finite_vals.size:
                            mat[ti, ai] = float(np.median(finite_vals))
            positives = mat[mat > 0]
            if positives.size:
                min_positive = min(min_positive, float(np.nanmin(positives)))
            matrices[(int(stokes), comp)] = mat
    if not np.isfinite(min_positive) or min_positive <= 0:
        min_positive = 1e-3
    positive_groups = [mat[np.isfinite(mat) & (mat > 0)] for mat in matrices.values() if np.any(np.isfinite(mat) & (mat > 0))]
    positive_values = np.concatenate(positive_groups) if positive_groups else np.asarray([], dtype=float)
    max_positive = float(np.nanmax(positive_values)) if positive_values.size else 1.5
    factor_levels = factor_two_levels(max_positive)
    ticks_log = np.log10(factor_levels)
    vmin_log = min(np.log10(min_positive), float(ticks_log[0]))
    vmax_log = max(np.log10(max_positive), float(ticks_log[-1]))
    last_im = None
    for ri, stokes in enumerate(stokes_all):
        for ci, comp in enumerate(("real", "imag")):
            ax = axes[ri, ci]
            mat = matrices[(int(stokes), comp)]
            log_mat = np.full_like(mat, np.nan, dtype=float)
            ok = mat > 0
            log_mat[ok] = np.log10(mat[ok])
            vis = np.ma.array(log_mat, mask=~np.isfinite(log_mat))
            x_grid, y_grid = np.meshgrid(x_edges, y_edges)
            last_im = ax.pcolormesh(x_grid, y_grid, vis, cmap=cmap, shading="auto", vmin=vmin_log, vmax=vmax_log)
            for ai in range(len(ant_all)):
                thr = tau_at_threshold(tau, mat[:, ai], threshold)
                if np.isfinite(thr):
                    ax.hlines(thr, ai, ai + 1, colors="white", linewidth=2)
            ax.set_xticks(np.arange(len(ant_all)) + 0.5)
            ax.set_xticklabels([str(a) if i % 2 == 0 else "" for i, a in enumerate(ant_all)], fontsize=8)
            ax.set_xlim(0, len(ant_all))
            ax.set_ylim(y_edges[0], y_edges[-1])
            if tau.size > 1 and np.all(tau > 0) and np.all(y_edges > 0):
                ax.set_yscale("log")
            ax.set_title(f"Stokes {int(stokes)} {'Real-1' if comp == 'real' else 'Imag'}", fontsize=9)
            if ci == 1:
                ax.yaxis.tick_right()
                ax.yaxis.set_label_position("right")
                ax.set_ylabel(r"$\tau$ [sec]")
            if ri == len(stokes_all) - 1:
                ax.set_xlabel("Antenna")
    if last_im is not None:
        cbar = fig.colorbar(last_im, ax=axes[:, 1], orientation="vertical", fraction=0.08, pad=0.04)
        cbar.set_ticks(ticks_log)
        cbar.set_ticklabels([f"{level:.2f}" for level in factor_levels])
    scans = np.unique(z["scan"].astype(int)) if "scan" in z else np.array([])
    scan_label = str(int(scans[0])) if scans.size == 1 else "allscans"
    fig.suptitle(f"Structure Function | Scan: {scan_label}", fontsize=12)
    out.parent.mkdir(parents=True, exist_ok=True)
    fig.savefig(out, dpi=DEFAULT_PLOT_DPI)
    plt.close(fig)
    print(f"Wrote plot: {out}")


def plot_self_corr_antenna_products(npz_path: Path, out_base: Path, antennas: Optional[List[int]], threshold: float) -> List[Path]:
    z = load_npz(npz_path)
    required = {"antenna", "stokes", "component", "tau", "s2"}
    missing = required - set(z)
    if missing:
        raise ValueError(f"{npz_path} missing arrays: {sorted(missing)}")

    ant_all = filter_antennas(np.unique(z["antenna"]).astype(int), antennas)
    stokes_all = np.unique(z["stokes"]).astype(int)
    comps = [comp for comp in ("real", "imag") if comp in set(z["component"].astype(str))]
    if ant_all.size == 0 or stokes_all.size == 0 or not comps:
        raise ValueError("No antennas/stokes/components available for self-correlation antenna plots.")

    out_base.parent.mkdir(parents=True, exist_ok=True)
    written: List[Path] = []
    for ant in ant_all:
        fig, axes = plt.subplots(len(stokes_all), len(comps), figsize=(5.0 * len(comps), max(3.2, 2.8 * len(stokes_all))), squeeze=False)
        for ri, stokes in enumerate(stokes_all):
            for ci, comp in enumerate(comps):
                ax = axes[ri, ci]
                selector = (
                    (z["antenna"].astype(int) == int(ant))
                    & (z["stokes"].astype(int) == int(stokes))
                    & (z["component"].astype(str) == comp)
                )
                tau = z["tau"].astype(float)[selector]
                s2 = z["s2"].astype(float)[selector]
                finite = np.isfinite(tau) & np.isfinite(s2)
                if not np.any(finite):
                    continue
                order = np.argsort(tau[finite])
                tx = tau[finite][order]
                yy = s2[finite][order]
                ax.plot(tx, yy, "o", ms=3, lw=1, color="blue")
                ax.plot(tx, yy, "-", lw=2, color="blue")
                ax.axhline(1.0, color="green", lw=2)
                ax.axhline(float(threshold), color="red", lw=2, linestyle="--")
                if tx.size and np.all(tx > 0):
                    ax.set_xscale("log")
                ax.set_xlabel(r"$\tau$ [sec]")
                ax.set_ylabel(r"$S_2 / (2\,\sigma^2)$")
                ax.set_title(f"antenna:{int(ant)}, stokes:{int(stokes)}, {comp}", fontsize=10)
                ax.grid(True, which="both", ls=":", alpha=0.4)
        fig.tight_layout()
        out = derived_output_path(out_base, f"ant{int(ant)}")
        fig.savefig(out, dpi=DEFAULT_PLOT_DPI)
        plt.close(fig)
        written.append(out)
        print(f"Wrote plot: {out}")

    return written


def plot_cross_corr_colormap(npz_path: Path, out: Path, antennas: Optional[List[int]]) -> None:
    z = load_npz(npz_path)
    required = {"ant1", "ant2", "stokes", "components", "tcorr"}
    missing = required - set(z)
    if missing:
        raise ValueError(f"{npz_path} missing arrays: {sorted(missing)}")
    ant_values = np.unique(np.concatenate([z["ant1"].astype(int), z["ant2"].astype(int)]))
    ant_all = filter_antennas(ant_values, antennas)
    combos = sorted({(str(s), str(c)) for s, c in zip(z["stokes"].astype(str), z["components"].astype(str))})
    if ant_all.size == 0 or not combos:
        raise ValueError("No cross-correlation values available.")
    ncols = 2
    nrows = int(np.ceil(len(combos) / ncols))
    fig, axes = plt.subplots(nrows, ncols, figsize=(5.4 * ncols, max(4.4, 4.2 * nrows)), squeeze=False)
    ant_index = {int(a): i for i, a in enumerate(ant_all)}
    for pi, (stokes, comp) in enumerate(combos):
        ax = axes.ravel()[pi]
        mat = np.full((len(ant_all), len(ant_all)), np.nan, dtype=float)
        selector = (z["stokes"].astype(str) == stokes) & (z["components"].astype(str) == comp)
        for a1, a2, val in zip(z["ant1"][selector].astype(int), z["ant2"][selector].astype(int), z["tcorr"][selector].astype(float)):
            if a1 not in ant_index or a2 not in ant_index or not np.isfinite(val):
                continue
            i, j = ant_index[a1], ant_index[a2]
            mat[i, j] = val
            mat[j, i] = val
        im = ax.imshow(mat, origin="lower", interpolation="nearest", cmap="viridis")
        ax.set_xticks(np.arange(len(ant_all)))
        ax.set_xticklabels([str(a) for a in ant_all], rotation=90)
        ax.set_yticks(np.arange(len(ant_all)))
        ax.set_yticklabels([str(a) for a in ant_all])
        apply_style(ax, f"cross tcorr | S{stokes} {comp}", "Antenna", "Antenna")
        fig.colorbar(im, ax=ax, label="tcorr")
    for ax in axes.ravel()[len(combos):]:
        ax.axis("off")
    save_figure(fig, out)


def selected_tasks(args: argparse.Namespace) -> List[str]:
    pmode_tasks = parse_pmode(args.pmode)
    if pmode_tasks:
        return pmode_tasks

    tasks: List[str] = []
    if args.all:
        tasks.extend(ALL_PMODE_TASKS)
    for flag, task in [
        (args.gain_colormap, "gain_colormap"),
        (args.gain_hist, "gain_hist"),
        (args.antenna_plot, "antenna"),
        (args.stats, "stats"),
        (args.ks, "ks"),
        (args.self_corr_colormap, "self_corr_colormap"),
        (args.self_corr_antenna, "self_corr_antenna"),
        (args.cross_corr_colormap, "cross_corr_colormap"),
    ]:
        if flag and task not in tasks:
            tasks.append(task)
    if not tasks:
        tasks.append("stats")
    return tasks


def modes_from_arg(mode: str) -> List[str]:
    return ["gain", "bandpass"] if mode == "both" else [mode]


def parse_args() -> argparse.Namespace:
    p = argparse.ArgumentParser(description="Plot GDP NPZ products, creating missing products with gdp-stats.")
    p.add_argument("--mode", choices=["gain", "bandpass", "both"], default="gain", help="Product mode to plot.")
    p.add_argument(
        "-pmode",
        "--pmode",
        default=None,
        help=(
            "Plot mode(s), comma or space separated: all, colormap, hist, "
            "reim, antenna, stats, ks, self-corr-colormap, "
            "self-corr-antenna, cross-corr-colormap. all expands to "
            "colormap, hist, stats, and ks. Legacy names gain-colormap and "
            "gain-hist are accepted as aliases."
        ),
    )
    p.add_argument("--input-table", default=None, help="Input CASA table passed to gdp-stats when products are missing.")
    p.add_argument("--gain-table", default=None, help="Gain table passed to gdp-stats when gain products are missing.")
    p.add_argument("--bandpass-table", default=None, help="Bandpass table passed to gdp-stats when bandpass products are missing.")
    p.add_argument("--setup-file", default=None, help="Setup JSON file to use. Relative names are resolved under the active runtime directory.")
    p.add_argument("--npz-path", default=None, help="Use this NPZ file directly for the selected plot mode instead of discovering or creating the default GDP product.")
    p.add_argument("--scan", default=None, help="Comma-separated scans. Must match or create the corresponding GDP products.")
    p.add_argument("--combine-scans", action="store_true", help="Plot one combined allscans-style product. Default: false, make one plot per scan.")
    p.add_argument("--antenna", nargs="+", default=None, help="Antenna list, inclusive range, or mixed selection. Examples: --antenna [0,9] for antennas 0 through 9; --antenna 2,3,4,31 or --antenna 2 3 4 31 for explicit antenna IDs; --antenna \"(1,5)\" 6 \"(9-12)\" 15 16 19 for mixed ranges and single antennas. The same list is passed to gdp-stats if missing products must be created.")
    p.add_argument("--bchan", type=int, default=None, help="Bandpass start channel passed to gdp-stats when needed.")
    p.add_argument("--echan", type=int, default=None, help="Bandpass end channel passed to gdp-stats when needed.")
    p.add_argument("-pchans", "--pchans", nargs="+", default=None, help="Plot channel window as '[start,end)'. Limits gains-based plots and subplot statistics without changing NPZ product discovery.")
    p.add_argument("--range", dest="plot_range", type=float, default=None, help="Colormap saturation half-range in percent for gain or bandpass -pmode colormap. The value is rounded up to a multiple of 5 for colorbar labels.")
    p.add_argument("--gain-colormap", action="store_true", help=argparse.SUPPRESS)
    p.add_argument("--gain-hist", action="store_true", help=argparse.SUPPRESS)
    p.add_argument("--antenna-plot", action="store_true", help=argparse.SUPPRESS)
    p.add_argument("--adjust-mean", action="store_true", help="For -pmode stats, divide real samples by the all-antenna mean and subtract the all-antenna mean from imaginary samples for each stokes. Default: false.")
    p.add_argument("--hist-bins", type=int, default=64, help="Gain histogram bin count. Default: 64.")
    p.add_argument("--hist-range", default=None, help="Optional gain histogram value range as min,max in percent.")
    p.add_argument("--s2-thr", type=float, default=0.9, help="S2 threshold for self-correlation reference markers. Default: 0.9.")
    p.add_argument("--stats", action="store_true", help=argparse.SUPPRESS)
    p.add_argument("--ks", action="store_true", help=argparse.SUPPRESS)
    p.add_argument("--self-corr-colormap", action="store_true", help=argparse.SUPPRESS)
    p.add_argument("--self-corr-antenna", action="store_true", help=argparse.SUPPRESS)
    p.add_argument("--cross-corr-colormap", action="store_true", help=argparse.SUPPRESS)
    p.add_argument("--all", action="store_true", help=argparse.SUPPRESS)
    p.add_argument("--plot-dir", default=None, help="Output plot directory. Default: configured plots/<format> directory.")
    p.add_argument("--format", choices=["png", "pdf", "eps"], default="png", help="Plot format. Default: png.")
    p.add_argument("--recompute", action="store_true", help="Run gdp-stats even if the matching NPZ product already exists.")
    p.add_argument("--dry-run", action="store_true", help="Print gdp-stats commands for missing products without plotting.")
    p.add_argument("--use-flags", action="store_true", help="Pass --use-flags to gdp-stats when creating missing products. Default: false.")
    p.add_argument("--flagver", default=None, help="Flag sidecar version to use with --use-flags. If omitted, the highest NAME_V<version>.flg file is used.")
    p.add_argument("pmode_values", nargs="*", help=argparse.SUPPRESS)
    return p.parse_args()


def main() -> None:
    global ACTIVE_FLAGVER, APPLY_FLAG_FILES
    args = parse_args()
    activate_config(args.setup_file)
    args.flagver = parse_flag_version(args.flagver)
    ACTIVE_FLAGVER = args.flagver
    APPLY_FLAG_FILES = bool(args.use_flags)
    scans = parse_int_list(args.scan)
    hist_range = parse_float_range(args.hist_range)
    pchans = parse_channel_pair(args.pchans, "-pchans")
    scan_label = scan_text(scans)
    plot_dir = Path(args.plot_dir).expanduser().resolve() if args.plot_dir else default_plot_dir(args.format)
    tasks = selected_tasks(args)
    antenna_text = antenna_from_pmode_values(args, tasks)
    args.antenna = antenna_text
    ants = parse_antenna_list(antenna_text, "--antenna")

    for mode in modes_from_arg(args.mode):
        validate_channel_options_for_mode(mode, args, pchans)
        for task in tasks:
            products = ensure_npzs(task, mode, args, scans)
            if args.dry_run:
                continue
            for label, npz in products:
                t0 = time.perf_counter()
                plot_label = label_with_plot_channels(label, pchans if task in {"gain_colormap", "gain_hist", "reim", "antenna", "stats"} else None)
                out = stats_output_path(plot_dir, mode, plot_label, args.format, args.adjust_mean) if task == "stats" else output_path(plot_dir, task, mode, plot_label, args.format)
                print(f"START plot {task} mode={mode} scan={label}")
                if task == "gain_colormap":
                    plot_gain_colormap(npz, out, ants, mode, pchans, args.plot_range)
                elif task == "gain_hist":
                    plot_gain_histogram(npz, out, ants, mode, args.hist_bins, hist_range, pchans)
                elif task == "reim":
                    plot_reim_products(npz, out, ants, mode, pchans, antenna_text)
                elif task == "antenna":
                    plot_single_antenna_gain_products(npz, out, ants, mode, pchans)
                elif task == "stats":
                    plot_antenna_gain_stats_grid(npz, out, ants, args.adjust_mean, pchans)
                elif task == "ks":
                    plot_antenna_gain_ks_grid(npz, out, ants)
                elif task == "self_corr_colormap":
                    plot_self_corr_colormap(npz, out, ants, args.s2_thr)
                elif task == "self_corr_antenna":
                    plot_self_corr_antenna_products(npz, out, ants, args.s2_thr)
                elif task == "cross_corr_colormap":
                    plot_cross_corr_colormap(npz, out, ants)
                print(f"DONE  plot {task} elapsed_sec={time.perf_counter() - t0:.3f}")


if __name__ == "__main__":
    main()
