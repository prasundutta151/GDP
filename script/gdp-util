#!/usr/bin/env python3
"""Utilities for reading metadata from CASA gain/bandpass/MS tables."""

from __future__ import annotations

import argparse
import json
import os
import subprocess
import tarfile
from datetime import datetime, timedelta, timezone
from pathlib import Path
from typing import Any, Dict, Iterable, List, Optional

import numpy as np


CONFIG_NAME = ".gdp-config.json"
IST = timezone(timedelta(hours=5, minutes=30))
MJD0_UTC = datetime(1858, 11, 17, 0, 0, 0, tzinfo=timezone.utc)


def project_root() -> Path:
    return Path(__file__).resolve().parents[1]


def load_config() -> Dict[str, Any]:
    path = project_root() / CONFIG_NAME
    if not path.exists():
        return {}
    with path.open("r", encoding="utf-8") as f:
        return json.load(f)


def runtime_dir() -> Path:
    cfg = load_config()
    return Path(str(cfg.get("rundir") or (project_root() / "rundir"))).expanduser().resolve()


def format_path_text(text: object, relative_paths: bool = False, rundir: Optional[Path] = None) -> str:
    value = str(text)
    if not relative_paths:
        return value
    root = rundir or runtime_dir()
    return value.replace(str(root.resolve()) + "/", "")


def display_value(value: Any, relative_paths: bool = False, rundir: Optional[Path] = None) -> Any:
    if isinstance(value, str):
        return format_path_text(value, relative_paths, rundir)
    if isinstance(value, dict):
        return {key: display_value(val, relative_paths, rundir) for key, val in value.items()}
    if isinstance(value, list):
        return [display_value(item, relative_paths, rundir) for item in value]
    return value


def version_text() -> str:
    version_path = project_root() / "VERSION"
    if not version_path.exists():
        return "0.0.0"
    return version_path.read_text(encoding="utf-8").strip()


def parse_version_number(text: str) -> List[int]:
    parts = str(text).strip().split(".")
    if not parts or any(part == "" for part in parts):
        raise ValueError(f"Invalid version number: {text}")
    numbers: List[int] = []
    for part in parts:
        if not part.isdigit():
            raise ValueError(f"Invalid version number: {text}")
        numbers.append(int(part))
    while len(numbers) < 3:
        numbers.append(0)
    if len(numbers) > 3:
        raise ValueError("Version numbers must use MAJOR.MINOR.PATCH format.")
    return numbers


def format_version_number(numbers: List[int]) -> str:
    return ".".join(str(int(value)) for value in numbers[:3])


def set_version(version_arg: str) -> str:
    current = parse_version_number(version_text())
    value = str(version_arg).strip()
    if value == "patch":
        current[2] += 1
        new_version = format_version_number(current)
    elif value.lower() == "main":
        current[0] += 1
        current[1] = 0
        current[2] = 0
        new_version = format_version_number(current)
    else:
        new_version = format_version_number(parse_version_number(value))
    version_path = project_root() / "VERSION"
    version_path.write_text(new_version + "\n", encoding="utf-8")
    return new_version


def run_git(args: List[str], check: bool = True) -> subprocess.CompletedProcess:
    return subprocess.run(
        ["git", *args],
        cwd=str(project_root()),
        text=True,
        check=check,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )


def should_archive(path: Path) -> bool:
    root = project_root()
    rel = path.relative_to(root)
    parts = rel.parts
    if not parts:
        return True
    if parts[0] == ".git":
        return False
    if path.name == ".DS_Store":
        return False
    if "__pycache__" in parts:
        return False
    if path.name == ".gdp-config.json":
        return False
    if parts[0] == "rundir" and path.name != ".gitkeep":
        return False
    if path.suffix in {".tgz", ".tar"}:
        return False
    return True


def make_version_archive() -> Path:
    root = project_root()
    version = version_text()
    archive = root / f"gdp-{version}.tgz"
    if archive.exists():
        archive.unlink()
    with tarfile.open(archive, "w:gz") as tf:
        for path in sorted(root.rglob("*")):
            if not should_archive(path):
                continue
            arcname = Path(f"GDP-{version}") / path.relative_to(root)
            tf.add(path, arcname=str(arcname), recursive=False)
    return archive


def git_push_release(message: str, no_push: bool = False) -> None:
    root = project_root()
    try:
        inside = run_git(["rev-parse", "--is-inside-work-tree"]).stdout.strip()
    except subprocess.CalledProcessError as exc:
        raise RuntimeError(f"Not inside a git repository: {root}") from exc
    if inside != "true":
        raise RuntimeError(f"Not inside a git repository: {root}")

    branch = run_git(["branch", "--show-current"]).stdout.strip()
    if not branch:
        raise RuntimeError("Cannot push from detached HEAD.")

    archive = make_version_archive()

    normal_paths = [
        ".gitignore",
        "DEV_NOTES.md",
        "DEV_PLAN.md",
        "REQUIREMENTS.md",
        "VERSION",
        "doc",
        "script",
        "pipelines",
        "rundir",
        "arx",
        "push_to_git.sh",
    ]
    existing = [p for p in normal_paths if (root / p).exists()]
    run_git(["add", *existing])
    run_git(["add", "-f", str(archive.relative_to(root))])

    status = run_git(["status", "--short"]).stdout
    print("Staged/current status:")
    print(status.rstrip() or "  clean")

    cached = run_git(["diff", "--cached", "--quiet"], check=False)
    if cached.returncode == 0:
        print("No staged changes to commit.")
    else:
        run_git(["commit", "-m", message])
        print(f"Committed changes on {branch}.")

    if no_push:
        print("Skipping git push because --no-push was supplied.")
    else:
        run_git(["push", "origin", branch])
        print(f"Pushed {branch} to origin.")
    print(f"Version archive: {archive}")


def casatable_factory():
    try:
        from casatools import table as casatable
    except Exception as exc:
        raise RuntimeError(
            "Could not import casatools.table. Run inside CASA/casa6 or a "
            "CASA-enabled Python environment."
        ) from exc
    return casatable


def as_jsonable(value: Any) -> Any:
    if isinstance(value, np.ndarray):
        if value.size > 20:
            return {
                "shape": list(value.shape),
                "dtype": str(value.dtype),
                "sample": value.ravel()[:20].tolist(),
            }
        return value.tolist()
    if isinstance(value, (np.integer,)):
        return int(value)
    if isinstance(value, (np.floating,)):
        return float(value)
    if isinstance(value, (np.bool_,)):
        return bool(value)
    if isinstance(value, bytes):
        return value.decode("utf-8", errors="replace")
    if isinstance(value, (str, int, float, bool)) or value is None:
        return value
    if isinstance(value, dict):
        return {str(k): as_jsonable(v) for k, v in value.items()}
    if isinstance(value, (list, tuple)):
        return [as_jsonable(v) for v in value]
    return repr(value)


def unique_ints(values: np.ndarray) -> List[int]:
    arr = np.asarray(values).ravel()
    arr = arr[np.isfinite(arr)] if np.issubdtype(arr.dtype, np.number) else arr
    return [int(x) for x in np.unique(arr)]


def table_header(path: Path, include_keywords: bool = False) -> Dict[str, Any]:
    casatable = casatable_factory()
    tb = casatable()
    tb.open(str(path))
    try:
        colnames = list(tb.colnames())
        info: Dict[str, Any] = {
            "path": str(path),
            "nrows": int(tb.nrows()),
            "columns": colnames,
            "data_columns": [c for c in ("GAIN", "CPARAM", "FPARAM", "DATA", "CORRECTED_DATA", "MODEL_DATA") if c in colnames],
        }
        column_descriptions: Dict[str, Any] = {}
        for name in colnames:
            try:
                desc = tb.getcoldesc(name)
            except Exception:
                continue
            column_descriptions[name] = as_jsonable(desc)
        info["column_descriptions"] = column_descriptions

        if "SCAN_NUMBER" in colnames:
            info["scans"] = unique_ints(tb.getcol("SCAN_NUMBER"))
        if "ANTENNA1" in colnames:
            info["antennas"] = unique_ints(tb.getcol("ANTENNA1"))
        if "FIELD_ID" in colnames:
            info["field_ids"] = unique_ints(tb.getcol("FIELD_ID"))
        if "TIME" in colnames and tb.nrows() > 0:
            t = np.asarray(tb.getcol("TIME"), dtype=float).ravel()
            info["time_mjd_seconds_min"] = float(np.nanmin(t))
            info["time_mjd_seconds_max"] = float(np.nanmax(t))

        if include_keywords:
            try:
                info["keywords"] = as_jsonable(tb.getkeywords())
            except Exception as exc:
                info["keywords_error"] = str(exc)
        return info
    finally:
        tb.close()


def mjdsec_to_utc(mjd_seconds: float) -> datetime:
    return MJD0_UTC + timedelta(seconds=float(mjd_seconds))


def table_dates(path: Path) -> Dict[str, Any]:
    casatable = casatable_factory()
    tb = casatable()
    tb.open(str(path))
    try:
        if "TIME" not in tb.colnames():
            raise KeyError("TIME column not found.")
        times = np.asarray(tb.getcol("TIME"), dtype=float).ravel()
    finally:
        tb.close()

    if times.size == 0:
        raise ValueError("TIME column is empty.")

    tmin = mjdsec_to_utc(float(np.nanmin(times))).astimezone(IST)
    tmax = mjdsec_to_utc(float(np.nanmax(times))).astimezone(IST)
    dates = sorted({mjdsec_to_utc(float(t)).astimezone(IST).date().isoformat() for t in times})

    def fmt(dt: datetime) -> str:
        return dt.strftime("%Y-%m-%d %H:%M:%S.") + f"{int(dt.microsecond / 1000):03d}"

    return {
        "path": str(path),
        "ist_dates": dates,
        "ist_time_start": fmt(tmin),
        "ist_time_end": fmt(tmax),
    }


def format_time(dt: datetime) -> str:
    return dt.strftime("%Y-%m-%d %H:%M:%S.") + f"{int(dt.microsecond / 1000):03d}"


def table_time_info(path: Path) -> Dict[str, Any]:
    casatable = casatable_factory()
    tb = casatable()
    tb.open(str(path))
    try:
        cols = list(tb.colnames())
        if "TIME" not in cols:
            raise RuntimeError(f"No TIME column in {path}")
        times = np.asarray(tb.getcol("TIME"), dtype=float).ravel()
        if "SCAN_NUMBER" in cols:
            scans = np.asarray(tb.getcol("SCAN_NUMBER"), dtype=int).ravel()
            valid_scan = scans[np.isfinite(times)]
            if valid_scan.size:
                scan = int(np.min(valid_scan))
                times = times[scans == scan]
    finally:
        tb.close()

    unique_times = np.unique(times[np.isfinite(times)])
    if unique_times.size == 0:
        raise RuntimeError(f"No finite TIME values found in {path}")
    sorted_times = np.sort(unique_times)
    valid_dt = positive_finite(np.diff(sorted_times)) if sorted_times.size > 1 else np.asarray([], dtype=float)
    delta_t = float(np.median(valid_dt)) if valid_dt.size else 0.0
    start_utc = mjdsec_to_utc(float(sorted_times[0]))
    end_utc = mjdsec_to_utc(float(sorted_times[-1]))
    return {
        "NTime": int(sorted_times.size),
        "delta-T_sec": delta_t,
        "time-start_IST": format_time(start_utc.astimezone(IST)),
        "time-end_IST": format_time(end_utc.astimezone(IST)),
        "time-start_GMT": format_time(start_utc),
        "time-end_GMT": format_time(end_utc),
    }


def open_table_for_spw(path: Path) -> Path:
    spw = path / "SPECTRAL_WINDOW"
    return spw if spw.is_dir() else path


def positive_finite(values: np.ndarray) -> np.ndarray:
    arr = np.asarray(values, dtype=float).ravel()
    return arr[np.isfinite(arr) & (arr > 0)]


def value_stats(values: np.ndarray, prefix: str, unit: str, scale: float = 1.0) -> Dict[str, Any]:
    valid = positive_finite(values) / scale
    if valid.size == 0:
        raise RuntimeError(f"No valid positive {prefix.replace('_', ' ')} values found.")
    return {
        f"n_{prefix}": int(valid.size),
        f"{prefix}_{unit}_mean": float(np.mean(valid)),
        f"{prefix}_{unit}_min": float(np.min(valid)),
        f"{prefix}_{unit}_max": float(np.max(valid)),
    }


def mean_positive_finite(values: np.ndarray, scale: float = 1.0) -> float:
    valid = positive_finite(values) / scale
    if valid.size == 0:
        raise RuntimeError("No valid positive values found.")
    return float(np.mean(valid))


def scaled_frequency_value(prefix: str, value_hz: float) -> Dict[str, float]:
    abs_value = abs(float(value_hz))
    if abs_value >= 1e6:
        return {f"{prefix}_MHz": float(value_hz) / 1e6}
    return {f"{prefix}_kHz": float(value_hz) / 1e3}


def scaled_frequency_key_value(prefix: str, value_hz: float) -> tuple[str, float]:
    item = scaled_frequency_value(prefix, value_hz)
    return next(iter(item.items()))


def table_unique_column(path: Path, column: str, label: str) -> Dict[str, Any]:
    casatable = casatable_factory()
    tb = casatable()
    tb.open(str(path))
    try:
        cols = list(tb.colnames())
        if column not in cols:
            raise RuntimeError(f"No {column} column in {path}")
        values = unique_ints(tb.getcol(column))
    finally:
        tb.close()
    return {label: values}


def table_scans(path: Path) -> Dict[str, Any]:
    return table_unique_column(path, "SCAN_NUMBER", "scans")


def table_antennas(path: Path) -> Dict[str, Any]:
    return table_unique_column(path, "ANTENNA1", "antenna")


def channel_width_values_hz(table_path: Path) -> np.ndarray:
    casatable = casatable_factory()
    tb = casatable()
    tb.open(str(table_path))
    try:
        cols = tb.colnames()
        if "CHANNEL_WIDTH" in cols:
            return np.abs(np.asarray(tb.getcol("CHANNEL_WIDTH"), dtype=float))
        if "CHAN_WIDTH" in cols:
            return np.abs(np.asarray(tb.getcol("CHAN_WIDTH"), dtype=float))
        if "CHAN_FREQ" in cols:
            freq = np.asarray(tb.getcol("CHAN_FREQ"), dtype=float)
            if freq.ndim == 1:
                return np.abs(np.diff(freq))
            return np.abs(np.diff(freq, axis=0))
        raise RuntimeError(f"No CHANNEL_WIDTH/CHAN_WIDTH/CHAN_FREQ column in {table_path}")
    finally:
        tb.close()


def channel_width(path: Path) -> Dict[str, Any]:
    table_path = open_table_for_spw(path)
    return scaled_frequency_value("chan-width", mean_positive_finite(channel_width_values_hz(table_path)))


def band_width(path: Path) -> Dict[str, Any]:
    table_path = open_table_for_spw(path)
    casatable = casatable_factory()
    tb = casatable()
    tb.open(str(table_path))
    try:
        cols = tb.colnames()
        if "TOTAL_BANDWIDTH" in cols:
            widths = np.asarray(tb.getcol("TOTAL_BANDWIDTH"), dtype=float)
        elif "BANDWIDTH" in cols:
            widths = np.asarray(tb.getcol("BANDWIDTH"), dtype=float)
        elif "CHANNEL_WIDTH" in cols:
            chan_widths = np.abs(np.asarray(tb.getcol("CHANNEL_WIDTH"), dtype=float))
            widths = np.sum(chan_widths, axis=0) if chan_widths.ndim > 1 else np.asarray([np.sum(chan_widths)])
        elif "CHAN_WIDTH" in cols:
            chan_widths = np.abs(np.asarray(tb.getcol("CHAN_WIDTH"), dtype=float))
            widths = np.sum(chan_widths, axis=0) if chan_widths.ndim > 1 else np.asarray([np.sum(chan_widths)])
        elif "CHAN_FREQ" in cols:
            freq = np.asarray(tb.getcol("CHAN_FREQ"), dtype=float)
            if freq.ndim == 1:
                widths = np.asarray([np.nanmax(freq) - np.nanmin(freq)])
            else:
                widths = np.nanmax(freq, axis=0) - np.nanmin(freq, axis=0)
        else:
            raise RuntimeError(f"No TOTAL_BANDWIDTH/BANDWIDTH/CHANNEL_WIDTH/CHAN_WIDTH/CHAN_FREQ column in {table_path}")
    finally:
        tb.close()

    return scaled_frequency_value("band-width", mean_positive_finite(np.abs(widths)))


def channel_info(path: Path) -> Dict[str, Any]:
    table_path = open_table_for_spw(path)
    casatable = casatable_factory()
    tb = casatable()
    tb.open(str(table_path))
    try:
        cols = list(tb.colnames())
        if "CHAN_FREQ" not in cols:
            raise RuntimeError(f"No CHAN_FREQ column in {table_path}")
        freqs = np.asarray(tb.getcol("CHAN_FREQ"), dtype=float)
        widths: Optional[np.ndarray] = None
        total_widths: Optional[np.ndarray] = None
        if "CHANNEL_WIDTH" in cols:
            widths = np.abs(np.asarray(tb.getcol("CHANNEL_WIDTH"), dtype=float))
        elif "CHAN_WIDTH" in cols:
            widths = np.abs(np.asarray(tb.getcol("CHAN_WIDTH"), dtype=float))
        if "TOTAL_BANDWIDTH" in cols:
            total_widths = np.abs(np.asarray(tb.getcol("TOTAL_BANDWIDTH"), dtype=float))
        elif "BANDWIDTH" in cols:
            total_widths = np.abs(np.asarray(tb.getcol("BANDWIDTH"), dtype=float))
    finally:
        tb.close()

    freq_values = freqs[np.isfinite(freqs)]
    if freq_values.size == 0:
        raise RuntimeError(f"No finite CHAN_FREQ values found in {table_path}")

    if widths is not None:
        chan_width_hz = mean_positive_finite(widths)
        nchan = int(widths.shape[0]) if widths.ndim > 1 else int(widths.size)
        if total_widths is not None:
            band_width_hz = mean_positive_finite(total_widths)
        else:
            band_width_hz = float(chan_width_hz * nchan)
    else:
        chan_width_hz = mean_positive_finite(np.diff(np.sort(np.unique(freq_values))))
        nchan = int(freqs.shape[0]) if freqs.ndim > 1 else int(freq_values.size)
        band_width_hz = float(np.nanmax(freq_values) - np.nanmin(freq_values))

    info: Dict[str, Any] = {"nchan": nchan}
    for key, value in [
        scaled_frequency_key_value("chan-width", chan_width_hz),
        scaled_frequency_key_value("band-width", band_width_hz),
        scaled_frequency_key_value("freq-start", float(np.nanmin(freq_values))),
        scaled_frequency_key_value("freq-end", float(np.nanmax(freq_values))),
    ]:
        info[key] = value
    return info


def integration_time(path: Path) -> Dict[str, Any]:
    casatable = casatable_factory()
    tb = casatable()
    tb.open(str(path))
    try:
        cols = list(tb.colnames())
        if "TIME" not in cols:
            raise RuntimeError(f"No TIME column in {path}")
        times = np.asarray(tb.getcol("TIME"), dtype=float).ravel()
        if "SCAN_NUMBER" in cols:
            scans = np.asarray(tb.getcol("SCAN_NUMBER"), dtype=int).ravel()
            valid_scan = scans[np.isfinite(times)]
            if valid_scan.size:
                scan = int(np.min(valid_scan))
                times = times[scans == scan]
    finally:
        tb.close()

    unique_times = np.unique(times[np.isfinite(times)])
    if unique_times.size < 2:
        raise RuntimeError(f"Need at least two unique TIME values to calculate integration time in {path}")
    dt = np.diff(np.sort(unique_times))
    valid_dt = positive_finite(dt)
    if valid_dt.size == 0:
        raise RuntimeError(f"No valid positive TIME differences found in {path}")
    return {"integration-time_sec": float(np.median(valid_dt))}


def resolve_mode_input(value: Optional[str], mode: str) -> Path:
    if value:
        return Path(value).expanduser().resolve()
    cfg = load_config()
    key = "bandpass_table" if mode == "bandpass" else "gain_table"
    source = cfg.get(key)
    if not source:
        raise SystemExit(f"No saved {key} is available. Run gdp-setup first or pass --input-table PATH.")
    return Path(str(source)).expanduser().resolve()


def resolve_bandpass_input(value: Optional[str]) -> Path:
    return resolve_mode_input(value, "bandpass")


def resolve_gain_input(value: Optional[str]) -> Path:
    return resolve_mode_input(value, "gain")


def print_human(title: str, data: Dict[str, Any], relative_paths: bool = False, rundir: Optional[Path] = None) -> None:
    data = display_value(data, relative_paths, rundir)
    if all(str(key).startswith(("chan-width_", "band-width_", "integration-time_sec")) for key in data):
        for key, value in data.items():
            print(f"{key}: {value}")
        return
    if set(data) <= {"scans", "antenna"}:
        for key, value in data.items():
            if isinstance(value, list):
                print(f"{key}: " + " ".join(str(item) for item in value))
            else:
                print(f"{key}: {value}")
        return
    print(title)
    print("=" * len(title))
    for key, value in data.items():
        if isinstance(value, (dict, list)):
            print(f"{key}: {json.dumps(value, indent=2, sort_keys=True)}")
        else:
            print(f"{key}: {value}")


def parse_args() -> argparse.Namespace:
    p = argparse.ArgumentParser(
        description="Read useful metadata from CASA gain, bandpass, or MeasurementSet tables."
    )
    p.add_argument("--input-table", dest="input_table_opt", default=None, help="Input CASA table/MS path.")
    p.add_argument("--mode", choices=["gain", "bandpass"], default="gain", help="Saved setup table to use when --input-table is omitted. Default: gain.")
    p.add_argument(
        "--version",
        nargs="?",
        const="patch",
        default=None,
        metavar="NUMBER|main",
        help="Update VERSION. Bare --version bumps patch; --version main bumps major; --version NUMBER sets an exact version.",
    )
    p.add_argument("--header", action="store_true", help="Print table header, columns, row count, and common IDs.")
    p.add_argument("--keywords", action="store_true", help="Include table keywords in --header output.")
    p.add_argument("--date", action="store_true", help="Print IST observing date/time span from TIME column.")
    p.add_argument("--scans", action="store_true", help="Print scan numbers present in the selected table.")
    p.add_argument("--antenna", action="store_true", help="Print antenna numbers present in the selected table.")
    p.add_argument("--chaninfo", action="store_true", help="Print bandpass channel information: bandwidth, channel width, number of channels, and start/end frequency.")
    p.add_argument("--timeinfo", action="store_true", help="Print gain time information: NTime, median delta-T, and start/end times in IST and GMT.")
    p.add_argument("--channel-width", "--channelwidth", dest="channel_width", action="store_true", help="Print mean bandpass-table channel width in kHz or MHz.")
    p.add_argument("--band-width", "--bandwidth", dest="band_width", action="store_true", help="Print mean bandpass-table total bandwidth in kHz or MHz.")
    p.add_argument("--integration-time", action="store_true", help="Print median gain-table integration time from TIME differences in one scan.")
    p.add_argument("--config", action="store_true", help="Print saved GDP setup configuration.")
    p.add_argument(
        "--git-push",
        action="store_true",
        help="Create the version tgz, stage GDP files, commit, and push the current git branch.",
    )
    p.add_argument(
        "-m",
        "--message",
        default=None,
        help="Commit message for --git-push. Default: GDP update <version>.",
    )
    p.add_argument("--no-push", action="store_true", help="With --git-push, commit but do not push.")
    p.add_argument("--relative-path", action="store_true", help="Print runtime-relative file references after reporting the runtime directory; file writes are unchanged.")
    p.add_argument("--json", action="store_true", help="Write machine-readable JSON output.")
    return p.parse_args()


def main() -> None:
    args = parse_args()
    if args.version is not None:
        new_version = set_version(args.version)
        print(f"VERSION updated to {new_version}")

    if args.git_push:
        message = args.message or f"GDP update {version_text()}"
        git_push_release(message=message, no_push=args.no_push)
        return

    bandpass_actions = [args.chaninfo, args.channel_width, args.band_width]
    gain_actions = [args.timeinfo, args.integration_time]
    if args.mode != "bandpass" and any(bandpass_actions):
        raise SystemExit("ERROR: --chaninfo, --channelwidth/--channel-width, and --bandwidth/--band-width require --mode bandpass.")
    if args.mode != "gain" and any(gain_actions):
        raise SystemExit("ERROR: --timeinfo and --integration-time require --mode gain.")

    actions = [
        args.header,
        args.date,
        args.scans,
        args.antenna,
        args.chaninfo,
        args.timeinfo,
        args.channel_width,
        args.band_width,
        args.integration_time,
        args.config,
    ]
    if not any(actions):
        args.header = True

    results: Dict[str, Any] = {}
    if args.config:
        results["config"] = load_config()

    if args.header or args.date or args.scans or args.antenna:
        table = resolve_mode_input(args.input_table_opt, args.mode)
        if not table.exists():
            raise FileNotFoundError(f"Input table not found: {table}")
        if args.header:
            results["header"] = table_header(table, include_keywords=args.keywords)
        if args.date:
            results["date"] = table_dates(table)
        if args.scans:
            results["scans"] = table_scans(table)
        if args.antenna:
            results["antenna"] = table_antennas(table)

    if args.integration_time or args.timeinfo:
        table = resolve_mode_input(args.input_table_opt, args.mode)
        if not table.exists():
            raise FileNotFoundError(f"Gain table not found: {table}")
        if args.timeinfo:
            results["timeinfo"] = table_time_info(table)
        if args.integration_time:
            results["integration_time"] = integration_time(table)

    if args.channel_width or args.band_width or args.chaninfo:
        table = resolve_mode_input(args.input_table_opt, args.mode)
        if not table.exists():
            raise FileNotFoundError(f"Bandpass table not found: {table}")
        if args.chaninfo:
            results["chaninfo"] = channel_info(table)
        if args.channel_width:
            results["channel_width"] = channel_width(table)
        if args.band_width:
            results["band_width"] = band_width(table)

    if args.json:
        print(json.dumps(results, indent=2, sort_keys=True))
        return

    rundir = runtime_dir()
    if args.relative_path:
        print(f"Runtime directory: {rundir}")
        if results:
            print()
    for name, data in results.items():
        print_human(name, data, args.relative_path, rundir)
        print()


if __name__ == "__main__":
    main()
